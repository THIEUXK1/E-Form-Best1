# Mau cau hinh - COPY file nay thanh .env roi dien gia tri that.
# File .env da bi .gitignore loai tru; tuyet doi khong dien mat khau vao file .example nay.
#
# Dat file .env o dau:
#   - Chay dev (dotnet watch run): trong thu muc E-Form-Best/ (canh file .csproj)
#   - Chay that tren IIS: trong thu muc publish (canh E-Form-Best.dll)
# Neu may chu da dat san bien moi truong cung ten thi bien do duoc uu tien, .env bi bo qua.

ConnectionStrings__DefaultConnection=Data Source=<ip-sql>;Initial Catalog=ITForm;Persist Security Info=True;User ID=<user>;Password=<mat-khau>;Encrypt=True;Trust Server Certificate=True

# SQL chi nhanh - chi doc, dong bo mot chieu ve he thong nay
ConnectionStrings__ChiNhanhConnection=Data Source=<ip-sql-chi-nhanh>;Initial Catalog=ITForm;Persist Security Info=True;User ID=<user>;Password=<mat-khau>;Encrypt=True;Trust Server Certificate=True

# He thong giam sat camera ISAPI (trang /QLCamera doc du lieu tu day, chi doc)
CameraIsapi__BaseUrl=http://10.0.60.238:3005
CameraIsapi__TaiKhoan=
CameraIsapi__MatKhau=

# Xem truc tiep camera BPVN: tai khoan dau ghi Hikvision + go2rtc chay cung may (chi nghe 127.0.0.1)
CameraNvr__TaiKhoan=
CameraNvr__MatKhau=
CameraNvr__RtspPort=554
CameraNvr__Go2rtcUrl=http://127.0.0.1:1984
# go2rtc dat o may khac (10.0.60.238) thi co tai khoan API; cung may 127.0.0.1 thi de trong
CameraNvr__Go2rtcTaiKhoan=
CameraNvr__Go2rtcMatKhau=
# true = lay anh truc tiep qua go2rtc thay vi goi thang ISAPI dau ghi (may chu khong thong mang dau ghi)
CameraNvr__AnhQuaGo2rtc=false

# Anh luu san camera (job CameraAnhLuuWorker): chi bat o may goi duoc dau ghi; nhieu moc gio cach nhau dau phay
CameraNvr__ThuMucAnhLuu=
CameraNvr__ChupAnhLuu=false
CameraNvr__GioChupAnhLuu=08:30
# ffmpeg lay khung hinh ghi cuoi (camera mat ket noi) tu playback dau ghi; de trong = C:\go2rtc\ffmpeg.exe
CameraNvr__FfmpegPath=
# go2rtc tren may thong mang dau ghi PFVN (ZPVN-WEBSRV) de xem truc tiep; de trong = chi co anh luu san
CameraPFVN__Go2rtcUrl=
CameraPFVN__Go2rtcTaiKhoan=
CameraPFVN__Go2rtcMatKhau=
# Dau ghi MEGA may chu goi thang duoc (IP public, ISAPI): goc|tai khoan|mat khau; nhieu dau ghi thi __2, __3...
# Co thi may chu tu doc trang thai + chup anh luu + anh truc tiep (khong co video vi RTSP khong mo ra ngoai)
CameraMega__DauGhi__1=
# Dau ghi BPVN NGOAI he thong ISAPI (chi nhanh qua IP public), cung dang goc|tai khoan|mat khau;
# gop vao tab Giam sat / Luoi anh / Lich su cua /QLCamera, du lieu o thu muc con BPVN cua ThuMucAnhLuu
CameraBPVN__DauGhi__1=
# Quan ly AP Wi-Fi (/QLAP): may khong thong mang cong ty nao thi bo cong ty do (mac dinh BPVN,PFVN,MEGA);
# may dev chay song song may chu thi nen tat job ping: AccessPoint__GhiLichSu=false
AccessPoint__CongTyPing=
AccessPoint__GhiLichSu=
# AP controller tung cong ty (chi DOC danh sach AP + trang thai). Loai: HuaweiAC (web V200R0xx). Url vd https://10.0.198.199
AccessPointController__PFVN__Loai=
AccessPointController__PFVN__Url=
AccessPointController__PFVN__TaiKhoan=
AccessPointController__PFVN__MatKhau=
# BPVN: Loai=WlcApi (collector REST cua WLC), Url vd http://10.0.60.90:8000, xac thuc bang header X-API-Key
AccessPointController__BPVN__Loai=
AccessPointController__BPVN__Url=
AccessPointController__BPVN__ApiKey=
# Them MAC Wi-Fi len WLC tu trang chi tiet don Wi-Fi (quyen ThemMacWifi): app automation Node POST /api/exec, header X-API-Key.
# SSH vao WLC bang tai khoan domain cua IT dang thao tac (mat khau nhap moi lan, khong luu).
# BaseUrl nhieu may du phong "url1;url2" (may dau khong ket noi duoc moi thu may sau); Profiles = "aaaList:wlanProfile;..." — cong ty chua co DeviceIp/Profiles thi an nut.
WlcExec__BaseUrl=
WlcExec__ApiKey=
WlcExec__BPVN__DeviceIp=
WlcExec__BPVN__DeviceType=cisco_xe
WlcExec__BPVN__Profiles=MAC-Staff:BPVN_STAFF
# WLC thu 2+ cua cung cong ty: them lan luot sau con 9800 o tren. Loai=AireOS -> deviceType mac dinh cisco_aireos.
# Wlan = "<ten WLAN profile o tren>=<WLAN ID>:<interface>;..." tren con AireOS, vd BPVN-WLC5508 10.0.62.254:
#   WlcExec__BPVN__Wlc__1__Wlan=BPVN_STAFF=5:dyn interface wifi staff  (interface co dau cach -> lenh tu dat trong "")
WlcExec__BPVN__Wlc__1__Ip=
WlcExec__BPVN__Wlc__1__Ten=
WlcExec__BPVN__Wlc__1__Loai=AireOS
WlcExec__BPVN__Wlc__1__Wlan=
# Them MAC PDA / TV vao DaloRADIUS (form rieng trong modal them MAC o don Wi-Fi): POST {BaseUrl}/api/radius/mac, header X-API-Key.
# Nhom = "loai thiet bi:group RADIUS;..." — cong ty chua co Nhom thi an form RADIUS.
RadiusMac__BaseUrl=
RadiusMac__ApiKey=
RadiusMac__BPVN__Nhom=PDA:VLAN16_QR;TV:VLAN16_QR
# Quan ly Switch (/QLSwitch): giong AP — may khong thong mang cong ty nao thi bo cong ty do; may dev nen Switch__GhiLichSu=false
Switch__CongTyPing=
Switch__GhiLichSu=
# Quet dai IP may chu (tab "May chu" trang Switch): "CONGTY=3 octet;..." mac dinh PFVN=10.0.193;BPVN=10.0.63; chu ky giay (mac dinh 300).
# Cong ty bo khoi Switch__CongTyPing thi cung khong quet; QuetIp__Bat mac dinh theo Switch__GhiLichSu
QuetIp__DaiMang=
QuetIp__ChuKyGiay=
# Server va luu tru (/QLServer): giong Switch; bo trong Server__CongTyPing = theo Switch__CongTyPing
Server__CongTyPing=
Server__GhiLichSu=
# Dai IP may nay khong toi duoc, bo qua ca ping lan SNMP (VD may dev: 10.0.63.) — phan cach dau phay
Server__BoQuaDaiIp=
# Suc khoe phan cung qua SNMP v2c (o cung, RAM, quat, nguon, dung luong). Community theo nhom: LuuTru = NAS/SAN, MayChu = Server/May ao.
# Ghi de rieng cong ty: ServerSnmp__BPVN__Community__MayChu=... ; chu ky giay mac dinh 600; Bat mac dinh theo Server__GhiLichSu
ServerSnmp__Community__LuuTru=
ServerSnmp__Community__MayChu=
ServerSnmp__ChuKyGiay=
ServerSnmp__Bat=
# Tai khoan chi-doc (role monitor) API HTTPS cua tu dia HPE MSA: SNMP cua MSA khong co o cung / pool, API thi co.
# Ghi de rieng cong ty: MsaApi__BPVN__User=... ; de trong thi chi doc SNMP nhu cu
MsaApi__User=
MsaApi__Pass=
# Community SNMP v2c mac dinh cho nut "Kiem tra ket noi" / "Dien tu SNMP" o /QLSwitch (o nhap tren form de trong thi dung cai nay).
# Ghi de rieng cong ty: SwitchSnmp__BPVN__Community=...
SwitchSnmp__Community=
# Suc khoe switch loi / WLC (tab "Thong tin thiet bi" /QLSwitch, danh sach theo doi = bang KK_SwitchSucKhoe):
# community dung SwitchSnmp__Community (trong thi ServerSnmp__Community__LuuTru); cong ty theo Switch__CongTyPing
SwitchSucKhoe__Bat=
SwitchSucKhoe__ChuKyGiay=
QuetIp__Bat=
# Bao cao dinh ki: chup so lieu ban quyen/Office/trang thai thiet bi moi ngay (KK_ThietBiChotNgay).
# Mac dinh bat, chup tu 22h; may dev tro DB that nen tat (ThietBiChotNgay__Bat=false) - unique van chan chup doi
ThietBiChotNgay__Bat=
ThietBiChotNgay__GioChup=

# Community SNMP chi doc cua may in, de lay % muc cho may doi cu (CentreWare/PJL). De trong = public
MayIn__SnmpCommunity=

# Ghi chu noi bo tren khung Quan tri Mail (chi tiet don Mail), chi AdminIT thay. De trong = an. Xuong dong dung ky tu \n

MailQuanTri__GhiChu=

# QA - tra 配色单号 tren NH-MES (POST {BaseUrl}/ePackBatch/report2List). MES khong co token API:
# server dang nhap SSO OA (oa.bestpacific.cn) bang tai khoan ky thuat chi-doc MES, giu cookie phien, het han tu dang nhap lai.
MesApi__User=
MesApi__Pass=
MesApi__BaseUrl=https://nhmes.bestpacific.cn/nhmes
MesApi__SsoUrl=https://oa.bestpacific.cn
MesApi__FactoryCode=BPVN
