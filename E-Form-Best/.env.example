# Mau cau hinh - COPY file nay thanh .env roi dien gia tri that.
# File .env da bi .gitignore loai tru; tuyet doi khong dien mat khau vao file .example nay.
#
# Dat file .env o dau:
#   - Chay dev (dotnet watch run): trong thu muc E-Form-Best/ (canh file .csproj)
#   - Chay that tren IIS: trong thu muc publish (canh E-Form-Best.dll)
# Neu may chu da dat san bien moi truong cung ten thi bien do duoc uu tien, .env bi bo qua.

ConnectionStrings__DefaultConnection=Data Source=<ip-sql>;Initial Catalog=ITForm;Persist Security Info=True;User ID=<user>;Password=<mat-khau>;Encrypt=True;Trust Server Certificate=True

# SQL chi nhanh - chi doc, dong bo mot chieu ve he thong nay
ConnectionStrings__ChiNhanhConnection=Data Source=<ip-sql-chi-nhanh>;Initial Catalog=ITForm;Persist Security Info=True;User ID=<user>;Password=<mat-khau>;Encrypt=True;Trust Server Certificate=True

# He thong giam sat camera ISAPI (trang /QLCamera doc du lieu tu day, chi doc)
CameraIsapi__BaseUrl=http://10.0.60.238:3005
CameraIsapi__TaiKhoan=
CameraIsapi__MatKhau=

# Xem truc tiep camera BPVN: tai khoan dau ghi Hikvision + go2rtc chay cung may (chi nghe 127.0.0.1)
CameraNvr__TaiKhoan=
CameraNvr__MatKhau=
CameraNvr__RtspPort=554
CameraNvr__Go2rtcUrl=http://127.0.0.1:1984

# Anh luu san camera (job CameraAnhLuuWorker): chi bat o may goi duoc dau ghi; nhieu moc gio cach nhau dau phay
CameraNvr__ThuMucAnhLuu=
CameraNvr__ChupAnhLuu=false
CameraNvr__GioChupAnhLuu=08:30
# ffmpeg lay khung hinh ghi cuoi (camera mat ket noi) tu playback dau ghi; de trong = C:\go2rtc\ffmpeg.exe
CameraNvr__FfmpegPath=
# go2rtc tren may thong mang dau ghi PFVN (ZPVN-WEBSRV) de xem truc tiep; de trong = chi co anh luu san
CameraPFVN__Go2rtcUrl=
CameraPFVN__Go2rtcTaiKhoan=
CameraPFVN__Go2rtcMatKhau=
