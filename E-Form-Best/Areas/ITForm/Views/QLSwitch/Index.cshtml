@{
    Layout = "~/Areas/ITForm/Views/Shared/_Layout.cshtml";
    var congTy = ViewBag.CongTy as string ?? "BPVN";
    ViewData["Title"] = "Quản lý Switch " + congTy;

    @* Kiểu tường minh thay cho dynamic: view chạy ở assembly khác khi bật runtime compilation *@
    var dsBoPhan = ViewBag.DsBoPhan as IEnumerable<E_Form_Best.Models.ITForm.KkBoPhan>
                   ?? Enumerable.Empty<E_Form_Best.Models.ITForm.KkBoPhan>();
    var dsTinhTrang = ViewBag.DsTinhTrang as IEnumerable<string> ?? Enumerable.Empty<string>();
    var dsVaiTro = ViewBag.DsVaiTro as IEnumerable<string> ?? Enumerable.Empty<string>();
    // Chỉ quyền "All" được thêm/sửa/xoá; Sw{CÔNG TY} chỉ xem (server vẫn chặn lại ở từng action)
    var coQuyenSua = ViewBag.CoQuyenSua as bool? ?? false;
    var coCongTy = ViewBag.CoCongTy as bool? ?? false;
    // Dải quét máy chủ (3 octet đầu) của công ty này; null = không có tab Máy chủ
    var daiQuet = ViewBag.DaiQuet as string;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
@* Dùng lại khung bảng của trang CCDC / camera (cùng nhóm menu, cùng kiểu bảng cột cố định) *@
<link rel="stylesheet" href="/css/ccdc-quanly.css?v=20260825e">
<link rel="stylesheet" href="/css/fixed-page-layout.css?v=202610270831">
<link rel="stylesheet" href="/css/camera-quanly.css?v=20261016a">
<link rel="stylesheet" href="/css/server-quanly.css?v=20261024a">
<link rel="stylesheet" href="/css/switch-suc-khoe.css?v=20261110b">

<div class="content-header pt-0 pb-0" style="margin-top: -25px;">
    <div class="container-fluid">
        <div class="dash-topbar">
            <h4 class="dash-title"><span class="dash-title-icon"><i class="fas fa-network-wired"></i></span>Switch @congTy</h4>

            <ul class="nav nav-pills nav-pills-ccdc mb-0" id="swTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tabDanhSachBtn" data-bs-toggle="pill" data-bs-target="#paneDanhSach" type="button" role="tab">
                        <i class="fas fa-list me-1"></i> Danh sách switch
                        <span class="badge rounded-pill bg-danger ms-1 d-none" id="badgeMatKetNoi">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tabLichSuBtn" data-bs-toggle="pill" data-bs-target="#paneLichSu" type="button" role="tab">
                        <i class="fas fa-clock-rotate-left me-1"></i> Lịch sử
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tabSucKhoeBtn" data-bs-toggle="pill" data-bs-target="#paneSucKhoe" type="button" role="tab"
                            title="Sức khoẻ phần cứng switch lõi / WLC đọc qua SNMP">
                        <i class="fas fa-heart-pulse me-1"></i> Thông tin thiết bị
                        <span class="badge rounded-pill bg-danger ms-1 d-none" id="badgeSkLoi">0</span>
                    </button>
                </li>
                @if (daiQuet != null)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tabMayChuBtn" data-bs-toggle="pill" data-bs-target="#paneMayChu" type="button" role="tab"
                                title="Quét ping dải @(daiQuet).1–254">
                            <i class="fas fa-server me-1"></i> Máy chủ @(daiQuet).x
                            <span class="badge rounded-pill bg-danger ms-1 d-none" id="badgeMcMatKetNoi">0</span>
                        </button>
                    </li>
                }
            </ul>

            @* Báo cáo định kỳ riêng công ty này: dùng chung trang Tổng quan, lọc 1 công ty *@
            <a class="btn btn-sm btn-primary ms-auto" href="/QLSwitch/TongQuan?congTy=@congTy" title="Báo cáo định kỳ switch @congTy: in / xuất Excel">
                <i class="fas fa-file-lines me-1"></i> Báo cáo
            </a>
        </div>
    </div>
</div>

<section class="content @(coQuyenSua ? "" : "cam-chi-xem")" id="swTrang" data-cong-ty="@congTy" data-chi-xem="@(coQuyenSua ? null : "1")">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm bg-white" style="border-radius: 15px;">
            <div class="card-body p-2 p-md-3">
                @if (!coCongTy)
                {
                    <div class="alert alert-warning py-2 small">Danh mục công ty chưa có "@congTy" — chưa thêm được switch cho công ty này.</div>
                }
                <div class="alert alert-warning py-2 small d-none" id="swCanhBaoPing"></div>
                <div class="alert alert-secondary py-2 small d-none" id="swSnmpLoi"></div>

                <div class="tab-content">

                    @* ================= TAB DANH SÁCH switch (KK_Switch) ================= *@
                    <div class="tab-pane fade show active" id="paneDanhSach" role="tabpanel">
                        @* Ô số liệu: bấm Online / Mất kết nối để lọc bảng theo kết nối *@
                        <div class="cam-tiles mb-2">
                            <div class="cam-tile cam-tile-loc" data-loc="" title="Bấm để xem tất cả switch"><div class="cam-tile-nhan">Tổng switch</div><div class="cam-tile-so" id="tongDong">–</div></div>
                            <div class="cam-tile cam-tile-up cam-tile-loc" data-loc="online" title="Bấm để chỉ xem switch đang online"><div class="cam-tile-nhan">Online</div><div class="cam-tile-so" id="tongOnline">–</div></div>
                            <div class="cam-tile cam-tile-down cam-tile-loc" data-loc="offline" title="Bấm để chỉ xem switch mất kết nối"><div class="cam-tile-nhan">Mất kết nối</div><div class="cam-tile-so" id="tongOffline">–</div></div>
                            <div class="cam-tile"><div class="cam-tile-nhan">Kiểm tra gần nhất</div><div class="cam-tile-so cam-tile-so-nho" id="swLanCuoi">–</div><div class="cam-tile-phu" id="kiemTraGanNhat"></div></div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-lg-7">
                                <div class="cam-khung">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="fw-bold small text-muted"><i class="fas fa-chart-line me-1"></i> Xu hướng online / mất kết nối</span>
                                        <select id="swKhoangXuHuong" class="form-select form-select-sm w-auto ms-auto">
                                            <option value="6">6 giờ gần nhất</option>
                                            <option value="24" selected>24 giờ</option>
                                            <option value="72">3 ngày</option>
                                            <option value="168">7 ngày</option>
                                        </select>
                                    </div>
                                    <div class="cam-bieu-do"><canvas id="swBieuDo"></canvas></div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="cam-khung">
                                    <div class="fw-bold small text-muted mb-1"><i class="fas fa-layer-group me-1"></i> Nhóm theo vai trò (bấm để lọc switch)</div>
                                    <div class="cam-bang-nvr">
                                        <table class="table table-sm table-hover align-middle mb-0 small">
                                            <thead>
                                                <tr><th>Vai trò</th><th class="text-end">Số switch</th><th class="text-end">Online</th><th class="text-end">Mất KN</th></tr>
                                            </thead>
                                            <tbody id="swNhomBody">
                                                <tr><td colspan="4" class="text-center text-muted py-3">Đang tải...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <input type="search" id="filterTuKhoa" autocomplete="off" class="form-control form-control-sm" style="max-width:260px;"
                                   placeholder="Tìm tên, mã, IP, MAC, model, vai trò, vị trí...">

                            <select id="filterBoPhan" class="form-select form-select-sm w-auto" title="Lọc theo bộ phận">
                                <option value="">-- Tất cả bộ phận --</option>
                                @foreach (var bp in dsBoPhan)
                                {
                                    <option value="@bp.IdboPhan">@bp.TenBoPhan</option>
                                }
                            </select>

                            <select id="filterTinhTrang" class="form-select form-select-sm w-auto" title="Lọc theo tình trạng">
                                <option value="">-- Tất cả tình trạng --</option>
                                @foreach (var tt in dsTinhTrang)
                                {
                                    <option value="@tt">@tt</option>
                                }
                            </select>

                            <select id="filterKetNoi" class="form-select form-select-sm w-auto" title="Lọc theo kết nối">
                                <option value="">-- Online + Offline --</option>
                                <option value="online">Đang online</option>
                                <option value="offline">Mất kết nối</option>
                            </select>

                            <span class="flex-grow-1"></span>

                            @if (congTy == "BPVN")
                            {
                                <button type="button" class="btn btn-sm btn-light border" id="btnTraMac" title="Thiết bị có MAC này đang cắm switch nào, cổng nào">
                                    <i class="fas fa-magnifying-glass-location me-1"></i> Tra MAC
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-light border" id="btnTaiLai" title="Tải lại danh sách"><i class="fas fa-rotate"></i></button>
                            <button type="button" class="btn btn-sm btn-success" id="btnXuatExcel" title="Xuất danh sách đang lọc ra Excel">
                                <i class="fas fa-file-excel me-1"></i> Excel
                            </button>
                            @if (coQuyenSua && coCongTy)
                            {
                                <button type="button" class="btn btn-sm text-white rounded-3 px-3" style="background-color:#0e7490;" id="btnThemSw">
                                    <i class="fas fa-plus me-1"></i> Thêm switch
                                </button>
                                <button type="button" class="btn btn-sm btn-light border" id="btnDienSnmp" title="Đọc SNMP mọi switch có IP, điền hãng / model / serial / firmware / MAC / số cổng còn trống">
                                    <i class="fas fa-wand-magic-sparkles me-1"></i> Điền từ SNMP
                                </button>
                            }
                        </div>

                        <div class="ccdc-table-wrap" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0 ccdc-table">
                                <colgroup>
                                    <col style="width:48px;">
                                    <col style="width:130px;">
                                    @if (congTy == "BPVN")
                                    {
                                        <col style="width:230px;">
                                    }
                                    <col style="width:100px;">
                                    <col style="width:220px;">
                                    <col style="width:130px;">
                                    <col style="width:150px;">
                                    <col style="width:170px;">
                                    <col style="width:80px;">
                                    <col style="width:130px;">
                                    <col style="width:170px;">
                                    <col style="width:150px;">
                                    <col style="width:180px;">
                                    <col style="width:130px;">
                                    <col style="width:110px;">
                                    <col style="width:90px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Kết nối</th>
                                        @if (congTy == "BPVN")
                                        {
                                            <th title="CPU / RAM / nhiệt độ / số cổng đang up — hệ thống giám sát mạng BPVN (10.0.60.238) poll SNMP">SNMP</th>
                                        }
                                        <th>Mã</th>
                                        <th>Tên switch</th>
                                        <th>IP</th>
                                        <th>MAC</th>
                                        <th>Hãng / Model</th>
                                        <th>Số cổng</th>
                                        <th>Vai trò</th>
                                        <th>Firmware</th>
                                        <th>Bộ phận</th>
                                        <th>Vị trí</th>
                                        <th>Tình trạng</th>
                                        <th>Hạn BH</th>
                                        <th class="ccdc-thaotac">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="swTableBody">
                                    <tr><td colspan="15" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ================= TAB LỊCH SỬ ONLINE/OFFLINE (KK_SwitchLichSu) ================= *@
                    <div class="tab-pane fade" id="paneLichSu" role="tabpanel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <label class="small text-muted mb-0">Từ</label>
                            <input type="date" id="lsTuNgay" class="form-control form-control-sm w-auto">
                            <label class="small text-muted mb-0">đến</label>
                            <input type="date" id="lsDenNgay" class="form-control form-control-sm w-auto">
                            <select id="lsLoai" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi sự kiện --</option>
                                <option value="DOWN">Hoạt động → Mất kết nối</option>
                                <option value="UP">Mất kết nối → Hoạt động</option>
                            </select>
                            <input type="text" id="lsTuKhoa" class="form-control form-control-sm" style="max-width:240px;"
                                   placeholder="Tìm tên switch, IP...">
                            <button type="button" class="btn btn-sm btn-light border" id="lsBtnTaiLai" title="Tải lại"><i class="fas fa-rotate"></i></button>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-2 small text-muted fw-bold">
                            <span>Sự kiện: <span id="lsTong">0</span></span>
                            <span class="text-danger"><i class="fas fa-arrow-down me-1"></i>Mất kết nối: <span id="lsDown">0</span></span>
                            <span class="text-success"><i class="fas fa-arrow-up me-1"></i>Hoạt động lại: <span id="lsUp">0</span></span>
                            <span>Số switch: <span id="lsSoSwitch">0</span></span>
                            <span class="fw-normal" id="lsGhiChu"></span>
                        </div>

                        <div class="ccdc-table-wrap" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0 ccdc-table">
                                <colgroup>
                                    <col style="width:48px;">
                                    <col style="width:150px;">
                                    <col style="width:200px;">
                                    <col style="width:260px;">
                                    <col style="width:140px;">
                                    <col style="width:160px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Thời gian</th>
                                        <th>Sự kiện</th>
                                        <th>Tên switch</th>
                                        <th>IP</th>
                                        <th>Đã mất kết nối</th>
                                    </tr>
                                </thead>
                                <tbody id="lsBody">
                                    <tr><td colspan="6" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ================= TAB THÔNG TIN THIẾT BỊ — SỨC KHOẺ SNMP (KK_SwitchSucKhoe), JS: switch-suc-khoe.js ================= *@
                    <div class="tab-pane fade" id="paneSucKhoe" role="tabpanel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="small fw-bold text-muted" id="skTongHop"></span>
                            <span class="small text-muted" id="skGhiChu"></span>
                            @if (coQuyenSua)
                            {
                                <div class="input-group input-group-sm ms-auto sk-them">
                                    <select id="skChonSwitch" class="form-select form-select-sm" title="Switch thêm vào theo dõi"></select>
                                    <input type="text" id="skTenHienThi" class="form-control form-control-sm" maxlength="100" placeholder="Tên hiển thị (tuỳ chọn)">
                                    <button type="button" class="btn btn-outline-primary" id="skBtnThem"><i class="fas fa-plus me-1"></i>Theo dõi</button>
                                </div>
                            }
                            <button type="button" class="btn btn-sm btn-light border @(coQuyenSua ? "" : "ms-auto")" id="skBtnTaiLai" title="Tải lại"><i class="fas fa-rotate"></i></button>
                        </div>
                        <div class="alert alert-danger py-2 small d-none" id="skLoi"></div>
                        @* Trang khoá cuộn toàn trang (fixed-page-layout): thẻ thiết bị + nhật ký nằm chung 1 vùng cuộn *@
                        <div class="sk-cuon" data-fp-scroll>
                        <div class="row g-3" id="skDanhSach">
                            <div class="col-12 text-center text-muted py-4">Đang tải dữ liệu...</div>
                        </div>

                        <h6 class="fw-bold mt-4 mb-2"><i class="fas fa-clock-rotate-left me-1"></i> Nhật ký đổi trạng thái sức khoẻ</h6>
                        <div class="table-responsive sk-nhat-ky">
                            <table class="table table-sm table-hover align-middle mb-0 sk-bang-nhat-ky">
                                <thead>
                                    <tr><th>Thời gian</th><th>Thiết bị</th><th>Đổi trạng thái</th><th>Chi tiết</th></tr>
                                </thead>
                                <tbody id="skLsBody">
                                    <tr><td colspan="4" class="ccdc-trangthai text-muted py-3">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        </div>@* /sk-cuon *@
                    </div>

                    @if (daiQuet != null)
                    {
                    @* ================= TAB MÁY CHỦ — QUÉT DẢI IP (KK_QuetIp / KK_QuetIpLichSu) ================= *@
                    <div class="tab-pane fade" id="paneMayChu" role="tabpanel" data-dai="@daiQuet">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary active" data-mc-che-do="ds">Danh sách IP</button>
                                <button type="button" class="btn btn-outline-secondary" data-mc-che-do="ls">Lịch sử</button>
                            </div>
                            <span class="small text-muted" id="mcKiemTra"></span>
                        </div>
                        <div class="alert alert-warning py-2 small d-none" id="mcCanhBao"></div>

                        @* --- Danh sách IP đang theo dõi --- *@
                        <div id="mcKhungDs">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <input type="text" id="mcTuKhoa" class="form-control form-control-sm" style="max-width:240px;" placeholder="Tìm IP, tên máy, khai báo...">
                                <select id="mcKetNoi" class="form-select form-select-sm w-auto" title="Lọc theo kết nối">
                                    <option value="">-- Mọi kết nối --</option>
                                    <option value="UP">Online</option>
                                    <option value="DOWN">Mất kết nối</option>
                                </select>
                                <select id="mcKhaiBao" class="form-select form-select-sm w-auto" title="IP đã có trong Switch / AP / thiết bị kiểm kê chưa">
                                    <option value="">-- Mọi IP --</option>
                                    <option value="co">Đã khai báo</option>
                                    <option value="chua">Chưa khai báo</option>
                                </select>
                                <span class="small text-muted fw-bold">
                                    Số IP: <span id="mcTong">0</span> ·
                                    <span class="text-success">Online: <span id="mcOnline">0</span></span> ·
                                    <span class="text-danger">Mất KN: <span id="mcOffline">0</span></span> ·
                                    <span class="text-warning">Chưa khai báo: <span id="mcChuaKhaiBao">0</span></span>
                                </span>
                                <button type="button" class="btn btn-sm btn-light border ms-auto" id="mcBtnTaiLai" title="Tải lại"><i class="fas fa-rotate"></i></button>
                            </div>
                            <div class="ccdc-table-wrap" data-fp-scroll>
                                <table class="table table-hover align-middle mb-0 ccdc-table">
                                    <colgroup>
                                        <col style="width:48px;">
                                        <col style="width:170px;">
                                        <col style="width:130px;">
                                        <col style="width:220px;">
                                        <col style="width:300px;">
                                        <col style="width:140px;">
                                        <col style="width:140px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Kết nối</th>
                                            <th>IP</th>
                                            <th>Tên máy (DNS)</th>
                                            <th>Khai báo</th>
                                            <th>Lần cuối online</th>
                                            <th>Phát hiện lúc</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mcBody">
                                        <tr><td colspan="7" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @* --- Lịch sử đổi trạng thái --- *@
                        <div id="mcKhungLs" class="d-none">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <label class="small text-muted mb-0">Từ</label>
                                <input type="date" id="mcLsTuNgay" class="form-control form-control-sm w-auto">
                                <label class="small text-muted mb-0">đến</label>
                                <input type="date" id="mcLsDenNgay" class="form-control form-control-sm w-auto">
                                <select id="mcLsLoai" class="form-select form-select-sm w-auto">
                                    <option value="">-- Mọi sự kiện --</option>
                                    <option value="DOWN">Hoạt động → Mất kết nối</option>
                                    <option value="UP">Mất kết nối → Hoạt động</option>
                                </select>
                                <input type="text" id="mcLsTuKhoa" class="form-control form-control-sm" style="max-width:240px;" placeholder="Tìm IP, tên máy...">
                                <button type="button" class="btn btn-sm btn-light border" id="mcLsBtnTaiLai" title="Tải lại"><i class="fas fa-rotate"></i></button>
                            </div>
                            <div class="d-flex flex-wrap gap-3 mb-2 small text-muted fw-bold">
                                <span>Sự kiện: <span id="mcLsTong">0</span></span>
                                <span class="text-danger"><i class="fas fa-arrow-down me-1"></i>Mất kết nối: <span id="mcLsDown">0</span></span>
                                <span class="text-success"><i class="fas fa-arrow-up me-1"></i>Hoạt động lại: <span id="mcLsUp">0</span></span>
                                <span>Số máy: <span id="mcLsSoMay">0</span></span>
                                <span class="fw-normal" id="mcLsGhiChu"></span>
                            </div>
                            <div class="ccdc-table-wrap" data-fp-scroll>
                                <table class="table table-hover align-middle mb-0 ccdc-table">
                                    <colgroup>
                                        <col style="width:48px;">
                                        <col style="width:150px;">
                                        <col style="width:200px;">
                                        <col style="width:140px;">
                                        <col style="width:260px;">
                                        <col style="width:160px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Thời gian</th>
                                            <th>Sự kiện</th>
                                            <th>IP</th>
                                            <th>Tên máy</th>
                                            <th>Đã mất kết nối</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mcLsBody">
                                        <tr><td colspan="6" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    }

                </div>@* /tab-content *@
            </div>
        </div>
    </div>
</section>

@if (coQuyenSua)
{
@* ------- Modal thêm / sửa switch ------- *@
<div class="modal fade" id="modalSw" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalSwTitle">Thêm Switch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                @* Ngoài <form>: community không gửi kèm lúc Lưu *@
                <div class="border rounded-3 p-2 mb-3 bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small fw-bold text-muted mb-1" for="snmpIp">IP / hostname</label>
                            <input type="text" class="form-control form-control-sm" id="snmpIp" maxlength="253" placeholder="10.0.63.203 hoặc tên máy">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted mb-1" for="snmpCommunity">SNMP community</label>
                            <input type="password" class="form-control form-control-sm" id="snmpCommunity" maxlength="100" autocomplete="new-password" placeholder="Trống = theo cấu hình">
                        </div>
                        <div class="col-md-3 d-grid">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnKiemTraSnmp">
                                <i class="fas fa-plug me-1"></i> Kiểm tra kết nối
                            </button>
                        </div>
                    </div>
                    <div class="small mt-2 d-none" id="snmpKetQua"></div>
                </div>
                <form id="formSw" class="row g-3">
                    <input type="hidden" id="IdSwitch" name="IdSwitch" value="0" />

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Mã switch</label>
                        <input type="text" class="form-control" id="MaSwitch" name="MaSwitch" maxlength="100">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-bold text-muted">Tên switch <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="TenSwitch" name="TenSwitch" maxlength="255" required
                               placeholder="VD: SW-X1-Core">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Địa chỉ IP</label>
                        <input type="text" class="form-control" id="DiaChiIp" name="DiaChiIp" maxlength="50" placeholder="Để trống = không ping">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Địa chỉ MAC</label>
                        <input type="text" class="form-control" id="DiaChiMac" name="DiaChiMac" maxlength="20" placeholder="AA:BB:CC:DD:EE:FF">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Vai trò</label>
                        <select class="form-select" id="VaiTro" name="VaiTro">
                            <option value="">-- Chọn vai trò --</option>
                            @foreach (var vt in dsVaiTro)
                            {
                                <option value="@vt">@vt</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Hãng</label>
                        <input type="text" class="form-control" id="HangSanXuat" name="HangSanXuat" maxlength="100" placeholder="Huawei, Cisco, Aruba...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Model</label>
                        <input type="text" class="form-control" id="Model" name="Model" maxlength="100">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Serial</label>
                        <input type="text" class="form-control" id="Serial" name="Serial" maxlength="100">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Số cổng</label>
                        <input type="number" class="form-control" id="SoCong" name="SoCong" min="1" max="1000" placeholder="24, 48...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Firmware</label>
                        <input type="text" class="form-control" id="PhienBan" name="PhienBan" maxlength="100">
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted">Bộ phận</label>
                        <select class="form-select" id="IdboPhan" name="IdboPhan">
                            <option value="">-- Chọn bộ phận --</option>
                            @foreach (var bp in dsBoPhan)
                            {
                                <option value="@bp.IdboPhan">@bp.TenBoPhan</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted">Vị trí lắp đặt</label>
                        <input type="text" class="form-control" id="ViTri" name="ViTri" maxlength="500" placeholder="Phòng / tủ rack">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Tình trạng</label>
                        <select class="form-select" id="TinhTrang" name="TinhTrang">
                            @foreach (var tt in dsTinhTrang)
                            {
                                <option value="@tt">@tt</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Ngày lắp đặt</label>
                        <input type="date" class="form-control" id="NgayLapDat" name="NgayLapDat">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Hạn bảo hành</label>
                        <input type="date" class="form-control" id="HanBaoHanh" name="HanBaoHanh">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Ghi chú</label>
                        <textarea class="form-control" id="GhiChu" name="GhiChu" rows="2"></textarea>
                    </div>
                </form>
                <div class="small text-muted mt-2">"Ngừng sử dụng" / "Trong kho" hoặc không có IP thì không ping, không tính vào % hoạt động.</div>
                <div class="alert alert-danger py-2 small mt-3 mb-0 d-none" id="swLoi"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn text-white rounded-pill px-4" style="background-color:#0e7490;" id="btnLuuSw">
                    <i class="fas fa-save me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@* ------- Modal xoá switch (xoá mềm, ghi lý do vào lịch sử) ------- *@
<div class="modal fade" id="modalDienSnmp" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-wand-magic-sparkles me-2"></i> Điền thông tin từ SNMP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Đọc SNMP mọi switch đang theo dõi (có IP), điền hãng / model / serial / firmware / MAC / số cổng
                    vào ô <b>còn trống</b> — không ghi đè dữ liệu đã nhập. Có thể mất 1–2 phút.</p>
                <label class="form-label small fw-bold text-muted" for="dienSnmpCommunity">SNMP community</label>
                <input type="password" class="form-control" id="dienSnmpCommunity" maxlength="100" autocomplete="new-password" placeholder="Trống = theo cấu hình máy chủ">
                <div class="alert py-2 small mt-3 mb-0 d-none" id="dienSnmpKetQua"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn text-white rounded-pill px-4" style="background-color:#0e7490;" id="btnXacNhanDienSnmp">
                    <i class="fas fa-play me-1"></i> Bắt đầu
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalXoaSw" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fas fa-trash me-2"></i> Xoá switch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="xoaIdSwitch" value="0">
                <p class="mb-2">Xoá <strong id="xoaTenSwitch"></strong>?</p>
                <label class="form-label small fw-bold text-muted">Lý do xoá</label>
                <input type="text" class="form-control" id="xoaLyDo" maxlength="500" placeholder="Ví dụ: hỏng đã tháo, thay switch mới...">
                <div class="alert alert-danger py-2 small mt-3 mb-0 d-none" id="xoaLoi"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" id="btnXacNhanXoaSw">Xoá</button>
            </div>
        </div>
    </div>
</div>
}

@* ------- Modal chi tiết switch: bấm vào dòng trong danh sách (mọi người có quyền xem) ------- *@
<div class="modal fade" id="modalChiTietSw" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-network-wired me-2"></i> <span id="ctTieuDe">Chi tiết switch</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3" id="ctTrangThai"></div>
                <div class="row g-2 small" id="ctThongTin"></div>
                <div class="mt-3 d-none" id="ctKhungSnmp">
                    <div class="fw-bold text-muted small text-uppercase mb-2">SNMP (hệ thống giám sát mạng)</div>
                    <div class="row g-2 small" id="ctSnmp"></div>
                </div>
                <div class="mt-3">
                    <div class="fw-bold text-muted small text-uppercase mb-2">
                        Lịch sử kết nối 30 ngày <span class="fw-normal text-lowercase" id="ctLsTomTat"></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 small">
                            <thead><tr><th>Thời gian</th><th>Sự kiện</th><th>Đã mất kết nối</th></tr></thead>
                            <tbody id="ctLsBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                @if (coQuyenSua)
                {
                    <button type="button" class="btn btn-primary rounded-pill px-4" id="btnCtSua"><i class="fas fa-pen me-1"></i> Sửa</button>
                }
            </div>
        </div>
    </div>
</div>

@if (congTy == "BPVN")
{
    @* ------- Modal tra MAC: thiết bị đang cắm switch / cổng nào (bảng MAC hệ thống giám sát mạng 10.0.60.238) ------- *@
    <div class="modal fade" id="modalTraMac" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow" style="border-radius:15px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="fas fa-magnifying-glass-location me-2"></i> Tra MAC — thiết bị đang cắm cổng nào</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <form id="formTraMac" class="d-flex gap-2 mb-2" autocomplete="off">
                        <input type="text" class="form-control font-monospace" id="traMacQ" maxlength="40"
                               placeholder="MAC đầy đủ hoặc một đoạn: 00:9e:1e:e3:6b:60 · 009e.1ee3 · 00-9E-1E">
                        <button type="submit" class="btn btn-primary text-nowrap" id="btnTraMacTim"><i class="fas fa-magnifying-glass me-1"></i> Tìm</button>
                    </form>
                    <div class="small text-muted mb-2" id="traMacTomTat">Bảng MAC do hệ thống giám sát mạng đọc từ switch (~10 phút/lần). Một MAC có thể hiện ở nhiều switch: cổng có ít MAC nhất thường là cổng cắm thật, các cổng còn lại là đường trục.</div>
                    <div class="alert alert-danger py-2 small d-none" id="traMacLoi"></div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 small">
                            <thead><tr><th>MAC</th><th>Switch</th><th>IP switch</th><th>Cổng</th><th class="text-end">VLAN</th><th>Thấy lúc</th></tr></thead>
                            <tbody id="traMacBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

