@{
    Layout = "~/Areas/ITForm/Views/Shared/_Layout.cshtml";
    // null = tổng quan các công ty; "BPVN"/"PFVN"/"MEGA" = báo cáo riêng công ty đó (mở từ nút "Báo cáo" ở trang công ty)
    var congTyBaoCao = ViewBag.CongTyBaoCao as string;
    var tieuDe = congTyBaoCao == null ? "Tổng quan Switch" : "Báo cáo Switch " + congTyBaoCao;
    ViewData["Title"] = tieuDe;
}

