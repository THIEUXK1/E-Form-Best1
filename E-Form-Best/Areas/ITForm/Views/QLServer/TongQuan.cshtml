@{
    Layout = "~/Areas/ITForm/Views/Shared/_Layout.cshtml";
    // null = tổng quan các công ty; "BPVN"/"PFVN"/"MEGA" = báo cáo riêng công ty đó (mở từ nút "Báo cáo" ở trang công ty)
    var congTyBaoCao = ViewBag.CongTyBaoCao as string;
    ViewData["Title"] = congTyBaoCao == null ? "Tổng quan Server và lưu trữ" : "Báo cáo Server và lưu trữ " + congTyBaoCao;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
@* Dùng chung bộ khung báo cáo của camera/switch (thẻ số liệu, vòng %, bảng, bản in) *@
<link rel="stylesheet" href="/css/ccdc-quanly.css?v=20260825e">
<link rel="stylesheet" href="/css/camera-quanly.css?v=20261016a">
<link rel="stylesheet" href="/css/camera-tong-quan.css?v=20261009b">
<link rel="stylesheet" href="/css/server-quanly.css?v=202611180956">

@* Area ITForm không có _ViewImports nên tag helper <partial> không chạy -> dùng Html.PartialAsync *@
@await Html.PartialAsync("_TongQuanNoiDung")

<script src="/js/bao-cao-so-sanh.js?v=2"></script>
<script src="/js/server-tong-quan.js?v=20261024a"></script>
