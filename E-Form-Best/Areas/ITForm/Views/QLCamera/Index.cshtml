                    }

                </div>@* /tab-content *@
            </div>
        </div>
    </div>
</section>

@* ------- Modal xem trực tiếp (mở khi bấm 1 camera ở tab Giám sát) ------- *@
<div class="modal fade" id="modalXemCamera" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold mb-0"><i class="fas fa-video me-2" style="color:#7c3aed;"></i><span id="xemTen"></span></h5>
                    <div class="small text-muted" id="xemThongTin"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="cam-xem-khung" id="xemKhung">
                    <video id="xemVideo" autoplay muted playsinline></video>
                    <img id="xemAnh" alt="Ảnh camera">
                    <div class="cam-xem-nhan" id="xemNhan">Đang kết nối...</div>
                    @* Chỉ hiện khi đang toàn màn hình (CSS :fullscreen) *@
                    <button type="button" class="cam-xem-thoat" id="xemThoatToanManHinh" title="Thoát toàn màn hình (Esc)">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <div class="btn-group btn-group-sm me-auto" role="group">
                    @if (coXemTrucTiep)
                    {
                    if (coVideo)
                    {
                    <button type="button" class="btn btn-outline-primary" id="xemCheDoVideo"><i class="fas fa-film me-1"></i> Video</button>
                    }
                    <button type="button" class="btn btn-outline-primary" id="xemCheDoAnh"><i class="fas fa-image me-1"></i> Ảnh (1 giây/lần)</button>
                    }
                    <button type="button" class="btn btn-outline-primary" id="xemCheDoAnhLuu" title="Ảnh chụp sẵn theo giờ định kỳ, mở được cả khi không kết nối được đầu ghi">
                        <i class="fas fa-clock-rotate-left me-1"></i> Ảnh lưu sẵn
                    </button>
                </div>

                @* Ghi chú của camera đang xem: chọn câu có sẵn (▾) hoặc gõ rồi Lưu; "+" lưu câu đang gõ thành có sẵn *@
                <div class="input-group input-group-sm cam-xem-ghi-chu">
                    @if (coQuyenSua)
                    {
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                data-bs-auto-close="outside" title="Chọn ghi chú có sẵn">
                            <i class="fas fa-list"></i>
                        </button>
                        <ul class="dropdown-menu cam-ds-mau" id="xemDsMau"></ul>
                        <input type="text" class="form-control" id="xemGhiChu" maxlength="1000" placeholder="Ghi chú cho camera này...">
                        <button class="btn btn-outline-secondary" type="button" id="xemThemMau" title="Thêm câu đang gõ vào ghi chú có sẵn">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button class="btn btn-primary" type="button" id="xemLuuGhiChu" title="Lưu ghi chú (Enter)">
                            <i class="fas fa-save"></i>
                        </button>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="xemGhiChu" readonly placeholder="Chưa có ghi chú">
                    }
                </div>

                @if (coXemTrucTiep)
                {
                <a class="btn btn-sm btn-light border" id="xemTaiAnh" target="_blank" rel="noopener"><i class="fas fa-camera me-1"></i> Mở ảnh chụp</a>
                }
                <button type="button" class="btn btn-sm btn-light border" id="xemToanManHinh"><i class="fas fa-expand me-1"></i> Toàn màn hình</button>
                <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@* ------- Modal thêm / sửa camera (tài sản) ------- *@
<div class="modal fade" id="modalCamera" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalCameraTitle">Thêm camera</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formCamera" class="row g-3">
                    <input type="hidden" id="IdCamera" name="IdCamera" value="0" />

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Mã camera</label>
                        <input type="text" class="form-control" id="MaCamera" name="MaCamera" maxlength="100">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-bold text-muted">Tên camera <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="TenCamera" name="TenCamera" maxlength="255" required
                               placeholder="VD: Cổng chính, Kho thành phẩm góc trái">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Địa chỉ IP</label>
                        <input type="text" class="form-control" id="DiaChiIp" name="DiaChiIp" maxlength="50" placeholder="192.168.1.64">
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted">Đầu ghi (NVR/DVR)</label>
                        <input type="text" class="form-control" id="DauGhi" name="DauGhi" maxlength="255" placeholder="Tên hoặc IP đầu ghi">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Kênh</label>
                        <input type="number" class="form-control" id="Kenh" name="Kenh" min="0">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Hãng</label>
                        <input type="text" class="form-control" id="HangSanXuat" name="HangSanXuat" maxlength="100" placeholder="Hikvision, Dahua...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Model</label>
                        <input type="text" class="form-control" id="Model" name="Model" maxlength="100">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Serial</label>
                        <input type="text" class="form-control" id="Serial" name="Serial" maxlength="100">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Công ty</label>
                        <select class="form-select" id="IdcongTy" name="IdcongTy">
                            <option value="">-- Chọn công ty --</option>
                            @foreach (var ct in dsCongTy)
                            {
                                <option value="@ct.IdcongTy">@ct.TenCongTy</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Bộ phận</label>
                        <select class="form-select" id="IdboPhan" name="IdboPhan">
                            <option value="">-- Chọn bộ phận --</option>
                            @foreach (var bp in dsBoPhan)
                            {
                                <option value="@bp.IdboPhan" data-congty="@bp.IdcongTy">@bp.TenBoPhan</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted">Vị trí lắp đặt</label>
                        <input type="text" class="form-control" id="ViTri" name="ViTri" maxlength="500">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Tình trạng</label>
                        <select class="form-select" id="TinhTrang" name="TinhTrang">
                            @foreach (var tt in dsTinhTrang)
                            {
                                <option value="@tt">@tt</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Ngày lắp đặt</label>
                        <input type="date" class="form-control" id="NgayLapDat" name="NgayLapDat">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Hạn bảo hành</label>
                        <input type="date" class="form-control" id="HanBaoHanh" name="HanBaoHanh">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Ghi chú</label>
                        <textarea class="form-control" id="GhiChu" name="GhiChu" rows="2"></textarea>
                    </div>
                </form>
                <div class="alert alert-danger py-2 small mt-3 mb-0 d-none" id="cameraLoi"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn text-white rounded-pill px-4" style="background-color:#7c3aed;" id="btnLuuCamera">
                    <i class="fas fa-save me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@* ------- Modal xoá camera (xoá mềm, ghi lý do vào lịch sử) ------- *@
<div class="modal fade" id="modalXoaCamera" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fas fa-trash me-2"></i> Xoá camera</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="xoaIdCamera" value="0">
                <p class="mb-2">Xoá <strong id="xoaTenCamera"></strong>?</p>
                <label class="form-label small fw-bold text-muted">Lý do xoá</label>
                <input type="text" class="form-control" id="xoaLyDo" maxlength="500" placeholder="Ví dụ: hỏng đã tháo, thay camera mới...">
                <div class="alert alert-danger py-2 small mt-3 mb-0 d-none" id="xoaLoi"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" id="btnXacNhanXoaCamera">Xoá</button>
            </div>
        </div>
    </div>
</div>

@* ------- Modal thêm / sửa đầu ghi chi nhánh ------- *@
<div class="modal fade" id="modalDauGhi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalDauGhiTitle">Thêm đầu ghi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formDauGhi" class="row g-3">
                    <input type="hidden" id="IdDauGhi" name="IdDauGhi" value="0" />

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Địa điểm <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dgDiaDiem" name="DiaDiem" maxlength="255" placeholder="Gia Lộc, Sembcorp HD...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Trạng thái</label>
                        <select class="form-select" id="dgTrangThaiSua" name="TrangThai">
                            @foreach (var tt in dsTrangThaiDauGhi)
                            {
                                <option value="@tt">@tt</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">IP public / tên miền DDNS</label>
                        <input type="text" class="form-control" id="dgIpPublic" name="IpPublic" maxlength="255">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">IP local</label>
                        <input type="text" class="form-control" id="dgIpLocal" name="IpLocal" maxlength="50">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Port SV</label>
                        <input type="number" class="form-control" id="dgPortSv" name="PortSv" min="1" max="65535" placeholder="8000">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Port web</label>
                        <input type="number" class="form-control" id="dgPortWeb" name="PortWeb" min="1" max="65535" placeholder="80">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Số camera</label>
                        <input type="number" class="form-control" id="dgTongCamera" name="TongCamera" min="0">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">RAID</label>
                        <input type="text" class="form-control" id="dgRaid" name="Raid" maxlength="50" placeholder="RAID 5">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Ghi chú</label>
                        <textarea class="form-control" id="dgGhiChu" name="GhiChu" rows="2" placeholder="Đường dẫn web xem camera, nhà mạng... KHÔNG ghi mật khẩu vào đây"></textarea>
                    </div>
                </form>
                <div class="alert alert-danger py-2 small mt-3 mb-0 d-none" id="dauGhiLoi"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn text-white rounded-pill px-4" style="background-color:#7c3aed;" id="btnLuuDauGhi">
                    <i class="fas fa-save me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

