@{
    Layout = "~/Areas/ITForm/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý camera";

    @* Kiểu tường minh thay cho dynamic: view chạy ở assembly khác khi bật runtime compilation *@
    var dsCongTy = ViewBag.DsCongTy as IEnumerable<E_Form_Best.Models.ITForm.KkCongTy>
                   ?? Enumerable.Empty<E_Form_Best.Models.ITForm.KkCongTy>();
    var dsBoPhan = ViewBag.DsBoPhan as IEnumerable<E_Form_Best.Models.ITForm.KkBoPhan>
                   ?? Enumerable.Empty<E_Form_Best.Models.ITForm.KkBoPhan>();
    var dsTinhTrang = ViewBag.DsTinhTrang as IEnumerable<string> ?? Enumerable.Empty<string>();
    var dsTrangThaiDauGhi = ViewBag.DsTrangThaiDauGhi as IEnumerable<string> ?? Enumerable.Empty<string>();
    // Chỉ quyền "All" được thêm/sửa/xoá; CamBPVN chỉ xem (server vẫn chặn lại ở từng action)
    var coQuyenSua = ViewBag.CoQuyenSua as bool? ?? false;
    // PFVN/MEGA dùng chung trang này nhưng chỉ có tab Giám sát + ảnh lưu (không có hệ thống giám sát,
    // lịch sử, đầu ghi chi nhánh, tài sản; máy chủ không thông mạng đầu ghi nên không xem trực tiếp)
    var congTy = ViewBag.CongTy as string ?? "BPVN";
    var laBpvn = congTy == "BPVN";
    // Xem trực tiếp: BPVN luôn có; PFVN/MEGA có khi đã khai go2rtc bên công ty đó (Camera{CÔNG TY}__Go2rtcUrl)
    // hoặc đầu ghi máy chủ gọi thẳng được (Camera{CÔNG TY}__DauGhi__N — chỉ có ảnh, không có video)
    var coXemTrucTiep = laBpvn || (ViewBag.CoXemTrucTiep as bool? ?? false);
    var coVideo = laBpvn || (ViewBag.CoVideo as bool? ?? false);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
@* Dùng lại khung bảng của trang CCDC (cùng nhóm menu, cùng kiểu bảng cột cố định) *@
<link rel="stylesheet" href="/css/ccdc-quanly.css?v=20260825e">
<link rel="stylesheet" href="/css/fixed-page-layout.css?v=5">
<link rel="stylesheet" href="/css/camera-quanly.css?v=20261009a">

<div class="content-header pt-0 pb-0" style="margin-top: -25px;">
    <div class="container-fluid">
        <div class="dash-topbar">
            <h4 class="dash-title"><span class="dash-title-icon"><i class="fas fa-video"></i></span>Camera @congTy</h4>

            <ul class="nav nav-pills nav-pills-ccdc mb-0" id="cameraTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tabGiamSatBtn" data-bs-toggle="pill" data-bs-target="#paneGiamSat" type="button" role="tab">
                        <i class="fas fa-heart-pulse me-1"></i> Giám sát
                        <span class="badge rounded-pill bg-danger ms-1 d-none" id="badgeMatKetNoi">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tabLuoiBtn" data-bs-toggle="pill" data-bs-target="#paneLuoi" type="button" role="tab">
                        <i class="fas fa-table-cells me-1"></i> Lưới ảnh
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tabLichSuBtn" data-bs-toggle="pill" data-bs-target="#paneLichSu" type="button" role="tab">
                        <i class="fas fa-clock-rotate-left me-1"></i> Lịch sử
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tabDauGhiBtn" data-bs-toggle="pill" data-bs-target="#paneDauGhi" type="button" role="tab">
                        <i class="fas fa-server me-1"></i> Đầu ghi chi nhánh
                    </button>
                </li>
                @if (laBpvn)
                {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tabTaiSanBtn" data-bs-toggle="pill" data-bs-target="#paneTaiSan" type="button" role="tab">
                        <i class="fas fa-tags me-1"></i> Tài sản camera
                    </button>
                </li>
                }
            </ul>

            @* Báo cáo định kỳ riêng công ty này: trang in + Excel (dùng chung trang Tổng quan, lọc 1 công ty) *@
            <a class="btn btn-sm btn-primary ms-auto" href="/QLCamera/TongQuan?congTy=@congTy" title="Báo cáo định kỳ camera @congTy: in / xuất Excel">
                <i class="fas fa-file-lines me-1"></i> Báo cáo
            </a>
        </div>
    </div>
</div>

<section class="content @(coQuyenSua ? "" : "cam-chi-xem")" data-chi-xem="@(coQuyenSua ? null : "1")" data-cong-ty="@congTy">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm bg-white" style="border-radius: 15px;">
            <div class="card-body p-2 p-md-3">
                <div class="tab-content">

                    @* ================= TAB GIÁM SÁT (đọc từ hệ thống ISAPI) ================= *@
                    <div class="tab-pane fade show active" id="paneGiamSat" role="tabpanel">

                        <div class="alert alert-danger py-2 small d-none" id="gsLoi"></div>

                        <div class="cam-tiles mb-2">
                            <div class="cam-tile cam-tile-loc" data-loc="tat-ca" title="Bấm để xem tất cả camera"><div class="cam-tile-nhan">Tổng camera</div><div class="cam-tile-so" id="gsTong">–</div></div>
                            <div class="cam-tile cam-tile-up cam-tile-loc" data-loc="UP" title="Bấm để chỉ xem camera đang hoạt động"><div class="cam-tile-nhan">Hoạt động</div><div class="cam-tile-so" id="gsUp">–</div></div>
                            <div class="cam-tile cam-tile-down cam-tile-loc" data-loc="DOWN" title="Bấm để chỉ xem camera mất kết nối"><div class="cam-tile-nhan">Mất kết nối</div><div class="cam-tile-so" id="gsDown">–</div><div class="cam-tile-phu" id="gsTyLe"></div></div>
                            <div class="cam-tile"><div class="cam-tile-nhan">Đầu ghi sẵn sàng</div><div class="cam-tile-so" id="gsNvr">–</div><div class="cam-tile-phu" id="gsNvrLoi"></div></div>
                            @if (laBpvn)
                            {
                            <div class="cam-tile cam-tile-loc" data-loc="chu-y" title="Bấm để chỉ xem camera chú ý"><div class="cam-tile-nhan">Đã loại trừ / Chú ý</div><div class="cam-tile-so" id="gsLoaiTru">–</div></div>
                            }
                            <div class="cam-tile"><div class="cam-tile-nhan">Kiểm tra gần nhất</div><div class="cam-tile-so cam-tile-so-nho" id="gsLanCuoi">–</div><div class="cam-tile-phu" id="gsLanCuoiTrangThai"></div></div>
                        </div>

                        <div class="row g-2 mb-2">
                            @if (laBpvn)
                            {
                            <div class="col-lg-7">
                                <div class="cam-khung">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="fw-bold small text-muted"><i class="fas fa-chart-line me-1"></i> Xu hướng theo các lần kiểm tra</span>
                                        <select id="gsKhoangXuHuong" class="form-select form-select-sm w-auto ms-auto">
                                            <option value="72">6 giờ gần nhất</option>
                                            <option value="288">24 giờ</option>
                                            <option value="864">3 ngày</option>
                                        </select>
                                    </div>
                                    <div class="cam-bieu-do"><canvas id="gsBieuDo"></canvas></div>
                                </div>
                            </div>
                            }
                            <div class="@(laBpvn ? "col-lg-5" : "col-12")">
                                <div class="cam-khung">
                                    <div class="fw-bold small text-muted mb-1"><i class="fas fa-server me-1"></i> Đầu ghi @congTy (bấm để lọc camera)</div>
                                    <div class="cam-bang-nvr">
                                        <table class="table table-sm table-hover align-middle mb-0 small">
                                            <thead>
                                                <tr><th>Đầu ghi</th><th>Khu</th><th class="text-end">Kênh</th><th class="text-end">Mất KN</th><th>Trạng thái</th></tr>
                                            </thead>
                                            <tbody id="gsNvrBody">
                                                <tr><td colspan="5" class="text-center text-muted py-3">Đang tải...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <input type="text" id="gsTuKhoa" class="form-control form-control-sm" style="max-width:280px;"
                                   placeholder="Tìm tên camera, IP, đầu ghi, khu vực...">
                            <select id="gsTrangThai" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi trạng thái --</option>
                                <option value="UP">Hoạt động</option>
                                <option value="DOWN">Mất kết nối</option>
                            </select>
                            <select id="gsNvrLoc" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi đầu ghi --</option>
                            </select>
                            <select id="gsKhuVuc" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi khu vực --</option>
                            </select>
                            <div class="form-check form-switch mb-0" title="Ghim lưu riêng trên máy/trình duyệt này">
                                <input class="form-check-input" type="checkbox" id="gsChiGhim">
                                <label class="form-check-label small" for="gsChiGhim"><i class="fas fa-thumbtack"></i> Chỉ camera đã ghim</label>
                            </div>
                            @if (laBpvn)
                            {
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="gsChiChuY">
                                <label class="form-check-label small" for="gsChiChuY">★ Chỉ camera chú ý</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="gsGomLoaiTru">
                                <label class="form-check-label small" for="gsGomLoaiTru">Gồm camera đã loại trừ</label>
                            </div>
                            }
                            <span class="flex-grow-1"></span>
                            <span class="small text-muted" id="gsDemCamera"></span>
                            <div class="form-check form-switch mb-0" title="@(laBpvn ? "Hệ thống ISAPI kiểm tra khoảng 5 phút một lần" : "Trạng thái kiểm tra 5 phút/lần; ảnh lưu chụp lúc 08:30 và 14:00")">
                                <input class="form-check-input" type="checkbox" id="gsTuLamMoi" checked>
                                <label class="form-check-label small" for="gsTuLamMoi">Tự làm mới 60 giây</label>
                            </div>
                            <button type="button" class="btn btn-sm btn-light border" id="gsBtnTaiLai" title="Tải lại"><i class="fas fa-rotate"></i></button>
                        </div>

                        <div class="ccdc-table-wrap" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0 ccdc-table cam-table-gs">
                                <colgroup>
                                    <col style="width:78px;">
                                    <col style="width:120px;">
                                    <col style="width:230px;">
                                    <col style="width:130px;">
                                    <col style="width:190px;">
                                    <col style="width:90px;">
                                    <col style="width:60px;">
                                    <col style="width:170px;">
                                    <col style="width:150px;">
                                    <col style="width:280px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Trạng thái</th>
                                        <th>Tên camera</th>
                                        <th>IP</th>
                                        <th>Đầu ghi</th>
                                        <th>Khu vực</th>
                                        <th class="ccdc-num">Kênh</th>
                                        <th>Mất kết nối từ</th>
                                        <th>Đổi trạng thái lúc</th>
                                        <th>Ghi chú <span class="fw-normal text-muted">(bấm để sửa)</span></th>
                                    </tr>
                                </thead>
                                <tbody id="gsCameraBody">
                                    <tr><td colspan="10" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ================= TAB LƯỚI ẢNH (ảnh lưu sẵn + thông tin, dữ liệu dùng chung tab Giám sát) ================= *@
                    <div class="tab-pane fade" id="paneLuoi" role="tabpanel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <input type="text" id="luoiTuKhoa" class="form-control form-control-sm" style="max-width:280px;"
                                   placeholder="Tìm tên camera, IP, đầu ghi, ghi chú...">
                            <select id="luoiTrangThai" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi trạng thái --</option>
                                <option value="UP">Hoạt động</option>
                                <option value="DOWN">Mất kết nối</option>
                            </select>
                            <select id="luoiNvr" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi đầu ghi --</option>
                            </select>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="luoiChiGhim">
                                <label class="form-check-label small" for="luoiChiGhim"><i class="fas fa-thumbtack"></i> Chỉ camera đã ghim</label>
                            </div>
                            <span class="flex-grow-1"></span>
                            <span class="small text-muted" id="luoiDem"></span>
                            <select id="luoiCo" class="form-select form-select-sm w-auto" title="Cỡ ô ảnh">
                                <option value="nho">Ô nhỏ</option>
                                <option value="vua" selected>Ô vừa</option>
                                <option value="lon">Ô lớn</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-light border" id="luoiBtnTaiLai" title="Tải lại dữ liệu và ảnh"><i class="fas fa-rotate"></i></button>
                        </div>
                        <div class="small text-muted mb-2"><i class="fas fa-circle-info me-1"></i>Ảnh lưu sẵn chụp định kỳ (08:30 và 14:00), không phải hình trực tiếp. Bấm 1 ô để mở cửa sổ xem.</div>
                        <div class="cam-luoi-cuon" data-fp-scroll>
                            <div class="cam-luoi cam-luoi-vua" id="luoiKhung">
                                <div class="cam-luoi-trong text-muted">Đang tải dữ liệu...</div>
                            </div>
                        </div>
                    </div>

                    @* ================= TAB LỊCH SỬ ĐỔI TRẠNG THÁI (KK_CameraLichSu) ================= *@
                    <div class="tab-pane fade" id="paneLichSu" role="tabpanel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <label class="small text-muted mb-0">Từ</label>
                            <input type="date" id="lsTuNgay" class="form-control form-control-sm w-auto">
                            <label class="small text-muted mb-0">đến</label>
                            <input type="date" id="lsDenNgay" class="form-control form-control-sm w-auto">
                            <select id="lsLoai" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi sự kiện --</option>
                                <option value="DOWN">Hoạt động → Mất kết nối</option>
                                <option value="UP">Mất kết nối → Hoạt động</option>
                            </select>
                            <select id="lsNvr" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi đầu ghi --</option>
                            </select>
                            <input type="text" id="lsTuKhoa" class="form-control form-control-sm" style="max-width:240px;"
                                   placeholder="Tìm tên camera, IP, đầu ghi...">
                            <button type="button" class="btn btn-sm btn-light border" id="lsBtnTaiLai" title="Tải lại"><i class="fas fa-rotate"></i></button>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-2 small text-muted fw-bold">
                            <span>Sự kiện: <span id="lsTong">0</span></span>
                            <span class="text-danger"><i class="fas fa-arrow-down me-1"></i>Mất kết nối: <span id="lsDown">0</span></span>
                            <span class="text-success"><i class="fas fa-arrow-up me-1"></i>Hoạt động lại: <span id="lsUp">0</span></span>
                            <span>Số camera: <span id="lsSoCamera">0</span></span>
                            <span class="fw-normal" id="lsGhiChu"></span>
                        </div>

                        <div class="ccdc-table-wrap" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0 ccdc-table cam-table-ls">
                                <colgroup>
                                    <col style="width:48px;">
                                    <col style="width:150px;">
                                    <col style="width:200px;">
                                    <col style="width:230px;">
                                    <col style="width:130px;">
                                    <col style="width:200px;">
                                    <col style="width:90px;">
                                    <col style="width:60px;">
                                    <col style="width:150px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Thời gian</th>
                                        <th>Sự kiện</th>
                                        <th>Tên camera</th>
                                        <th>IP</th>
                                        <th>Đầu ghi</th>
                                        <th>Khu vực</th>
                                        <th class="ccdc-num">Kênh</th>
                                        <th>Đã mất kết nối</th>
                                    </tr>
                                </thead>
                                <tbody id="lsBody">
                                    <tr><td colspan="9" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ================= TAB ĐẦU GHI CHI NHÁNH (KK_DauGhi) ================= *@
                    <div class="tab-pane fade" id="paneDauGhi" role="tabpanel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <input type="text" id="dgTuKhoa" class="form-control form-control-sm" style="max-width:280px;"
                                   placeholder="Tìm địa điểm, IP, ghi chú...">
                            <select id="dgTrangThai" class="form-select form-select-sm w-auto">
                                <option value="">-- Mọi trạng thái --</option>
                                @foreach (var tt in dsTrangThaiDauGhi)
                                {
                                    <option value="@tt">@tt</option>
                                }
                            </select>
                            <span class="small text-muted fw-bold ms-2">
                                Số đầu ghi: <span id="dgTongDong">0</span> · Tổng camera khai báo: <span id="dgDemCamera">0</span>
                            </span>
                            <span class="flex-grow-1"></span>
                            <span class="small text-muted"><i class="fas fa-lock me-1"></i>Không lưu mật khẩu đầu ghi trên web</span>
                            @if (coQuyenSua)
                            {
                                <button type="button" class="btn btn-sm text-white rounded-3 px-3" style="background-color:#7c3aed;" id="btnThemDauGhi">
                                    <i class="fas fa-plus me-1"></i> Thêm đầu ghi
                                </button>
                            }
                        </div>

                        <div class="ccdc-table-wrap" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0 ccdc-table cam-table-dg">
                                <colgroup>
                                    <col style="width:48px;">
                                    <col style="width:210px;">
                                    <col style="width:220px;">
                                    <col style="width:140px;">
                                    <col style="width:80px;">
                                    <col style="width:80px;">
                                    <col style="width:80px;">
                                    <col style="width:90px;">
                                    <col style="width:110px;">
                                    <col style="width:280px;">
                                    <col style="width:90px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Địa điểm</th>
                                        <th>IP public / tên miền</th>
                                        <th>IP local</th>
                                        <th class="ccdc-num">Port SV</th>
                                        <th class="ccdc-num">Port web</th>
                                        <th class="ccdc-num">Số cam</th>
                                        <th>RAID</th>
                                        <th>Trạng thái</th>
                                        <th>Ghi chú</th>
                                        <th class="ccdc-thaotac">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="dgBody">
                                    <tr><td colspan="11" class="ccdc-trangthai text-muted py-4">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @if (laBpvn)
                    {
                    @* ================= TAB TÀI SẢN CAMERA (KK_Camera, nhập tay) ================= *@
                    <div class="tab-pane fade" id="paneTaiSan" role="tabpanel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <input type="text" id="filterTuKhoa" class="form-control form-control-sm" style="max-width:260px;"
                                   placeholder="Tìm tên, mã, IP, đầu ghi, model, vị trí...">

                            <select id="filterCongTy" class="form-select form-select-sm w-auto" title="Lọc theo công ty">
                                <option value="">-- Tất cả công ty --</option>
                                @foreach (var ct in dsCongTy)
                                {
                                    <option value="@ct.IdcongTy">@ct.TenCongTy</option>
                                }
                            </select>

                            <select id="filterBoPhan" class="form-select form-select-sm w-auto" title="Lọc theo bộ phận">
                                <option value="">-- Tất cả bộ phận --</option>
                                @foreach (var bp in dsBoPhan)
                                {
                                    <option value="@bp.IdboPhan" data-congty="@bp.IdcongTy">@bp.TenBoPhan</option>
                                }
                            </select>

                            <select id="filterTinhTrang" class="form-select form-select-sm w-auto" title="Lọc theo tình trạng">
                                <option value="">-- Tất cả tình trạng --</option>
                                @foreach (var tt in dsTinhTrang)
                                {
                                    <option value="@tt">@tt</option>
                                }
                            </select>

                            <select id="filterTrucTuyen" class="form-select form-select-sm w-auto" title="Lọc theo kết nối">
                                <option value="">-- Online + Offline --</option>
                                <option value="online">Đang online</option>
                                <option value="offline">Mất kết nối</option>
                            </select>

