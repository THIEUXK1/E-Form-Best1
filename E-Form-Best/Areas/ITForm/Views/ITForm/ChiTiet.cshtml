                            <p style="margin:0 0 15px 0; font-size:13px; font-weight:800; color:#9a3412; display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="fa fa-user-edit" style="font-size: 16px;"></i> CHỈ ĐỊNH / THAY ĐỔI NGƯỜI HỖ TRỢ:
                            </p>

                            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                                <select id="selectIT"
                                        style="flex: 1; min-width: 200px; padding: 14px; border-radius: 12px; border: 1.5px solid #fdba74; font-weight: 600; outline: none; background: white; font-size: 15px; color: #1e293b; transition: border-color 0.2s;"
                                        onfocus="this.style.borderColor='#ea580c'"
                                        onblur="this.style.borderColor='#fdba74'">
                                    <option value="">-- Chọn nhân viên IT hỗ trợ --</option>
                                    @if (ViewBag.ListNguoiHoTro != null)
                                    {
                                        foreach (var it in (List<E_Form_Best.Models.ITForm.ItNguoiHoTro>)ViewBag.ListNguoiHoTro)
                                        {
                                            <option value="@it.MaNv">@it.Ten (@it.MaNv)</option>
                                        }
                                    }
                                </select>

                                <button id="btnConfirmSupport" class="mobile-btn-action"
                                        onclick="changeSupporter()"
                                        style="background: #ea580c; color: white; border: none; padding: 0 35px; border-radius: 12px; font-weight: 800; cursor: pointer; transition: all 0.2s; font-size: 15px; display: flex; align-items: center; justify-content: center; min-height: 48px;"
                                        onmouseover="this.style.background='#c2410c'; this.style.transform='translateY(-1px)'"
                                        onmouseout="this.style.background='#ea580c'; this.style.transform='none'">
                                    <span id="textBtn">XÁC NHẬN</span>
                                    <i id="loadingIcon" class="fa fa-spinner fa-spin" style="display: none; margin-left: 8px;"></i>
                                </button>
                            </div>

                            <small style="color: #c2410c; display: block; margin-top: 10px; font-style: italic; font-weight: 500;">
                                * Lưu ý: Chỉ tài khoản có quyền <b>AdminIT</b> hoặc <b>All</b> mới có thể thực hiện thao tác này.
                            </small>
                        </div>
                    }

                    <div id="historyOverlay" onclick="toggleZoomHistory()" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9998; backdrop-filter: blur(3px);"></div>

                    <div class="mobile-history-toggle" onclick="toggleHistoryMobile()" style="margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between;">
                        <h3 style="margin: 0; color: #1e293b; font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 10px;">
                            <i class="fa fa-history"></i> NHẬT KÝ THAO TÁC
                        </h3>
                        <span id="historyToggleIconMobile" style="display: none; color: #1e40af; font-size: 18px; background: #eff6ff; padding: 8px 12px; border-radius: 12px;"><i class="fa fa-chevron-down"></i> XEM LỊCH SỬ</span>
                    </div>

                    <div id="historyContainer" class="mobile-history-content" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 28px; padding: 0; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; z-index: 1; overflow: hidden;">

                        <div style="padding: 15px 25px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: flex-end; background: #fafafa;">
                            <button type="button" onclick="toggleZoomHistory()" id="btnZoomHistory" style="background: #ffffff; border: 1px solid #e2e8f0; width: 35px; height: 35px; border-radius: 10px; color: #64748b; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-expand" id="historyZoomIcon"></i>
                            </button>
                        </div>

                        <div id="historyScrollList" style="max-height: 400px; overflow-y: auto; padding: 30px; scrollbar-width: thin; background: #ffffff;">
                            <div style="margin-left: 10px; border-left: 2px dashed #e2e8f0; padding-left: 30px;">
                                @if (Model.LichSuFormIts != null && Model.LichSuFormIts.Any())
                                {
                                    foreach (var ls in Model.LichSuFormIts.OrderByDescending(x => x.Time))
                                    {
                                        <div style="position: relative; margin-bottom: 30px;">
                                            <div style="position: absolute; left: -41px; top: 0; width: 20px; height: 20px; background: white; border: 4px solid #3b82f6; border-radius: 50%; z-index: 1;"></div>
                                            <div style="display: flex; justify-content: space-between; flex-wrap: wrap; background: #f8fafc; padding: 20px; border-radius: 20px; border: 1px solid #f1f5f9;">
                                                <div style="flex: 1; min-width: 200px;">
                                                    <div style="font-weight: 800; color: #1e293b; font-size: 15px; margin-bottom: 4px;">@ls.TieuDe</div>
                                                    <div style="color: #64748b; font-size: 14px; line-height: 1.6; white-space: pre-line;">@ls.Mota</div>
                                                </div>
                                                <div style="text-align: right; min-width: 100px; margin-left: 15px; flex-shrink: 0;">
                                                    <div style="font-weight: 800; color: #3b82f6; font-size: 14px;">@ls.Time?.ToString("HH:mm")</div>
                                                    <div style="color: #94a3b8; font-size: 12px; margin-top: 2px;">@ls.Time?.ToString("dd/MM/yyyy")</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="text-align: center; color: #94a3b8; padding: 20px;">Chưa có nhật ký thao tác.</div>
                                }
                            </div>
                        </div>
                    </div>

                    <style>
                                            .history-zoom-active {
                                                position: fixed !important;
                                                top: 50% !important;
                                                left: 50% !important;
                                                transform: translate(-50%, -50%) !important;
                                                width: 75vw !important;
                                                height: 80vh !important;
                                                z-index: 9999 !important;
                                                margin: 0 !important;
                                                border-radius: 28px !important;
                                                display: flex !important;
                                                flex-direction: column !important;
                                            }

                                                .history-zoom-active #historyScrollList {
                                                    max-height: none !important;
                                                    flex: 1 !important;
                                                }
                    </style>
                </div>

                @* --- CỘT PHẢI: TIẾN TRÌNH XỬ LÝ & ĐÍNH KÈM & PHÊ DUYỆT BP LIÊN ĐỚI (FORM 8) --- *@
                <div>
                    @if (listImages.Count > 0)
                    {
                        <h3 style="margin-bottom: 20px; color: #0f172a; font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-image"></i> HÌNH ẢNH ĐÍNH KÈM
                        </h3>
                        foreach (var img in listImages)
                        {
                            <div style="border: 2px solid #f1f5f9; border-radius: 24px; overflow: hidden; margin-bottom: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); background: #f8fafc; transition: all 0.3s ease;">
                                <img src="@img" style="width: 100%; cursor: zoom-in; display: block; object-fit: cover; max-height: 300px;" onclick="openZoom(this.src)" />
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(fileUrl))
                    {
                        <div style="background: #f0f9ff; border: 2px solid #bae6fd; padding: 16px 20px; border-radius: 20px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); max-width: 100%; box-sizing: border-box; gap: 12px; flex-wrap: wrap;">
                            <div style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0;">
                                <i class="fa fa-file-pdf" style="font-size: 22px; color: #0369a1; flex-shrink: 0;"></i>
                                <span style="font-size: 14px; font-weight: 800; color: #0369a1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@fileName</span>
                            </div>
                            <div style="display: flex; gap: 8px; flex-shrink: 0; width: 100%; justify-content: flex-end;">
                                <a href="@fileUrl" target="_blank" style="background: white; color: #0369a1; border: 1.5px solid #0369a1; padding: 9px 18px; border-radius: 12px; font-weight: 800; text-decoration: none; font-size: 13px; text-align: center; transition: 0.2s;" onmouseover="this.style.background='#e0f2fe'" onmouseout="this.style.background='white'">XEM</a>
                                <a href="@fileUrl" download style="background: #0369a1; color: white; padding: 10px 22px; border-radius: 12px; font-weight: 800; text-decoration: none; font-size: 13px; text-align: center; box-shadow: 0 4px 10px rgba(3, 105, 161, 0.3);" onmouseover="this.style.background='#075985'" onmouseout="this.style.background='#0369a1'">TẢI VỀ</a>
                            </div>
                        </div>
                    }

                    <div style="background: #ffffff; padding: 30px; border-radius: 28px; border: 1px solid #e2e8f0; margin-bottom: 35px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.04);">
                        <h4 style="margin: 0 0 25px 0; font-size: 15px; font-weight: 900; color: #475569; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-tasks"></i> TIẾN TRÌNH XỬ LÝ
                        </h4>
                        <div id="khungTienTrinhDon" style="position: relative; padding-left: 30px; border-left: 2px solid #f1f5f9;">
                            <div style="margin-bottom: 25px; position: relative;">
                                <div style="position: absolute; left: -37px; top: 0; width: 14px; height: 14px; border-radius: 50%; background: #059669; border: 3px solid white; box-shadow: 0 0 0 2px #059669;"></div>
                                <div style="font-weight: 800; font-size: 15px; color: #1e293b;">Người tạo: @Model.TenNguoiTao</div>
                                <div style="font-size: 13px; color: #64748b; margin-top: 4px;">@Model.TimeNguoiTao?.ToString("HH:mm dd/MM/yyyy")</div>
                            </div>
                            <div style="margin-bottom: 25px; position: relative;">
                                <div style="position: absolute; left: -37px; top: 0; width: 14px; height: 14px; border-radius: 50%; background: @(isApprovedByManager ? "#d97706" : "#cbd5e1"); border: 3px solid white; box-shadow: 0 0 0 2px @(isApprovedByManager ? "#d97706" : "#cbd5e1");"></div>
                                <div style="font-weight: 800; font-size: 15px; color: #1e293b;">Quản lý: @(Model.TenNguoiDuyet ?? "---")</div>
                                <div style="font-size: 13px; color: #64748b; margin-top: 4px;">
                                    @(Model.TimeNguoiDuyet?.ToString("HH:mm dd/MM/yyyy") ?? "Đang chờ duyệt...")
                                    @if (Model.TimeNguoiDuyet == null && User.IsInRole("All"))
                                    {
                                        <button type="button" class="js-xem-nguoi-duyet" data-id="@Model.Id" title="Xem người có thể duyệt"
                                                style="background: none; border: none; padding: 0 4px; cursor: pointer; color: #0369a1; font-size: 14px;">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    }
                                </div>
                                <div id="dsNguoiCoTheDuyet" style="display: none; margin-top: 8px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 13px; color: #334155;"></div>
                            </div>

                            @* HIỂN THỊ ĐỘNG BLOCK TIẾN TRÌNH XÁC NHẬN BỘ PHẬN ĐƠN 8 *@
                            @if (Model.IdForm == "IT_CapQuyenOChung_8" && xacNhanDon8 != null)
                            {
                                bool coXacNhan = !string.IsNullOrEmpty(xacNhanDon8.TrangThai);
                                <div style="margin-bottom: 25px; position: relative; padding: 14px; background: #faf5ff; border-radius: 14px; border: 1px dashed #d8b4fe;">
                                    <div style="position: absolute; left: -49px; top: 15px; width: 14px; height: 14px; border-radius: 50%; background: @(coXacNhan ? "#8b5cf6" : "#cbd5e1"); border: 3px solid white; box-shadow: 0 0 0 2px @(coXacNhan ? "#8b5cf6" : "#cbd5e1");"></div>
                                    <div style="font-weight: 800; font-size: 14px; color: #4c1d95;"><i class="fa fa-shield"></i> BP Xác nhận: <span style="font-size:12px; color:#6d28d9;">@xacNhanDon8.BoPhan</span></div>
                                    <div style="font-weight: 700; font-size: 13px; margin-top:4px; color: #1e293b;">Người duyệt: @(xacNhanDon8.TenNguoiXacNhan ?? "---") (@(xacNhanDon8.TrangThai ?? "Chờ xác nhận"))</div>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">@(xacNhanDon8.TimeXacNhan?.ToString("HH:mm dd/MM/yyyy") ?? "Đang chờ quản lý bộ phận phản hồi...")</div>
                                    @if (!string.IsNullOrEmpty(xacNhanDon8.GhiChu))
                                    {
                                        <div style="font-size:12px; color:#7c3aed; background:white; padding:6px; border-radius:6px; margin-top:4px; border:1px solid #f3e8ff;">📝 Lý do: @xacNhanDon8.GhiChu</div>
                                    }
                                </div>
                            }

                            <div style="position: relative;">
                                <div style="position: absolute; left: -37px; top: 0; width: 14px; height: 14px; border-radius: 50%; background: @(isFinished ? "#1e40af" : "#cbd5e1"); border: 3px solid white; box-shadow: 0 0 0 2px @(isFinished ? "#1e40af" : "#cbd5e1");"></div>
                                <div style="font-weight: 800; font-size: 15px; color: #1e293b;">IT Xử lý: @(Model.TenAdmin ?? "---")</div>
                                <div style="font-size: 13px; color: #64748b; margin-top: 4px;">@(Model.TimeAdmin?.ToString("HH:mm dd/MM/yyyy") ?? "Đang xử lý...")</div>
                            </div>
                        </div>
                    </div>

                    @if (!isCancelled && !isFinished)
                    {
                        <div id="khungNutXuLyDon" style="display: flex; flex-direction: column; gap: 15px; margin-top: 25px;">
                            @if (!isApprovedByManager && (User.IsInRole("All") || isDirectDepartmentManager))
                            {
                                <button id="btnDuyet"
                                        onclick="handleAction('Duyet')"
                                        style="background: #059669; color: white; border: none; padding: 20px; border-radius: 18px; font-weight: 900; cursor: pointer; font-size: 16px; box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.3); transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 10px;"
                                        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 15px 20px -5px rgba(5, 150, 105, 0.4)'"
                                        onmouseout="this.style.transform=''; this.style.boxShadow='0 10px 15px -3px rgba(5, 150, 105, 0.3)'">
                                    <i class="fa fa-check-circle" style="font-size: 20px;"></i> DUYỆT ĐƠN (QUẢN LÝ TRỰC TIẾP)
                                </button>
                            }

                            @* BLOCK GIAO DIỆN PHÊ DUYỆT CHO QUẢN LÝ BỘ PHẬN ĐƯỢC GẮN XÁC NHẬN ĐƠN 8 *@
                            @if (isApprovedByManager && Model.IdForm == "IT_CapQuyenOChung_8" && isTargetManagerDon8 && xacNhanDon8 != null && string.IsNullOrEmpty(xacNhanDon8.TrangThai))
                            {
                                <div style="background: #fdf4ff; border: 2px solid #f0abfc; padding: 20px; border-radius: 22px; box-shadow: 0 4px 12px rgba(217, 70, 239, 0.05);">
                                    <h5 style="margin:0 0 12px 0; color:#86198f; font-weight:900; font-size:14px; text-transform:uppercase;"><i class="fa fa-shield"></i> PHÊ DUYỆT BỘ PHẬN LIÊN ĐỚI</h5>
                                    <textarea id="txtGhiChuDon8" placeholder="Nhập ghi chủ phản hồi hoặc lý do từ chối tại đây..." style="width: 100%; padding: 10px; border: 1px solid #e9d5ff; border-radius: 10px; font-size: 13px; min-height:60px; outline:none; margin-bottom:12px; box-sizing:border-box;"></textarea>
                                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                                        <button onclick="xuLyXacNhanDon8('Duyet')" style="background:#a855f7; color:white; border:none; padding:12px; border-radius:10px; font-weight:800; font-size:13px; cursor:pointer;"><i class="fa fa-check"></i> XÁC NHẬN CHO PHÉP</button>
                                        <button onclick="xuLyXacNhanDon8('TuChoi')" style="background:white; color:#c084fc; border:1.5px solid #c084fc; padding:12px; border-radius:10px; font-weight:800; font-size:13px; cursor:pointer;"><i class="fa fa-times"></i> TỪ CHỐI</button>
                                    </div>
                                </div>
                            }

                            @if (isApprovedByManager && (User.IsInRole("All") || User.IsInRole("AdminIT")))
                            {
                                <button id="btnHoanThanh"
                                        onclick="handleXacNhanHoanThanh()"
                                        style="background: #1e40af; color: white; border: none; padding: 20px; border-radius: 18px; font-weight: 900; cursor: pointer; font-size: 16px; box-shadow: 0 10px 15px -3px rgba(30, 64, 175, 0.3); transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 10px;"
                                        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 15px 20px -5px rgba(30, 64, 175, 0.4)'"
                                        onmouseout="this.style.transform=''; this.style.boxShadow='0 10px 15px -3px rgba(30, 64, 175, 0.3)'">
                                    <i class="fa fa-star" style="font-size: 20px;"></i> XÁC NHẬN HOÀN TẤT (IT)
                                </button>
                            }

                            @* Đơn do Hệ thống E-form tự duyệt nhưng IT thấy vẫn cần quản lý bộ phận đồng ý *@
                            @if (ViewBag.CoTheYeuCauQuanLy == true)
                            {
                                <div id="khungYeuCauQuanLy" data-id-don="@Model.Id" style="background: #fffbeb; border: 2px solid #fcd34d; padding: 18px; border-radius: 18px;">
                                    <button type="button" id="btnYeuCauQuanLy" style="width: 100%; background: #d97706; color: white; border: none; padding: 16px; border-radius: 14px; font-weight: 900; cursor: pointer; font-size: 15px; display: flex; align-items: center; justify-content: center; gap: 10px;">
                                        <i class="fa fa-user-check" style="font-size: 18px;"></i> YÊU CẦU QUẢN LÝ XÁC NHẬN
                                    </button>
                                    <div id="oNhapYeuCauQuanLy" hidden style="margin-top: 12px;">
                                        <textarea id="txtLyDoYeuCauQuanLy" maxlength="500" placeholder="Lý do cần quản lý bộ phận xác nhận..." style="width: 100%; padding: 10px; border: 1px solid #fcd34d; border-radius: 10px; font-size: 14px; min-height: 70px; outline: none; box-sizing: border-box;"></textarea>
                                        <div id="baoLoiYeuCauQuanLy" hidden style="color: #b91c1c; font-size: 13px; font-weight: 700; margin-top: 6px;"></div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                                            <button type="button" id="btnGuiYeuCauQuanLy" style="background: #d97706; color: white; border: none; padding: 12px; border-radius: 10px; font-weight: 800; font-size: 13px; cursor: pointer;"><i class="fa fa-paper-plane"></i> GỬI CHO QUẢN LÝ</button>
                                            <button type="button" id="btnBoYeuCauQuanLy" style="background: white; color: #92400e; border: 1.5px solid #d97706; padding: 12px; border-radius: 10px; font-weight: 800; font-size: 13px; cursor: pointer;">BỎ QUA</button>
                                        </div>
                                    </div>
