    </div>
</div>

<script>
    // ==========================================
    // 1. KHAI BÁO BIẾN CƠ BẢN & TRẠNG THÁI
    // ==========================================
    const formId = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Id))');
    const currentUserId = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CurrentUserId))');
    const formCreatorId = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.IdNguoiTao))');
    const userRoles = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(r => r.Value).ToList()))');

    let currentSkipComment = 0; const takeComment = 20; let hasMoreComments = true; let isLoadingComments = false; let totalComments = 0; let soSaoChon = 0; let isSubmitting = false;

    function hasRole(roleName) { return userRoles.includes(roleName); }

    function escapeHtml(str) { if (!str) return ''; return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

    async function apiPost(url, body, btnIds) {
        if (btnIds) btnIds.forEach(id => { const b = document.getElementById(id); if (b) b.disabled = true; });
        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value },
                body: JSON.stringify(body)
            });
            const data = await response.json();
            if (data.success) { alert(data.message || "Thao tác thành công!"); location.reload(); }
            else { alert(data.message || "Thao tác thất bại"); if (btnIds) btnIds.forEach(id => { const b = document.getElementById(id); if (b) b.disabled = false; }); }
        } catch (err) { alert("Lỗi kết nối máy chủ."); if (btnIds) btnIds.forEach(id => { const b = document.getElementById(id); if (b) b.disabled = false; }); }
    }

    async function xuLyXacNhanDon8(actionType) {
        const ghiChu = document.getElementById('txtGhiChuDon8')?.value.trim() || '';
        if (actionType === 'TuChoi' && !ghiChu) {
            alert("⚠️ Vui lòng nhập lý do từ chối vào ô ghi chú!");
            return;
        }
        const confirmMsg = actionType === 'Duyet' ? "Xác nhận duyệt cho phép cấp quyền thư mục chung này?" : "Xác nhận từ chối cấp quyền?";
        if (confirm(confirmMsg)) {
            try {
                const response = await fetch('/FormIT/XacNhanDon8', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `idFormIt=${formId}&status=${actionType}&ghiChu=${encodeURIComponent(ghiChu)}&__RequestVerificationToken=${document.querySelector('input[name="__RequestVerificationToken"]')?.value}`
                });
                const data = await response.json();
                if (data.success) { alert(data.message); location.reload(); }
                else { alert(data.message); }
            } catch (err) { alert("Lỗi kết nối hệ thống."); }
        }
    }

    function toggleHistoryMobile() {
        if (window.innerWidth <= 768) {
            const content = document.getElementById('historyContainer'); const iconSpan = document.getElementById('historyToggleIconMobile');
            if (content.classList.contains('show')) { content.classList.remove('show'); iconSpan.innerHTML = '<i class="fa fa-chevron-down"></i> XEM LỊCH SỬ'; }
            else { content.classList.add('show'); iconSpan.innerHTML = '<i class="fa fa-chevron-up"></i> ĐÓNG LẠI'; }
        }
    }

    function toggleZoom() {
        const container = document.getElementById('commentContainer'); const overlay = document.getElementById('commentOverlay'); const icon = document.getElementById('zoomIcon');
        const isFull = container.classList.toggle('comment-zoom-active');
        if (overlay) overlay.style.display = isFull ? 'block' : 'none';
        if (icon) { if (isFull) icon.classList.replace('fa-expand', 'fa-compress'); else icon.classList.replace('fa-compress', 'fa-expand'); }
    }

    function toggleZoomHistory() {
        const container = document.getElementById('historyContainer'); const overlay = document.getElementById('historyOverlay'); const icon = document.getElementById('historyZoomIcon');
        const isFull = container.classList.toggle('history-zoom-active');
        if (overlay) overlay.style.display = isFull ? 'block' : 'none';
        if (icon) { if (isFull) icon.classList.replace('fa-expand', 'fa-compress'); else icon.classList.replace('fa-compress', 'fa-expand'); }
    }

    let currentImgRotation = 0;
    function openZoom(src) { currentImgRotation = 0; const fullImg = document.getElementById('fullImage'); const overlay = document.getElementById('imageOverlay'); if (fullImg && overlay) { fullImg.src = src; fullImg.style.transform = `scale(1) rotate(0deg)`; overlay.style.display = 'flex'; } }
    function closeZoom(e) { if (e && e.target.id !== 'imageOverlay') return; closeZoomForce(); }
    function closeZoomForce() { const overlay = document.getElementById('imageOverlay'); if (overlay) overlay.style.display = 'none'; }
    function rotateImage(deg) { currentImgRotation += deg; const fullImg = document.getElementById('fullImage'); if (fullImg) fullImg.style.transform = `scale(1) rotate(${currentImgRotation}deg)`; }

    document.addEventListener('keydown', function(e) {
        if (e.key === "Escape") {
            if (document.getElementById('imageOverlay')?.style.display === 'flex') closeZoomForce();
            else if (document.getElementById('commentContainer')?.classList.contains('comment-zoom-active')) toggleZoom();
            else if (document.getElementById('historyContainer')?.classList.contains('history-zoom-active')) toggleZoomHistory();
        }
    });

    async function taiBinhLuan(isLoadMore = false) {
        if (isLoadingComments) return; isLoadingComments = true;
        try {
            const res = await fetch(`/FormIT/LayBinhLuan/${formId}?skip=${currentSkipComment}&take=${takeComment}`);
            const data = await res.json();
            if (data.success) {
                const commentList = document.getElementById('commentList'); if (!commentList) return;
                if (!isLoadMore) { commentList.innerHTML = ''; currentSkipComment = 0; totalComments = 0; }
                if (!data.data || data.data.length === 0) {
                    if (!isLoadMore) commentList.innerHTML = '<div id="noCommentMsg" style="text-align: center; color: #94a3b8; padding: 40px;"><p>Chưa có bình luận nào.</p></div>';
                    hasMoreComments = false;
                } else {
                    document.getElementById('noCommentMsg')?.remove();
                    data.data.forEach(bl => {
                        const temp = document.createElement('div'); temp.innerHTML = renderComment(bl);
                        if (isLoadMore) commentList.prepend(temp.firstElementChild); else commentList.appendChild(temp.firstElementChild);
                        totalComments++;
                    });
                    currentSkipComment += data.data.length;
                    if (data.data.length < takeComment) hasMoreComments = false;
                    if (!isLoadMore) setTimeout(() => { commentList.scrollTop = commentList.scrollHeight; }, 100);
                }
                updateCommentCount();
            }
        } catch (err) { console.error(err); } finally { isLoadingComments = false; }
    }

    function renderComment(bl) {
        const isOwn = currentUserId === String(bl.idNguoiBinhLuan); const commentTime = new Date(bl.thoiGian).getTime(); const now = new Date().getTime(); const isExpired = (now - commentTime) > (2 * 60 * 60 * 1000);
        const canDelete = (isOwn && !isExpired) || hasRole('All') || hasRole('AdminIT');
        let fileHtml = '';
        if (bl.fileDinhKem) {
            const originalName = bl.fileDinhKem.split('_').slice(2).join('_') || bl.fileDinhKem;
            const ext = bl.fileDinhKem.split('.').pop().toLowerCase();
            if(['jpg','jpeg','png','gif'].includes(ext)) { fileHtml = `<div style="margin-top:8px;"><img src="/FormIT/DownloadBinhLuanFile/${encodeURIComponent(bl.fileDinhKem)}" onclick="openZoom(this.src)" style="max-width:200px; border-radius:8px; cursor:zoom-in;"/></div>`; }
            else { fileHtml = `<div style="margin-top: 10px; padding: 10px; background: #f1f5f9; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px;"><i class="fa fa-paperclip"></i><a href="/FormIT/DownloadBinhLuanFile/${encodeURIComponent(bl.fileDinhKem)}" download style="color: #3b82f6; font-weight: 600; text-decoration: none;">${escapeHtml(originalName)}</a></div>`; }
        }
        return `<div class="comment-item" style="margin-bottom: 20px; display: flex; gap: 12px; ${isOwn ? 'flex-direction: row-reverse;' : ''}" data-comment-id="${bl.id}"><div style="width: 40px; height: 40px; border-radius: 50%; background: ${isOwn ? '#3b82f6' : '#64748b'}; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; flex-shrink: 0;">${(bl.tenNguoiBinhLuan || 'U').charAt(0).toUpperCase()}</div><div style="flex: 1; ${isOwn ? 'text-align: right;' : ''}"><div style="display: inline-block; text-align: left; max-width: 85%;"><div style="display: flex; flex-direction: column; margin-bottom: 4px; ${isOwn ? 'align-items: flex-end;' : 'align-items: flex-start;'}"><div style="display: flex; align-items: center; gap: 8px; ${isOwn ? 'flex-direction: row-reverse;' : ''}"><span style="font-weight: 700; font-size: 13px;">${escapeHtml(bl.tenNguoiBinhLuan)}</span><span style="font-size: 11px; color: #94a3b8;">${new Date(bl.thoiGian).toLocaleString('vi-VN')}</span>${canDelete ? `<i class="fa fa-trash" onclick="xoaBinhLuan(${bl.id})" style="color: #ef4444; cursor: pointer; margin: 0 5px;"></i>` : ''}</div></div><div style="background: ${isOwn ? '#eff6ff' : '#f8fafc'}; padding: 12px; border-radius: ${isOwn ? '16px 2px 16px 16px' : '2px 16px 16px 16px'}; border: 1px solid #e2e8f0;"><div style="font-size: 14px; white-space: pre-wrap;">${escapeHtml(bl.noiDung)}</div>${fileHtml}</div></div></div></div>`;
    }

    async function guiBinhLuan(e) {
        if(e) e.preventDefault(); if (isSubmitting) return;
        const noiDung = document.getElementById('txtBinhLuan').value.trim(); const fileInp = document.getElementById('fileBinhLuan');
        if (!noiDung && !fileInp.files[0]) return alert('Vui lòng nhập nội dung!');
        const formData = new FormData(); formData.append('idForm', formId); formData.append('noiDung', noiDung); if (fileInp.files[0]) formData.append('file', fileInp.files[0]);
        isSubmitting = true; document.getElementById('btnGuiBinhLuan').disabled = true;
        try {
            const res = await fetch('/FormIT/ThemBinhLuan', { method: 'POST', body: formData }); const data = await res.json();
            if (data.success) { document.getElementById('commentList').insertAdjacentHTML('beforeend', renderComment(data.data)); document.getElementById('formBinhLuan').reset(); document.getElementById('fileLabel').textContent = 'Đính kèm file (max 50MB)'; totalComments++; updateCommentCount(); }
        } catch (err) { alert('Lỗi gửi'); } finally { isSubmitting = false; document.getElementById('btnGuiBinhLuan').disabled = false; }
    }

    async function xoaBinhLuan(id) { if (!confirm('Xóa bình luận?')) return; try { const res = await fetch('/FormIT/XoaBinhLuan', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) }); const data = await res.json(); if (data.success) { document.querySelector(`[data-comment-id="${id}"]`)?.remove(); totalComments--; updateCommentCount(); } } catch (err) { alert('Lỗi'); } }

    function updateFileLabel(input) { const label = document.getElementById('fileLabel'); if (input.files[0]) { const sizeMB = (input.files[0].size / 1048576).toFixed(2); if(sizeMB > 50) { alert("Tối đa 50MB"); input.value = ""; return; } label.textContent = input.files[0].name; } }

    function updateCommentCount() { const el = document.getElementById('commentCount'); if (el) el.textContent = totalComments; }

    function handleAction(type) {
        let reason = null; if (type === 'Huy') { reason = prompt("Lý do hủy:"); if (!reason) return; }
        if (confirm(`Xác nhận thao tác?`)) apiPost('/FormIT/XuLyDon', { id: formId, action: type, reason: reason }, ['btnDuyet', 'btnHuy']);
    }

    function handleXacNhanHoanThanh() { if (confirm("Xác nhận hoàn tất?")) apiPost('/FormIT/XacNhanHoanThanh', { id: formId }, ['btnHoanThanh']); }

    function handleChuaHoanThanh() { let reason = prompt("Lý do:"); if (!reason) return; apiPost('/FormIT/XacNhanChuaHoanThanh', { id: formId, reason: reason }, ['btnChuaHoanThanh']); }

    function changeSupporter() { const select = document.getElementById('selectIT'); const maNv = select?.value; if (!maNv) return alert("Chọn người hỗ trợ!"); if (confirm("Xác nhận chỉ định?")) apiPost('/FormIT/ThemNguoiHoTro', { idFormIt: formId, maNv: maNv }); }

    // --- MỚI/SỬA ĐỔI: LOGIC ĐÁNH GIÁ SAO VÀ HÀM PHẢN HỒI GIAO DIỆN ---
    function chonSao(sao) {
        soSaoChon = sao;
        capNhatGiaoDienSao();
        const btnGui = document.getElementById('btnGuiDanhGia');
        if (btnGui) { btnGui.disabled = false; btnGui.style.opacity = '1'; btnGui.style.cursor = 'pointer'; }
    }

    function hoverSao(sao) {
        for (let i = 1; i <= 5; i++) {
            const star = document.getElementById('star' + i);
            if (star) {
                star.style.color = i <= sao ? '#f59e0b' : '#9ca3af';
                star.style.transform = i <= sao ? 'scale(1.15)' : '';
            }
        }
    }

    function resetHover() { capNhatGiaoDienSao(); }

    function capNhatGiaoDienSao() {
        for (let i = 1; i <= 5; i++) {
            const star = document.getElementById('star' + i);
            if (!star) continue;
            star.style.background = i <= soSaoChon ? 'linear-gradient(135deg, #fef3c7 0%, #fde68a 100%)' : 'white';
            star.style.color = i <= soSaoChon ? '#f59e0b' : '#9ca3af';
            star.style.borderColor = i <= soSaoChon ? '#f59e0b' : '#d1d5db';
        }
    }

    // ĐÃ BỔ SUNG: Khai báo lại hàm xử lý gửi dữ liệu đánh giá lên Controller bằng Ajax
    function handleDanhGia() {
        if (soSaoChon === 0) {
            alert("Vui lòng chọn mức độ hài lòng bằng số sao!");
            return;
        }
        const nhanXet = document.getElementById('txtNhanXet')?.value.trim() || '';
        if (confirm(`Xác nhận gửi đánh giá mức độ ${soSaoChon} sao?`)) {
            apiPost('/FormIT/DanhGiaFormItsDon', {
                id: formId,
                mucDo: soSaoChon,
                nhanXet: nhanXet
            }, ['btnGuiDanhGia']);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('formBinhLuan')?.addEventListener('submit', guiBinhLuan);
        // Dán/kéo-thả ảnh vào khung bình luận: xem wwwroot/js/formit-binhluan-dan-anh.js

        taiBinhLuan(false);
        document.getElementById('commentList')?.addEventListener('scroll', function() {
            if (this.scrollTop <= 5 && hasMoreComments && !isLoadingComments) {
                const oldHeight = this.scrollHeight; taiBinhLuan(true).then(() => { this.scrollTop = this.scrollHeight - oldHeight; });
            }
        });
    });
</script>
<script src="~/js/formit-chitiet-doi-donvi.js?v=202610241315"></script>
<script src="~/js/formit-binhluan-dan-anh.js?v=20260917"></script>
<script src="~/js/formit-nguoi-co-the-duyet.js?v=20261001"></script>
<script src="~/js/formit-yeu-cau-quan-ly.js?v=20261104"></script>
<script src="~/js/cuon-toi-binh-luan.js?v=20261110"></script>
@if (Model?.ItDangKiSuDungWifi3s?.Any() == true && User.IsInRole("All"))
{
    <link rel="stylesheet" href="~/css/formit-sua-ma-thiet-bi.css?v=20261105" />
    <script src="~/js/formit-sua-ma-thiet-bi.js?v=20261105"></script>
}

@if (Model?.ItDangKiSuDungWifi3s?.Any() == true && E_Form_Best.Areas.ITForm.Controllers.WifiMacController.CoQuyen(User) && WlcMac.CoCauHinh(Model.TenCongTy))
{
    <div id="modalThemMacWlc" class="them-mac-wlc-nen" hidden data-id-form="@Model.Id" data-la-all="@(User.IsInRole("All") ? "1" : "0")">
        <div class="them-mac-wlc-cum">
        <form id="formThemMacWlc" class="them-mac-wlc-hop" autocomplete="off">
            @* MAC filter trên WLC chỉ dùng cho mạng nhân viên (profile MAC-Staff) → ghi tên mạng cho người đọc dễ hiểu *@
            <h3>➕ Thêm MAC cho mạng @(Model.TenCongTy)-Staff</h3>
            <div class="them-mac-wlc-ds">WLC: @string.Join(" · ", WlcMac.DsWlc(Model.TenCongTy).Select(w => w.Ten)) — thêm riêng từng con bằng nút bên dưới</div>
            <div class="them-mac-wlc-dong"><span>MAC</span><b id="themMacWlcMac"></b></div>
            <label>WLAN profile
                <select id="themMacWlcHoSo" required>
                    @foreach (var h in WlcMac.DsHoSo(Model.TenCongTy))
                    {
                        <option value="@h.Ma">@h.WlanProfile (@h.AaaList)</option>
                    }
                </select>
            </label>
            <label>Mô tả (description)
                <input id="themMacWlcMoTa" type="text" maxlength="60" placeholder="vd WHSophie">
                <small>Tự bỏ dấu; chỉ giữ chữ, số, . _ - ; khoảng trắng thành _</small>
            </label>
            <label>Tài khoản domain
                <input id="themMacWlcTaiKhoan" type="text" maxlength="64" autocomplete="off" spellcheck="false" required placeholder="vd @(User.FindFirst("MaNv")?.Value)">
            </label>
            <label>Mật khẩu domain
                <input id="themMacWlcMatKhau" type="password" autocomplete="new-password" required>
                <small>Chỉ dùng để SSH vào WLC lần này, không lưu.</small>
            </label>
            <div id="themMacWlcKetQua" class="them-mac-wlc-kq" hidden></div>
            <div id="themMacWlcLoi" class="them-mac-wlc-loi" hidden></div>
            <div class="them-mac-wlc-nut">
                <button type="button" id="btnHuyThemMacWlc">Đóng</button>
                <button type="button" id="btnKiemTraMacWlc">Kiểm tra</button>
                @foreach (var w in WlcMac.DsWlc(Model.TenCongTy))
                {
                    @* Nhãn nút bỏ IP cho gọn (tên mặc định "WLC 9800 10.0.63.210" có kèm IP); data-wlc giữ tên đầy đủ cho thông báo *@
                    <button type="button" class="btn-gui-them-mac-wlc" data-ip="@w.Ip" data-wlc="@w.Ten" title="@w.Ten">Thêm lên @w.Ten.Replace(w.Ip, "").Trim()</button>
                }
            </div>
        </form>
        @if (RadiusMac.CoCauHinh(Model.TenCongTy))
        {
            @* PDA / TV xác thực MAC qua RADIUS, không qua WLC: form riêng, không cần tài khoản domain *@
            <form id="formThemMacRadius" class="them-mac-wlc-hop them-mac-radius" autocomplete="off">
                <h3>📟 Thêm MAC cho PDA / TV (RADIUS)</h3>
                <div class="them-mac-wlc-ds">DaloRADIUS — tách riêng với WLC, thêm cả 2 dạng MAC (có / không dấu :)</div>
                <div class="them-mac-wlc-dong"><span>MAC</span><b id="themMacRadiusMac"></b></div>
                <label>Loại thiết bị
                    <select id="themMacRadiusNhom" required>
                        @foreach (var n in RadiusMac.DsNhom(Model.TenCongTy))
                        {
                            <option value="@n.Ma">@n.LoaiThietBi (group @n.Group)</option>
                        }
                    </select>
                </label>
                <label>Mô tả (firstname trên RADIUS)
                    <input id="themMacRadiusMoTa" type="text" maxlength="60" placeholder="vd WHSophie">
                    <small>Tự bỏ dấu như mô tả WLC</small>
                </label>
                <label>Tài khoản domain
                    <input id="themMacRadiusTaiKhoan" type="text" maxlength="64" autocomplete="off" spellcheck="false" required placeholder="vd @(User.FindFirst("MaNv")?.Value)">
                </label>
                <label>Mật khẩu domain
                    <input id="themMacRadiusMatKhau" type="password" autocomplete="new-password" required>
                    <small>Chỉ dùng để xác thực người làm lần này, không lưu.</small>
                </label>
                <div id="themMacRadiusKetQua" class="them-mac-wlc-kq" hidden></div>
                <div id="themMacRadiusLoi" class="them-mac-wlc-loi" hidden></div>
                <div class="them-mac-wlc-nut">
                    <button type="button" id="btnKiemTraMacRadius">Kiểm tra</button>
                    <button type="button" id="btnGuiThemMacRadius">Thêm lên RADIUS</button>
                </div>
            </form>
        }
        @* Bảng MAC trên WLC lặp lại bên phải modal để IT xem cả đơn khi thêm; JS vẽ chung với bảng dưới bình luận *@
        <div class="bang-mac-wlc bang-mac-wlc-modal">
            <h4><i class="fa fa-wifi"></i> MAC TRÊN WLC <small id="bangMacWlcModalQuet"></small></h4>
            <div class="bang-mac-wlc-cuon">
                <table>
                    <thead>
                        <tr>
                            <th>Thiết bị / MAC</th>
                            @foreach (var w in WlcMac.DsWlc(Model.TenCongTy))
                            {
                                <th data-ip="@w.Ip">@w.Ten</th>
                            }
                            @if (RadiusMac.CoCauHinh(Model.TenCongTy))
                            {
                                <th class="cot-radius" title="Theo lịch sử đơn (app RADIUS không tra cứu được)">RADIUS (PDA/TV)</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="bangMacWlcModalThan"></tbody>
                </table>
            </div>
        </div>
        </div>
    </div>
    <link rel="stylesheet" href="~/css/formit-them-mac-wlc.css?v=20261103b" />
    <script src="~/js/formit-them-mac-wlc.js?v=20261105"></script>
}
