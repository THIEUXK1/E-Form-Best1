    <div id="imageOverlay" onclick="closeZoom(event)" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15, 23, 42, 0.95); z-index:9999; justify-content:center; align-items:center; backdrop-filter: blur(8px);">
        <div style="position: absolute; top: 20px; right: 20px; display: flex; gap: 15px; z-index: 10000; flex-wrap: wrap;" onclick="event.stopPropagation()">
            <button onclick="rotateImage(-90)" style="background: rgba(255,255,255,0.2); color: white; border: none; width: 45px; height: 45px; border-radius: 12px; cursor: pointer; font-size: 18px; transition: 0.2s; backdrop-filter: blur(4px);" onmouseover="this.style.background='rgba(255,255,255,0.4)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'" title="Xoay trái">
                <i class="fa fa-undo"></i>
            </button>
            <button onclick="rotateImage(90)" style="background: rgba(255,255,255,0.2); color: white; border: none; width: 45px; height: 45px; border-radius: 12px; cursor: pointer; font-size: 18px; transition: 0.2s; backdrop-filter: blur(4px);" onmouseover="this.style.background='rgba(255,255,255,0.4)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'" title="Xoay phải">
