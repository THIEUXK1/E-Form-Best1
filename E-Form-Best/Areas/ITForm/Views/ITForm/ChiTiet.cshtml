                                    <div style="background: #ffedd5; color: #9a3412; width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 18px;">
                                        @(hoTro.IdItNguoiHoTroNavigation?.Ten?.Substring(0, 1).ToUpper() ?? "IT")
