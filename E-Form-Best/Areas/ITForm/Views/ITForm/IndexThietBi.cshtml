        function renderUIThietBi() {
        let selectedCompanies = $('.chk-company:checked').map(function() { return $(this).val(); }).get();
        let selectedDepts = $('.chk-dept:checked').map(function() { return $(this).val(); }).get();
        let selectedLoais = $('.chk-loai:checked').map(function() { return $(this).val(); }).get();
        let selectedTrangThais = $('.chk-status:checked').map(function() { return $(this).val(); }).get();

        // Lấy thêm mảng giá trị của bộ lọc Windows và Office
        let selectedWins = $('.chk-win:checked').map(function() { return $(this).val(); }).get();
        let selectedOffices = $('.chk-office:checked').map(function() { return $(this).val(); }).get();

        let fLimit = $('#filterLimit').val();
        let fText = $('#filterText').val() ? $('#filterText').val().toLowerCase().trim() : '';
        let fSort = $('#filterSort').val();
        let fTuNgay = $('#filterTuNgay').val();
        let fDenNgay = $('#filterDenNgay').val();
        let fTìnhTrangCheck = $('#filterTìnhTrangCheck').val();

        let filtered = allThietBiCache.filter(x => !(x.tenTrangThai && x.tenTrangThai.toLowerCase().includes('xóa')));

        // Công ty/Bộ phận hỗ trợ 2 chiều: mặc định "chỉ lấy mục đã chọn", bật switch "Loại trừ" thì lấy tất cả TRỪ mục đã chọn
        if (selectedCompanies.length > 0) {
        let khopCT = x => selectedCompanies.includes(x.tenCongTy) || (selectedCompanies.includes("__CHUA_XAC_DINH__") && (!x.tenCongTy || x.tenCongTy.trim() === ""));
        filtered = excludeCongTyMode ? filtered.filter(x => !khopCT(x)) : filtered.filter(khopCT);
        }
        if (selectedDepts.length > 0) {
        let khopBP = x => selectedDepts.includes(x.tenBoPhan) || (selectedDepts.includes("__CHUA_XAC_DINH__") && (!x.tenBoPhan || x.tenBoPhan.trim() === ""));
        filtered = excludeBoPhanMode ? filtered.filter(x => !khopBP(x)) : filtered.filter(khopBP);
        }
        if (selectedLoais.length > 0) filtered = filtered.filter(x => selectedLoais.includes(x.loaiThietBi));
        if (selectedTrangThais.length > 0) filtered = filtered.filter(x => selectedTrangThais.includes(x.tenTrangThai));
        filtered = LocViTriDiaLyKiemKe.loc(filtered);
        filtered = LocCanCaiOfficeKiemKe.loc(filtered);

        // Nút gạt "Thiếu Hostname": chỉ giữ thiết bị bỏ trống ô Tên máy
        if (locThieuHostname) filtered = filtered.filter(x => !x.tenMayTinh || x.tenMayTinh.trim() === '');

        // Xử lý Logic lọc dữ liệu Windows License và Office License
        if (selectedWins.length > 0) filtered = filtered.filter(x => selectedWins.includes(x.winLicense) || (selectedWins.includes("Trống / Chưa rõ") && (!x.winLicense || x.winLicense.trim() === "")));
        if (selectedOffices.length > 0) filtered = filtered.filter(x => selectedOffices.includes(x.officeLicense) || (selectedOffices.includes("Trống / Chưa rõ") && (!x.officeLicense || x.officeLicense.trim() === "")));

        if (fTuNgay || fDenNgay || fTìnhTrangCheck) {
        filtered = filtered.filter(x => {
        let hasChecked = !!x.thoiGianCheck;
        let itemCheckDateChuỗi = "";

        if (hasChecked) {
        let d = new Date(x.thoiGianCheck);
        itemCheckDateChuỗi = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        if (fTìnhTrangCheck === 'chua_check') {
        if (!hasChecked) return true;
        if (fTuNgay && itemCheckDateChuỗi < fTuNgay) return true;
        if (fDenNgay && itemCheckDateChuỗi > fDenNgay) return true;
        return false;
        }

        if (fTìnhTrangCheck === 'da_check' || (!fTìnhTrangCheck && (fTuNgay || fDenNgay))) {
        if (!hasChecked) return false;
        if (fTuNgay && itemCheckDateChuỗi < fTuNgay) return false;
        if (fDenNgay && itemCheckDateChuỗi > fDenNgay) return false;
        return true;
        }
        return true;
        });
        }

        if (fText) {
        filtered = filtered.filter(x =>
        (x.tenMayTinh && x.tenMayTinh.toLowerCase().includes(fText)) ||
        (x.tenViTri && x.tenViTri.toLowerCase().includes(fText)) ||
        (x.tenDangNhap && x.tenDangNhap.toLowerCase().includes(fText)) ||
        (x.tenNguoiDung && x.tenNguoiDung.toLowerCase().includes(fText)) ||
        (x.tk && x.tk.toLowerCase().includes(fText)) ||
        (x.quyCach && x.quyCach.toLowerCase().includes(fText)) ||
        // So khớp 2 chiều: khớp khi Serial lưu trong hệ thống chứa từ khóa tìm, HOẶC từ khóa tìm (VD: chuỗi quét mã vạch dài hơn) chứa Serial lưu trong hệ thống
        (x.seribacode && (x.seribacode.toLowerCase().includes(fText) || fText.includes(x.seribacode.toLowerCase()))) ||
        // Tìm được cả theo Mã nhân viên và Vị trí địa lý (VD: gõ "Nghệ An" ra toàn bộ máy ở địa bàn đó)
        (x.maNhanVien && x.maNhanVien.toLowerCase().includes(fText)) ||
        (x.tenViTriDiaLy && x.tenViTriDiaLy.toLowerCase().includes(fText)) ||
        (x.ghiChu && x.ghiChu.toLowerCase().includes(fText))
        );
        }

        if (fSort) {
        // Bảng ánh xạ tiêu chí sắp xếp -> trường dữ liệu tương ứng
        let truongChu = {
        name: x => (x.tenViTri || '').toLowerCase().trim(),
        host: x => (x.tenMayTinh || '').toLowerCase().trim(),
        user: x => (x.tenNguoiDung || '').toLowerCase().trim(),
        account: x => (x.tenDangNhap || '').toLowerCase().trim(),
        dept: x => (x.tenBoPhan || '').toLowerCase().trim(),
        company: x => (x.tenCongTy || '').toLowerCase().trim(),
        type: x => (x.loaiThietBi || '').toLowerCase().trim(),
        serial: x => (x.seribacode || '').toLowerCase().trim(),
        status: x => (x.tenTrangThai || '').toLowerCase().trim()
        };
        let truongNgay = {
        check: x => x.thoiGianCheck,
        created: x => x.ngayTao,
        updated: x => x.ngayCapNhat
        };

        let tieuChi = fSort.replace(/_(asc|desc)$/, '');
        let giamDan = fSort.endsWith('desc');

        filtered.sort((a, b) => {
        // Sắp xếp theo mốc thời gian
        if (truongNgay[tieuChi]) {
        let tA = truongNgay[tieuChi](a) ? new Date(truongNgay[tieuChi](a)).getTime() : null;
        let tB = truongNgay[tieuChi](b) ? new Date(truongNgay[tieuChi](b)).getTime() : null;
        if (tA === null && tB === null) return 0;
        if (tA === null) return 1;  // chưa có mốc thời gian thì đẩy xuống cuối
        if (tB === null) return -1;
        return giamDan ? tB - tA : tA - tB;
        }

        // Sắp xếp theo chuỗi
        let layGiaTri = truongChu[tieuChi] || truongChu.name;
        let vA = layGiaTri(a), vB = layGiaTri(b);
        if (!vA && !vB) return 0;
        if (!vA) return 1;  // ô trống luôn nằm cuối, cả khi A-Z lẫn Z-A
        if (!vB) return -1;
        return giamDan ? vB.localeCompare(vA, 'vi') : vA.localeCompare(vB, 'vi');
        });
        } else {
        filtered.sort((a, b) => {
        let nameA = (a.tenViTri || '').toLowerCase().trim();
        let nameB = (b.tenViTri || '').toLowerCase().trim();

        let compareName = nameA.localeCompare(nameB, 'vi');
        if (compareName !== 0) {
        return compareName;
        }
        return b.idThietBi - a.idThietBi;
        });
        }

        dsThietBiTheoBoLoc = filtered.slice(); // giữ đủ danh sách khớp bộ lọc để xuất biên bản, không phụ thuộc ô "Dòng / trang"
        trangHienTaiThietBi = 1; // đổi bộ lọc thì luôn về trang đầu
        veBangThietBi();
        }

        // Vẽ MỘT trang của bảng thiết bị. Danh sách đã lọc nằm sẵn ở dsThietBiTheoBoLoc nên
        // chuyển trang không phải lọc lại từ đầu.
        function veBangThietBi() {
        let fLimit = $('#filterLimit').val();
        let soLuongPhuHop = dsThietBiTheoBoLoc.length;
        let soDongMoiTrang = (fLimit === 'all') ? Math.max(soLuongPhuHop, 1) : parseInt(fLimit);
        let tongSoTrang = Math.max(1, Math.ceil(soLuongPhuHop / soDongMoiTrang));
        if (trangHienTaiThietBi > tongSoTrang) trangHienTaiThietBi = tongSoTrang;
        if (trangHienTaiThietBi < 1) trangHienTaiThietBi = 1;

        let batDau = (trangHienTaiThietBi - 1) * soDongMoiTrang;
        let filtered = dsThietBiTheoBoLoc.slice(batDau, batDau + soDongMoiTrang);

        $('#lblSoLuongThietBi').html(soLuongPhuHop === 0
        ? '<i class="fas fa-list-ol me-1"></i> Không có thiết bị nào phù hợp bộ lọc'
        : `<i class="fas fa-list-ol me-1"></i> Hiển thị <b>${batDau + 1}-${batDau + filtered.length}</b> / <b>${soLuongPhuHop}</b> thiết bị phù hợp bộ lọc`);

        let html = '';
        filtered.forEach(item => {
        let userStr = item.tenNguoiDung
        ? `<span class="text-success fw-bold"><i class="fas fa-user me-1"></i>${item.tenNguoiDung} <span class="text-danger fw-normal">(${item.tk || 'N/A'})</span></span>`
        : `<span class="text-muted fst-italic">Chưa xác nhận người dùng</span>`;

        // Mã nhân viên của người đang đứng tên thiết bị - khai ở ô "Mã nhân viên - người dùng hiện tại" khi Xác nhận tài sản
        let dongMaNhanVien = item.maNhanVien
        ? `<div class="small text-muted"><i class="fas fa-id-badge me-1"></i>Mã NV: <span class="fw-semibold text-dark">${item.maNhanVien}</span></div>`
        : '';

        // Vị trí địa lý thực tế (Hải Dương, Nghệ An...) - khác với Vị trí đặt máy trong nhà xưởng
        let dongDiaBan = item.tenViTriDiaLy
        ? `<div class="small"><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="fas fa-location-dot me-1"></i>${item.tenViTriDiaLy}</span></div>`
        : `<div class="small text-muted fst-italic">Chưa khai địa bàn</div>`;

        // Câu trả lời kiểm kê "Máy này có cần cài Office không?" - null là chưa từng được hỏi
        let dongOffice;
        if (item.canCaiOffice === true) {
        dongOffice = `<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle" title="Người dùng xác nhận cần cài Office"><i class="fas fa-file-word me-1"></i>Cần Office</span>`;
        } else if (item.canCaiOffice === false) {
