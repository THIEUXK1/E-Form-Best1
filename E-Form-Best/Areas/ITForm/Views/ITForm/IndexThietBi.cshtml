        'border': '1px solid #e2e8f0', 'border-radius': '0.5rem'
        });
        }, 200);
        }

        initMiniComboThietBi('tb_IdCongTy', 'searchTbCongTy', 'menuTbCongTySearch');
        initMiniComboThietBi('tb_IdBoPhan', 'searchTbBoPhan', 'menuTbBoPhanSearch');
        $(document).on('click', function (e) {
        if (!$(e.target).closest('.mini-combo').length) { $('.mini-combo-menu').hide(); }
        });

        // Bản trước từng đặt mặc định "Tất cả"; giá trị đó còn kẹt trong localStorage của người đã mở trang,
        // làm bảng chỉ có 1 trang nên không thấy thanh chuyển trang. Dọn đúng MỘT lần, sau đó tôn trọng lựa chọn của người dùng.
        if (!localStorage.getItem('kk_phanTrang_v2')) {
