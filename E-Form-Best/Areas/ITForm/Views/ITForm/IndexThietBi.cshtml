        // Thanh phân trang: chỉ hiện khi danh sách bị chia thành nhiều trang
        function vePhanTrangThietBi(tongSoTrang, soLuongPhuHop) {
        let $box = $('#phanTrangThietBi');
        if (soLuongPhuHop === 0) { $box.empty(); return; }

        // Chỉ có một trang (thường là khi chọn "Tất cả"): chỉ hiện dòng tổng kết, không cần nút chuyển trang
        if (tongSoTrang <= 1) {
        $box.html(`<div class="small text-muted mt-2 px-1">Đang hiển thị toàn bộ <b>${soLuongPhuHop}</b> thiết bị
        <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline" onclick="chiaTrang100()">Chia trang 100 dòng</button></div>`);
        return;
        }

        let trang = trangHienTaiThietBi;
        let cacTrang = [];
        let dau = Math.max(1, trang - 2);
        let cuoi = Math.min(tongSoTrang, trang + 2);
        if (dau > 1) cacTrang.push(1);
        if (dau > 2) cacTrang.push('...');
        for (let i = dau; i <= cuoi; i++) cacTrang.push(i);
        if (cuoi < tongSoTrang - 1) cacTrang.push('...');
        if (cuoi < tongSoTrang) cacTrang.push(tongSoTrang);

        let nut = cacTrang.map(function (p) {
        if (p === '...') return '<li class="page-item disabled"><span class="page-link">…</span></li>';
        return `<li class="page-item ${p === trang ? 'active' : ''}"><button type="button" class="page-link" onclick="doiTrangThietBi(${p})">${p}</button></li>`;
