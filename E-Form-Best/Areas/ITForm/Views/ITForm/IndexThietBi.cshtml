        $('#tb_LoaiThietBi, #tb_IdTrangThai, #tb_IdViTriDiaLy, #tb_CanCaiOffice, #tb_IdCongTy, #tb_IdBoPhan, #tb_IdNguoiDung, #tb_WinLicense, #tb_OfficeLicense').on('change', function() {
