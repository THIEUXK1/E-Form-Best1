                                    <div class="card-header bg-white border-0 fw-bold pt-3 pb-0"><i class="fas fa-chart-bar text-primary me-1"></i> Số lượng theo Loại thiết bị</div>
                                    <div class="card-body">
                                        <canvas id="chartLoaiThietBi" style="max-height: 300px;"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                                    <div class="card-header bg-white border-0 fw-bold pt-3 pb-0"><i class="fas fa-chart-pie text-success me-1"></i> Tỷ lệ theo Trạng thái</div>
                                    <div class="card-body d-flex justify-content-center">
                                        <canvas id="chartTrangThai" style="max-height: 300px;"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade show active" id="thietbi" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1 flex-wrap gap-2">
                            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2" style="font-size: 13px; border-radius: 8px;" id="lblSoLuongThietBi">
                                <i class="fas fa-list-ol me-1"></i> Đang tải...
                            </span>
                        </div>
                        <div class="table-responsive" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0" id="adminDataTable" style="min-width: 100%;" data-dang-xem="auto">
                                <thead class="table-light">
                                    <tr>
                                        <th width="60">ID</th>
                                        <th width="70" class="text-center">Ảnh</th>
                                        <th width="120">Loại thiết bị</th>
                                        <th>Thông tin máy tính</th>
                                        <th>Người dùng & Vị trí</th>
                                        <th>Trạng thái & Kiểm tra</th>
                                        <th width="140" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyThietBi"></tbody>
                            </table>
                        </div>
                        @* Thanh phân trang nằm NGOÀI vùng cuộn để luôn nhìn thấy khi cuộn bảng *@
                        <div id="phanTrangThietBi"></div>
                    </div>

                    <div class="tab-pane fade" id="daxoa" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1 flex-wrap gap-2">
                            <span class="badge bg-danger-subtle text-danger fw-bold px-3 py-2" style="font-size: 13px; border-radius: 8px;" id="lblSoLuongDaXoa">
                                <i class="fas fa-list-ol me-1"></i> Đang tải...
                            </span>
                        </div>
                        <div class="table-responsive" data-fp-scroll>
                            <table class="table table-hover align-middle mb-0" id="adminDataTableDaXoa" style="min-width: 100%;" data-dang-xem="auto">
                                <thead class="table-light">
                                    <tr>
                                        <th width="70">ID</th>
                                        <th>Thông tin máy</th>
                                        <th>Vị trí cũ</th>
                                        <th>Ngày Xóa</th>
                                        <th>Lý do xóa</th>
                                        <th width="180" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyDaXoa"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="modalThietBi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-dark text-white border-0" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold" id="titleModalThietBi">Thông tin Thiết bị</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 p-md-4">
                <input type="hidden" id="tb_Id" value="0" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Loại thiết bị <span class="text-danger">*</span></label>
                        <select id="tb_LoaiThietBi" class="form-select rounded-3" style="border: 1px solid #e2e8f0; height: 45px;">
                            <option value="">-- Chọn loại --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tên Vị Trí <span class="text-danger">*</span></label>
                        <input type="text" id="tb_TenViTri" list="suggestTenViTri" class="form-control rounded-3" placeholder="VD: PHÒNG IT, SẢN XUẤT..." style="border: 1px solid #e2e8f0; height: 45px; text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" />
                        <datalist id="suggestTenViTri"></datalist>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" style="color: #8b5cf6;">Trạng thái <span class="text-danger">*</span></label>
                        <select id="tb_IdTrangThai" class="form-select rounded-3" style="border: 1px solid #8b5cf6; height: 45px;">
                            <option value="">-- Chọn trạng thái --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold" style="color: #0ea5e9;"><i class="fas fa-location-dot me-1"></i>Vị trí địa lý thực tế</label>
                        <select id="tb_IdViTriDiaLy" class="form-select rounded-3" style="border: 1px solid #0ea5e9; height: 45px;">
                            <option value="">-- Chưa xác định vị trí --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold" style="color: #16a34a;"><i class="fas fa-file-word me-1"></i>Trạng thái cần cài Office</label>
                        <select id="tb_CanCaiOffice" class="form-select rounded-3" style="border: 1px solid #16a34a; height: 45px;">
                            <option value="">⚠ Chưa trả lời</option>
                            <option value="true">✅ Cần cài Office</option>
                            <option value="false">🚫 Không cần Office</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-bold" style="color: #2563eb;">Quy cách (Cấu hình chi tiết)</label>
                        <input type="text" id="tb_QuyCach" class="form-control rounded-3" placeholder="VD: Core i7 13700H, RAM 16GB, SSD 512GB..." style="border: 1px solid #2563eb; height: 45px;" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Số Serial / Barcode</label>
                        <input type="text" id="tb_Seribacode" class="form-control rounded-3" placeholder="Nhập Serial hoặc Barcode..." style="border: 1px solid #e2e8f0; height: 45px;" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tên máy tính (Hostname)</label>
                        <input type="text" id="tb_TenMayTinh" class="form-control rounded-3" placeholder="VD: DESKTOP-123" style="border: 1px solid #e2e8f0; height: 45px; text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tên đăng nhập (Account)</label>
                        <input type="text" id="tb_TenDangNhap" class="form-control rounded-3" placeholder="VD: ADMIN_LOCAL" style="border: 1px solid #e2e8f0; height: 45px; text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Hạn bảo hành</label>
                        <input type="date" id="tb_HanBaoHanh" class="form-control rounded-3" style="border: 1px solid #e2e8f0; height: 45px;" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold"><i class="fab fa-windows text-primary me-1"></i> Bản quyền Windows</label>
                        <input type="text" id="tb_WinLicense" class="form-control rounded-3" list="dlWinLicense" placeholder="VD: Professional - Có bản quyền" style="border: 1px solid #e2e8f0; height: 45px;" />
                        <datalist id="dlWinLicense">
                            <option value="Home - Có bản quyền"></option>
                            <option value="Professional - Có bản quyền"></option>
                            <option value="Enterprise - Có bản quyền"></option>
                            <option value="Education - Có bản quyền"></option>
                            <option value="Chưa có bản quyền"></option>
                            <option value="Không xác định"></option>
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold"><i class="fas fa-file-word text-success me-1"></i> Bản quyền Office</label>
                        <input type="text" id="tb_OfficeLicense" class="form-control rounded-3" list="dlOfficeLicense" placeholder="VD: Có bản quyền" style="border: 1px solid #e2e8f0; height: 45px;" />
                        <datalist id="dlOfficeLicense">
                            <option value="Có bản quyền"></option>
                            <option value="Không có bản quyền"></option>
                            <option value="Không xác định"></option>
                        </datalist>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">Ghi chú (Cấu hình, thông tin...)</label>
                        <input type="text" id="tb_GhiChu" class="form-control rounded-3" placeholder="Thông tin tự thêm..." style="border: 1px solid #e2e8f0; height: 45px;" />
                    </div>

                    <div class="col-12 mt-4 mb-2"><div style="border-top: 1px dashed #cbd5e1;"></div></div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold" style="color: #4f46e5;">Gán người sử dụng</label>
                        <select id="tb_IdNguoiDung" class="form-control select2-modal w-100">
                            <option value="">-- Chưa xác nhận người dùng --</option>
                            @if (ViewBag.Users != null)
                            {
                                foreach (var item in ViewBag.Users)
                                {
                                    <option value="@item.IdNguoiDung">@item.HoTen (@item.Tk)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Gán Công ty</label>
                        <div class="mini-combo" id="comboTbCongTy">
                            <input type="text" class="form-control rounded-3" id="searchTbCongTy" placeholder="🔍 Gõ để tìm Công ty..." autocomplete="off" style="border: 1px solid #e2e8f0; height: 45px;" />
                            <div class="mini-combo-menu" id="menuTbCongTySearch"></div>
                        </div>
                        <select id="tb_IdCongTy" style="display:none">
                            <option value="">-- Chọn công ty --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Gán Bộ phận</label>
                        <div class="mini-combo" id="comboTbBoPhan">
                            <input type="text" class="form-control rounded-3" id="searchTbBoPhan" placeholder="🔍 Gõ để tìm Bộ phận..." autocomplete="off" style="border: 1px solid #e2e8f0; height: 45px;" />
                            <div class="mini-combo-menu" id="menuTbBoPhanSearch"></div>
                        </div>
                        <select id="tb_IdBoPhan" style="display:none">
                            <option value="">-- Chọn bộ phận --</option>
                        </select>
                    </div>

                    <div class="col-12 mt-4 mb-2"><div style="border-top: 1px dashed #cbd5e1;"></div></div>

                    <div class="col-md-12 mt-2">
                        <label class="form-label fw-bold"><i class="fas fa-camera text-secondary me-1"></i> Ảnh thiết bị đính kèm</label>
                        <div class="drag-drop-zone text-center mb-2" id="dropZoneThietBi" title="Click để tải, hoặc Kéo thả ảnh vào đây, hoặc nhấn vào modal rồi Ctrl + V để dán ảnh">
                            <div class="py-2 text-muted" id="txtDropZoneHint">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2 text-primary"></i>
                                <p class="mb-1 small fw-semibold">Click tải lên / Kéo thả ảnh / Bấm vào đây rồi nhấn <b>Ctrl + V</b> để dán ảnh</p>
                            </div>
                            <div class="d-flex gap-2 justify-content-center mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="$('#tb_Anh').click(); event.stopPropagation();">
                                    <i class="fas fa-upload"></i> Chọn File
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="openCamera(); event.stopPropagation();">
                                    <i class="fas fa-camera"></i> Chụp trực tiếp
                                </button>
                            </div>
                        </div>

                        <input type="file" id="tb_Anh" accept="image/*" class="d-none" onchange="previewImage(this)" />

                        <div id="boxCamera" style="display: none;" class="mt-2 text-center border rounded p-2 bg-light shadow-sm">
                            <video id="videoCamera" autoplay playsinline style="width: 100%; max-height: 300px; border-radius: 10px; background: #000; object-fit: cover;"></video>
                            <div class="mt-3 mb-2">
                                <button type="button" class="btn btn-danger rounded-pill px-4" onclick="takeSnapshot()">
                                    <i class="fas fa-dot-circle me-1"></i> Chụp ngay
                                </button>
                                <button type="button" class="btn btn-secondary rounded-pill px-3 ms-2" onclick="closeCamera()">
                                    <i class="fas fa-times me-1"></i> Đóng Camera
                                </button>
                            </div>
                            <canvas id="canvasCamera" style="display: none;"></canvas>
                        </div>

                        <div class="mt-3 text-center" id="boxPreviewImg" style="display: none;">
                            <div class="position-relative d-inline-block">
                                <img id="imgThietBi" src="" alt="Ảnh thiết bị" class="shadow-sm" style="max-height: 250px; max-width: 100%; border-radius: 10px; border: 2px dashed #cbd5e1; padding: 5px;" />
                                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 start-100 translate-middle rounded-circle shadow" onclick="clearImage()" style="width: 28px; height: 28px; padding: 0; line-height: 1;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light d-flex justify-content-between" style="border-radius: 0 0 20px 20px;">
                <button type="button" class="btn btn-link text-secondary text-decoration-none" data-bs-dismiss="modal">Đóng</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-warning px-3 rounded-pill" id="btnSaveAsNew" style="display: none;" onclick="saveThietBi(true)">
                        <i class="fas fa-copy"></i> Lưu thành bản sao mới
                    </button>
                    <button type="button" class="btn btn-dark px-4 rounded-pill" onclick="saveThietBi(false)">Lưu dữ liệu</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalQuickCamMobile" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-danger text-white border-0" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-camera me-2"></i> Chụp ảnh thiết bị nhanh</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="closeQuickCamera()"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="quickCam_IdThietBi" value="0" />
                <div class="text-center border rounded p-2 bg-light shadow-sm">
                    <video id="videoQuickCamera" autoplay playsinline style="width: 100%; max-height: 280px; border-radius: 10px; background: #000; object-fit: cover;"></video>
                    <div class="mt-3 mb-2">
                        <button type="button" class="btn btn-danger rounded-pill px-4" onclick="captureAndUploadQuickPhoto()">
                            <i class="fas fa-dot-circle me-1"></i> Xác nhận & Thay luôn
                        </button>
                        <button type="button" class="btn btn-secondary rounded-pill px-3 ms-2" data-bs-dismiss="modal" onclick="closeQuickCamera()">
                            <i class="fas fa-times me-1"></i> Hủy
                        </button>
                    </div>
                    <canvas id="canvasQuickCamera" style="display: none;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalXacNhanCheckEvidence" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white border-0" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-clipboard-check me-2"></i> Xác nhận kiểm kê thiết bị</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="closeEvidenceCamera()"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="evidence_IdThietBi" value="0" />

                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted">Ghi chú kiểm kê (Nếu có)</label>
                    <input type="text" id="evidence_GhiChu" class="form-control rounded-3" placeholder="Ví dụ: Hoạt động tốt, tem còn nguyên vẹn..." style="font-size:13px;" />
                </div>

                <label class="form-label fw-bold small text-muted"><i class="fas fa-image me-1"></i> Hình ảnh bằng chứng thực tế (Tùy chọn)</label>
                <div class="drag-drop-zone text-center mb-2" id="dropZoneEvidence" style="border: 2px dashed #10b981; background: #f0fdf4;" title="Kéo thả tệp, hoặc click chọn ảnh, hoặc click vào vùng này rồi nhấn Ctrl + V để dán bằng chứng">
                    <div class="py-2 text-muted" id="txtEvidenceZoneHint">
                        <i class="fas fa-camera-retro fa-2x mb-2 text-success"></i>
                        <p class="mb-1 small fw-semibold">Chọn ảnh từ máy / Kéo thả ảnh / Nhấp vào đây rồi nhấn <b>Ctrl + V</b> để dán</p>
                    </div>
                    <div class="d-flex gap-2 justify-content-center mt-2">
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="$('#evidence_AnhFile').click(); event.stopPropagation();">
                            <i class="fas fa-file-image"></i> Chọn file ảnh
                        </button>
                        <button type="button" class="btn btn-sm btn-success" onclick="openEvidenceCamera(); event.stopPropagation();">
                            <i class="fas fa-video"></i> Mở Camera
                        </button>
                    </div>
                </div>

                <input type="file" id="evidence_AnhFile" accept="image/*" class="d-none" onchange="previewEvidenceImage(this)" />

                <div id="boxEvidenceCamera" style="display: none;" class="mt-2 text-center border rounded p-2 bg-light shadow-sm">
                    <video id="videoEvidenceCamera" autoplay playsinline style="width: 100%; max-height: 240px; border-radius: 10px; background: #000; object-fit: cover;"></video>
                    <div class="mt-2 mb-1">
                        <button type="button" class="btn btn-danger rounded-pill px-3" onclick="takeEvidenceSnapshot()">
                            <i class="fas fa-dot-circle me-1"></i> Chụp hình bằng chứng
                        </button>
                        <button type="button" class="btn btn-secondary rounded-pill px-2 ms-2" onclick="closeEvidenceCamera()">
                            <i class="fas fa-times"></i> Đóng cam
                        </button>
                    </div>
                    <canvas id="canvasEvidenceCamera" style="display: none;"></canvas>
                </div>

                <div class="mt-3 text-center" id="boxPreviewEvidenceImg" style="display: none;">
                    <div class="position-relative d-inline-block">
                        <img id="imgEvidencePreview" src="" alt="Bằng chứng kiểm kê" class="shadow-sm" style="max-height: 180px; max-width: 100%; border-radius: 10px; border: 2px dashed #10b981; padding: 3px;" />
                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 start-100 translate-middle rounded-circle shadow" onclick="clearEvidenceImage()" style="width: 24px; height: 24px; padding: 0; line-height: 1;">
                            <i class="fas fa-times" style="font-size:11px;"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-sm btn-link text-secondary text-decoration-none" data-bs-dismiss="modal" onclick="closeEvidenceCamera()">Hủy bỏ</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill" onclick="executeSubmitXacNhanCheck(true)">
                        Xác nhận nhanh (Không ảnh)
                    </button>
                    <button type="button" class="btn btn-sm btn-success px-4 rounded-pill" onclick="executeSubmitXacNhanCheck(false)">
                        <i class="fas fa-check-double me-1"></i> Hoàn tất kiểm tra
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalLichSuCheckThietBi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-info text-white border-0" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-history me-2"></i> Nhật ký kiểm kê thiết bị</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="lblInfoThietBiLichSu" class="mb-3 p-2 bg-light rounded border fw-bold small text-secondary"></div>
                <div class="timeline-check" id="boxTimelineCheckResult"></div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/fixed-page-layout.js?v=5" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/kiemke-chan-thietbi.js"></script>
    @* File tĩnh được cache 7 ngày, đổi nội dung phải nâng số v để trình duyệt tải lại *@
    <script src="/js/kiemke-loc-vitri-dialy.js?v=2"></script>
    <script src="/js/kiemke-loc-can-cai-office.js?v=1"></script>
    <script src="/js/kiemke-form-vitri-office.js?v=1"></script>
