        // Gửi file báo cáo license lên Server để nhập nhanh bản quyền Windows theo LOẠI KEY (sheet ALL_PC)
        function submitImportWinLicense() {
        var fileInput = document.getElementById('fileImportWinLicense');
        if (!fileInput.files || fileInput.files.length === 0) {
        Swal.fire('Thông báo', 'Vui lòng chọn file Excel trước khi tải lên.', 'warning');
        return;
        }

        var formData = new FormData();
        formData.append('file', fileInput.files[0]);

        var $btn = $('#btnSubmitImportWinLicense');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý...');
        $('#ketQuaImportWinLicense').hide().empty();

        $.ajax({
        url: '/QLKiemKe/ImportWinLicenseExcel',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
        $btn.prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Tải lên & Cập nhật');
        if (res.success) {
        var html = `<div class="alert alert-success mb-2"><i class="fas fa-check-circle me-1"></i> Đã cập nhật <b>${res.soDaCapNhat}</b> thiết bị (Máy tính/Laptop).</div>`;
        html += `<div class="alert alert-info mb-2"><i class="fas fa-shield-alt me-1"></i> Đạt chuẩn (MAK công ty / OEM): <b>${res.soDatChuan}</b> máy &nbsp;|&nbsp; Không đạt (GVLK / Retail generic / khác): <b class="text-danger">${res.soKhongDat}</b> máy</div>`;
        html += `<div class="alert alert-secondary mb-2"><i class="fas fa-info-circle me-1"></i> Bỏ qua <b>${res.soBoQuaTrong}</b> máy không đọc được key (Offline / WinRM Blocked / N/A) - giữ nguyên dữ liệu cũ.</div>`;
        if (res.dsKhongTimThay && res.dsKhongTimThay.length > 0) {
        html += `<div class="alert alert-warning mb-2"><i class="fas fa-exclamation-triangle me-1"></i> Không tìm thấy <b>${res.dsKhongTimThay.length}</b> tên máy trong hệ thống:<br/><small>${res.dsKhongTimThay.join(', ')}</small></div>`;
        }
        if (res.dsBoQuaKhacLoai && res.dsBoQuaKhacLoai.length > 0) {
        html += `<div class="alert alert-secondary mb-0"><i class="fas fa-info-circle me-1"></i> Bỏ qua <b>${res.dsBoQuaKhacLoai.length}</b> tên máy trùng nhưng thiết bị không phải Máy tính/Laptop:<br/><small>${res.dsBoQuaKhacLoai.join(', ')}</small></div>`;
        }
        $('#ketQuaImportWinLicense').html(html).show();
        fileInput.value = '';
        loadThietBi();
        } else {
        $('#ketQuaImportWinLicense').html(`<div class="alert alert-danger mb-0"><i class="fas fa-times-circle me-1"></i> ${res.message}</div>`).show();
        }
        },
        error: function () {
        $btn.prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Tải lên & Cập nhật');
        $('#ketQuaImportWinLicense').html('<div class="alert alert-danger mb-0">Lỗi kết nối đến Server khi tải file lên.</div>').show();
        }
        });
        }

