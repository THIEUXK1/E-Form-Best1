    <script>
        var currentTab = 'Thiết bị';

        let listCongTyCache = [];
        let listBoPhanCache = [];
        let listTrangThaiCache = [];
        let listLoaiThietBiCache = [];
        // Toàn bộ thiết bị khớp bộ lọc hiện tại (TRƯỚC khi cắt bớt theo ô "Hiển thị") - dùng để xuất biên bản ký
        let dsThietBiTheoBoLoc = [];
        let trangHienTaiThietBi = 1; // trang đang xem của bảng Thiết bị (phân trang phía client)
        let allThietBiCache = [];

        let chartLoai = null;
        let chartTT = null;

        let currentStream = null;
        let capturedPhotoBlob = null;
        let quickCamStream = null;

        let evidencePhotoBlob = null;
        let evidenceCamStream = null;

        // Combobox tìm kiếm tự viết cho Công ty/Bộ phận trong modal Thêm/Cập nhật Thiết bị:
        // select thật vẫn giữ nguyên (ẩn đi) để không đổi logic đọc/ghi giá trị ở nơi khác, chỉ thêm lớp UI tìm kiếm phía trên.
        function initMiniComboThietBi(selectId, searchId, menuId) {
        var $select = $('#' + selectId);
        var $search = $('#' + searchId);
        var $menu = $('#' + menuId);

        function renderMenu(filterText) {
        var filter = removeVietnameseTonesJS(filterText || '').toUpperCase();
        var html = '';
        $select.find('option').each(function () {
        var val = $(this).val();
        var text = $(this).text();
        if (!val) return;
        if (filter && removeVietnameseTonesJS(text).toUpperCase().indexOf(filter) === -1) return;
        var activeClass = (val === $select.val()) ? ' active' : '';
        html += '<div class="mini-combo-item' + activeClass + '" data-value="' + val + '">' + text + '</div>';
        });
        $menu.html(html || '<div class="mini-combo-empty">Không tìm thấy kết quả</div>');
        }

        function dongBoHienThiTuSelect() {
        var text = $select.find('option:selected').text();
        $search.val($select.val() ? text : '');
        }

        $search.on('focus click', function (e) {
        e.stopPropagation();
        renderMenu('');
        $menu.show();
        });

        $search.on('input', function () {
        renderMenu($(this).val());
        $menu.show();
        });

        $menu.on('click', '.mini-combo-item', function () {
        $select.val($(this).data('value')).trigger('change');
        dongBoHienThiTuSelect();
        $menu.hide();
        });

        // Mỗi khi giá trị select thật đổi (kể cả do code khác gán bằng .val().trigger('change')) thì đồng bộ lại ô hiển thị
        $select.on('change', dongBoHienThiTuSelect);
        dongBoHienThiTuSelect();
        }

        $(document).ready(function () {
        if($.fn.select2) {
        $('.select2-modal').select2({
        dropdownParent: $('#modalThietBi .modal-content'),
        placeholder: "-- Chọn người dùng --",
        allowClear: true,
        width: '100%',
        minimumResultsForSearch: 0
        });

        $(document).on('select2:open', () => {
        let isMobile = window.matchMedia("(max-width: 767px)").matches;
        if (!isMobile) {
        let searchField = document.querySelector('.select2-search__field');
        if (searchField) { setTimeout(() => { searchField.focus(); }, 10); }
