        }

        // Thoát ký tự cho giá trị đưa vào thuộc tính HTML (Tên máy/Serial có thể chứa dấu nháy)
        function thoatThuocTinhChan(giaTri) {
        return String(giaTri == null ? "" : giaTri).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        // Các loại thiết bị không chạy Windows/Office nên không có khái niệm bản quyền —
        // hiện thông tin bản quyền cho chúng là sai nghiệp vụ, phải ẩn đi.
        const loaiKhongCoBanQuyen = ['màn hình', 'máy in', 'điện thoại bàn', 'tivi', 'pda', 'máy scan', 'loa',
        'bộ lưu điện', 'máy chiếu', 'switch', 'súng bắn mã vạch', 'máy chấm công', 'thiết bị họp trực tuyến'];
        function khongCoBanQuyen(loai) {
        return loaiKhongCoBanQuyen.includes((loai || '').trim().toLowerCase());
        }

        // Chặn thiết bị (module dùng chung kiemke-chan-thietbi.js): sau khi chặn/bỏ chặn thì nạp lại danh sách
        ChanThietBiKiemKe.onThayDoi = function () { loadThietBi(); };

        $(document).on("click", ".btn-chan-thiet-bi", function () {
        ChanThietBiKiemKe.chan($(this).data("seri"), $(this).data("ten"));
        });

        // Xuất biên bản xác nhận tài sản bộ phận (bản in để bộ phận đối chiếu và ký tay)
        // Lấy đúng danh sách đang khớp bộ lọc, nên muốn biên bản của 1 bộ phận thì lọc Bộ phận đó trước.
        function xuatBienBanBoPhan(dinhDang) {
        if (dinhDang !== 'excel' && dinhDang !== 'excel_vitrung' && dinhDang !== 'excel_xacnhan') dinhDang = 'in';
        if (!dsThietBiTheoBoLoc.length) {
        return Swal.fire('Chưa có dữ liệu', 'Không có thiết bị nào khớp bộ lọc hiện tại để xuất biên bản.', 'warning');
        }

        let dsBoPhan = [...new Set(dsThietBiTheoBoLoc.map(x => (x.tenBoPhan && x.tenBoPhan.trim()) ? x.tenBoPhan.trim() : 'Chưa xác định'))];
        let ids = dsThietBiTheoBoLoc.map(x => x.idThietBi).join(',');

        // Gửi bằng form ẩn (POST) thay vì nhét ids vào URL: vài nghìn thiết bị là chuỗi ids dài quá mức
        // cho phép của URL, trình duyệt/Kestrel sẽ cắt hoặc trả 414.
        let moBienBan = () => {
        let f = document.createElement('form');
        f.method = 'post';
        f.action = '/QLKiemKe/ExportBienBanTaiSanBoPhan';
        f.target = '_blank';
        f.style.display = 'none';
        [['dinhDang', dinhDang], ['ids', ids]].forEach(([ten, giaTri]) => {
        let o = document.createElement('input');
        o.type = 'hidden'; o.name = ten; o.value = giaTri;
        f.appendChild(o);
        });
        document.body.appendChild(f);
        f.submit();
        f.remove();
        };

        // Danh sách dài chỉ là lời nhắc, không chặn: ai vẫn muốn xuất chung thì bấm "Vẫn xuất".
        // Phiếu xác nhận Office & Vị trí địa lý thì không nhắc gì, xuất thẳng.
        if (dinhDang !== 'excel_xacnhan' && dsThietBiTheoBoLoc.length > 500) {
        return Swal.fire({
        title: 'Danh sách khá dài',
        html: `Đang có <b>${dsThietBiTheoBoLoc.length}</b> thiết bị. Biên bản ký thường lập theo từng bộ phận - bạn có thể lọc <b>Bộ phận</b> ở Bộ lọc nâng cao rồi xuất lại.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Vẫn xuất',
        cancelButtonText: 'Để tôi lọc lại'
        }).then(kq => { if (kq.isConfirmed) moBienBan(); });
        }

        if (dsBoPhan.length > 1) {
        return Swal.fire({
        title: 'Đang gồm nhiều bộ phận',
        html: `Danh sách hiện có <b>${dsThietBiTheoBoLoc.length}</b> thiết bị thuộc <b>${dsBoPhan.length}</b> bộ phận:<br/><span class="small text-muted">${dsBoPhan.join(', ')}</span><br/><br/>Biên bản ký thường lập riêng cho từng bộ phận.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Vẫn xuất chung',
        cancelButtonText: 'Để tôi lọc lại'
        }).then(kq => { if (kq.isConfirmed) moBienBan(); });
        }

        moBienBan();
        }

