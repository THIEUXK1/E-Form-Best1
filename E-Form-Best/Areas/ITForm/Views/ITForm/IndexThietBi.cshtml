        <ul class="pagination pagination-sm mb-0">
        <li class="page-item ${trang === 1 ? 'disabled' : ''}"><button type="button" class="page-link" onclick="doiTrangThietBi(${trang - 1})"><i class="fas fa-chevron-left"></i></button></li>
        ${nut}
        <li class="page-item ${trang === tongSoTrang ? 'disabled' : ''}"><button type="button" class="page-link" onclick="doiTrangThietBi(${trang + 1})"><i class="fas fa-chevron-right"></i></button></li>
        </ul>
