@* Layout tối giản (không sidebar/thanh trên) cho trang được nhúng làm tab trong iframe của "Báo cáo định kì" (/BaoCaoDinhKy).
   View chọn layout này khi URL có ?nhung=1; giữ cùng thư viện nền với _Layout để trang con chạy y như khi mở riêng. *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/mau-chu-dao.css?v=8" />
    <style>
        body { font-family: 'Inter', sans-serif; margin: 0; padding: 8px 4px; background: #fff; color: #1e293b; overflow-x: hidden; }
    </style>
</head>
<body>
    @* Token CSRF cho antiforgery-ajax.js, như _Layout *@
    @Html.AntiForgeryToken()
    @RenderBody()

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/antiforgery-ajax.js?v=1"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
