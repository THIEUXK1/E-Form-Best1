@using Microsoft.AspNetCore.Localization
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLoginPage = currentController == "TaiKhoan" && currentAction == "DangNhap";

    // Lấy thông tin người dùng từ Claims
    var currentUserName = (User.Identity != null && User.Identity.IsAuthenticated) ? User.Identity.Name ?? "" : "";
    var currentUserRole = User.FindFirst("UserRole")?.Value ?? "";
    var phongBan = User.FindFirst("PhongBan")?.Value ?? "";

    // Lấy thông tin ngôn ngữ hiện tại từ Cookie hệ thống
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var cultureCode = requestCulture?.RequestCulture.Culture.Name ?? "vi-VN";

    // QLCCDC là module IT nhưng tên controller không chứa chữ "IT" nên phải liệt kê tường minh,
    // nếu không trang sẽ hiển thị nhầm giao diện HR (màu xanh lá, logo "HR SERVICE").
    bool isITSystem = currentController.Contains("IT") || currentController == "Mail"
                      || currentController.Contains("Order") || currentController == "QLCCDC";

    // Các trang thuộc nhóm "Đăng ký đơn" — dùng để tô sáng mục menu, kể cả khi đang ở trang chọn loại đơn
    string[] itSubPages = { "DangKyDon", "DonMail", "TaoIT_Order", "TaoIT_Wifi", "TaoIT_DtBan", "DonDienThoaiBan", "DonTaiKhoanHeThong", "DonTaiKhoanMayTinh", "DonLapDatThietBi", "DonCapQuyenOChung", "DonThietKeTemIn" }; bool isITSubActive = itSubPages.Contains(currentAction);

    // Đang ở một form đơn cụ thể (không phải trang chọn loại đơn) thì hiện nút quay lại trang chọn
    bool isTrangFormDon = isITSubActive && currentAction != "DangKyDon";

    // Khai báo biến cho menu Thống kê
    string[] reportPages = { "BaoCaoThongKe", "ThongKeMacWifi", "BaoCaoGanttTimeline" }; // Bạn có thể thêm các Action báo cáo khác vào đây sau này
    bool isReportActive = reportPages.Contains(currentAction);

    // Route /QLKiemKe/* được khai bằng attribute routing NGAY TRÊN ITFormController, nên
    // RouteData["controller"] luôn là "ITForm" — không được so với "QLKiemKe", phải so theo action.
    string[] kiemKePages = { "IndexKiemKe", "IndexThietBi", "ViewDanhSachTatCaMayTinh", "ThongKeKiemKe" };
    bool isKiemKeGroupActive = kiemKePages.Contains(currentAction);

    string primaryGradient = isITSystem ? "linear-gradient(180deg, #0f172a 0%, #1e40af 100%)" : "linear-gradient(180deg, #1a365d 0%, #2d3748 100%)";
    string accentColor = isITSystem ? "#60a5fa" : "#34d399";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>E-FormIT - @ViewData["Title"]</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💻</text></svg>">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />


    <style>
