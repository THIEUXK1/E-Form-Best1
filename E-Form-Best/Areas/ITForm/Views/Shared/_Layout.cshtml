                background: rgba(255,255,255,0.12);
                margin: 20px 10px;
            }

            .nav-section-title {
                font-size: 0.72rem;
                color: rgba(255,255,255,0.45);
                text-transform: uppercase;
                letter-spacing: 1.5px;
                margin: 10px 0 10px 12px;
                font-weight: 700;
                transition: color 0.3s;
            }

