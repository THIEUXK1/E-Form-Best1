            html.fp-slim #sidebar .brand-row {
                flex-direction: column;
                gap: 10px;
                margin-bottom: 20px !important;
            }

                html.fp-slim #sidebar .brand-row > a {
                    padding: 10px !important;
                    justify-content: center;
                    width: 100%;
                }

