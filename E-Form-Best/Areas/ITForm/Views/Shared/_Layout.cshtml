        /* ===== Nút thu gọn menu (trên header, cạnh nút đổi ngôn ngữ) ===== */
        .slim-toggle-btn {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #475569;
            font-size: 16px;
            cursor: pointer;
            transition: 0.2s;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

            .slim-toggle-btn:hover {
                background: #f1f5f9;
                border-color: #3b82f6;
                color: #1e293b;
                transform: translateY(-1px);
            }


        /* Tooltip tên mục khi sidebar đang thu gọn */
        #slimTip {
            position: fixed;
            display: none;
            transform: translateY(-50%);
            background: #0f172a;
            color: #fff;
            padding: 7px 13px;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 600;
            white-space: nowrap;
            box-shadow: 0 8px 20px rgba(0,0,0,0.25);
            pointer-events: none;
            z-index: 2000;
        }

            #slimTip.show {
                display: block;
            }

        /* ===== Thu gọn sidebar thành thanh icon (vẫn bấm được) =====
           Chỉ áp dụng trên desktop; mobile vẫn dùng menu trượt sẵn có */
        @@media (min-width: 769px) {
