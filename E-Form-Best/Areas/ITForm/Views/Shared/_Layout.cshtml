                }
                /* SỬA LẠI ĐỂ RENDERBODY() SÁT LỀ TRÊN MOBILE HOÀN TOÀN */
                .main-content-wrapper {
                    padding: 15px 0 !important; /* Đảm bảo padding trái phải bằng 0 */
                }

                .main-card {
                    padding: 20px 0 !important; /* THAY ĐỔI TẠI ĐÂY: từ 10px thành 0 để ép sát lề 100% */
                    border-radius: 0 !important;
