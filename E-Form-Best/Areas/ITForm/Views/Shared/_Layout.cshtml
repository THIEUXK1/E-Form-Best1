                }

                .lang-item.active {
                    color: #2563eb;
                    background: #f0f9ff;
                }

            /* --- CSS ẨN WIDGET GOOGLE TRANSLATE MẶC ĐỊNH --- */
            .VIpgJd-ZVi9od-ORHb-OEVmcd {
                display: none !important;
            }

            .goog-te-banner-frame {
                display: none !important;
            }

            body {
                top: 0px !important;
            }

            #goog-gt-tt {
                display: none !important;
            }

            /* ==========================================
                                                                                THÊM MỚI: CSS CHO MOBILE RESPONSIVE
                                                                                ========================================== */
            .sidebar-backdrop {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                z-index: 995;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            @@media (max-width: 768px) {
