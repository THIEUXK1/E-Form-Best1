@using System.Security.Claims
@model E_Form_Best.Models.ITForm.User
@{
    Layout = null;
    ViewData["Title"] = "Hồ Sơ Cá Nhân";

    var hoTen = !string.IsNullOrWhiteSpace(Model.HoTen) ? Model.HoTen : (User.Identity?.Name ?? "N/A");
    var email = User.FindFirst(ClaimTypes.Email)?.Value;
    var phongBan = User.FindFirst("PhongBan")?.Value ?? Model.PhongBan;
    var congTy = User.FindFirst("TenCongTy")?.Value ?? Model.TenCongTy;

    // Xử lý hiển thị nhiều bộ phận
    var tenBoPhanRaw = User.FindFirst("TenBoPhan")?.Value ?? "";
    var danhSachBoPhan = tenBoPhanRaw.Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
    var moTaBoPhan = User.FindFirst("MoTaBoPhan")?.Value;

    // Xử lý hiển thị tất cả các quyền (Roles)
    var danhSachQuyen = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
    if (!danhSachQuyen.Any())
    {
        var vaiTroMacDinh = User.FindFirst("UserRole")?.Value;
        if (!string.IsNullOrEmpty(vaiTroMacDinh)) danhSachQuyen.Add(vaiTroMacDinh);
    }

    // Ưu tiên lấy từ ViewBag (vừa cập nhật) sau đó mới đến Claim
    string? anhDaiDien = ViewBag.AnhDaiDien ?? User.FindFirst("AnhDaiDien")?.Value;
    var coAnh = !string.IsNullOrEmpty(anhDaiDien);

    // Danh sách trường thông tin: (khoá dịch, nhãn, giá trị)
    var thongTin = new List<(string Khoa, string Nhan, string? GiaTri)>
    {
        ("label-manv", "Mã nhân viên", Model.MaNhanVien),
        ("label-tk", "Tài khoản", Model.Tk),
        ("label-email", "Email", email),
        ("label-sdt", "Số điện thoại", Model.SoDienThoai),
        ("label-co", "Công ty", congTy),
        ("label-dept", "Phòng ban", phongBan),
        ("label-ngaytao", "Ngày tạo tài khoản", Model.NgayTao?.ToString("dd/MM/yyyy")),
        ("label-capnhat", "Cập nhật lần cuối", Model.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm")),
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/thong-tin-tai-khoan.css?v=1" rel="stylesheet">
</head>
<body>

    <header class="ttk-thanh-tren">
        <div class="ttk-thanh-tren-trong">
            <h1 class="ttk-tieu-de-trang"><i class="fas fa-id-badge"></i> <span data-key="title-page">Hồ sơ cá nhân</span></h1>
            <div class="ttk-ngon-ngu" role="group" aria-label="Ngôn ngữ">
                <button type="button" class="dang-chon" data-ngon-ngu="vi">VI</button>
                <button type="button" data-ngon-ngu="en">EN</button>
                <button type="button" data-ngon-ngu="zh">中文</button>
            </div>
        </div>
    </header>

    <main class="ttk-khung">
        <!-- Thẻ hồ sơ -->
        <aside class="ttk-the ttk-ho-so">
            <div class="ttk-bia"></div>
            <div class="ttk-ho-so-than">
                <div class="ttk-anh" id="khungAnh">
                    <img id="profileImg" alt="Ảnh đại diện"
                         src="/DonXetDuyet/GetAvatar?path=@Uri.EscapeDataString(anhDaiDien ?? "")"
                         data-anh-mac-dinh="https://cdn-icons-png.flaticon.com/512/149/149071.png">
                    <div class="ttk-anh-phu">
                        <button type="button" class="ttk-nut-anh" id="btnDoiAnh" title="Đổi ảnh"><i class="fas fa-camera"></i></button>
                        <button type="button" class="ttk-nut-anh xoa" id="btnXoaAnh" title="Xóa ảnh" @(coAnh ? "" : "hidden")><i class="fas fa-trash-alt"></i></button>
                    </div>
                </div>
                <input type="file" id="fileInput" hidden accept="image/*">

                <h2 class="ttk-ten">@hoTen</h2>
                @if (!string.IsNullOrWhiteSpace(Model.TenTiengTrung))
                {
                    <div class="ttk-ten-phu">@Model.TenTiengTrung</div>
                }
                <div class="ttk-tk"><span class="ttk-trang-thai"></span> <span data-key="status-online">Trực tuyến</span></div>

                @if (danhSachQuyen.Any())
                {
                    <div class="ttk-vai-tro">
                        @foreach (var quyen in danhSachQuyen)
                        {
                            <span class="ttk-chip"><i class="fas fa-shield-alt"></i> @quyen</span>
                        }
                    </div>
                }

                <div class="ttk-thong-bao-anh" id="thongBaoAnh" aria-live="polite"></div>

                <div class="ttk-hanh-dong">
                    <button type="button" class="ttk-nut ttk-nut-vien" id="btnDong"><i class="fas fa-times"></i> <span data-key="btn-close">Đóng</span></button>
                    <a href="/DonXetDuyet/DangXuat" class="ttk-nut ttk-nut-nguy"><i class="fas fa-sign-out-alt"></i> <span data-key="btn-exit">Đăng xuất</span></a>
                </div>
            </div>
        </aside>

        <div class="ttk-cot-phai">
            <!-- Thông tin tài khoản -->
            <section class="ttk-the">
                <div class="ttk-the-dau">
                    <h2><i class="fas fa-user"></i> <span data-key="sec-info">Thông tin tài khoản</span></h2>
                </div>
                <div class="ttk-the-than">
                    <div class="ttk-luoi">
                        @foreach (var tt in thongTin)
                        {
                            var trong = string.IsNullOrWhiteSpace(tt.GiaTri) || tt.GiaTri == "N/A";
                            <div class="ttk-dong">
                                <div class="ttk-nhan" data-key="@tt.Khoa">@tt.Nhan</div>
                                @if (trong)
                                {
                                    <div class="ttk-gia-tri trong" data-key="empty-val">Chưa cập nhật</div>
                                }
                                else
                                {
                                    <div class="ttk-gia-tri">@tt.GiaTri</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>

            <!-- Bộ phận phụ trách -->
            <section class="ttk-the">
                <div class="ttk-the-dau">
                    <h2><i class="fas fa-sitemap"></i> <span data-key="label-assigned">Bộ phận phụ trách</span></h2>
                </div>
                <div class="ttk-the-than">
                    @if (danhSachBoPhan.Any())
                    {
                        <div class="ttk-ds-bo-phan">
                            @foreach (var bp in danhSachBoPhan)
                            {
                                <span class="ttk-chip bo-phan">@bp</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ttk-ds-bo-phan"><span class="ttk-gia-tri trong" data-key="no-dept">Chưa được gán bộ phận</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(moTaBoPhan))
                    {
                        <div class="ttk-mo-ta"><i class="fas fa-info-circle"></i> <span>@moTaBoPhan</span></div>
                    }
                </div>
            </section>

            <!-- Bảo mật -->
            <section class="ttk-the">
                <div class="ttk-the-dau">
                    <h2><i class="fas fa-lock"></i> <span data-key="sec-security">Bảo mật</span></h2>
                </div>
                <div class="ttk-the-than">
                    <div class="ttk-bao-mat">
                        <div>
                            <div class="ttk-gia-tri" data-key="label-pass">Mật khẩu</div>
                            <p class="ttk-bao-mat-mo-ta" data-key="desc-pass">Sau khi đổi mật khẩu, mọi phiên đăng nhập sẽ bị đăng xuất và bạn cần đăng nhập lại.</p>
                        </div>
                        <button type="button" class="ttk-nut ttk-nut-chinh" id="btnMoDoiMatKhau"><i class="fas fa-key"></i> <span data-key="btn-pass">Đổi mật khẩu</span></button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Hộp thoại đổi mật khẩu -->
    <div id="passwordModal" class="ttk-hop-thoai" role="dialog" aria-modal="true" aria-labelledby="tieuDeDoiMk">
        <div class="ttk-hop-thoai-than">
            <h3 id="tieuDeDoiMk" data-key="title-pass">Thay đổi mật khẩu</h3>
            <form id="changePasswordForm" novalidate>
                <div class="ttk-loi-form" id="loiDoiMk" aria-live="polite"></div>
                <div class="ttk-o-nhap">
                    <label for="oldPassword" data-key="old-pass">Mật khẩu hiện tại</label>
                    <div class="ttk-o-nhap-boc">
                        <input type="password" id="oldPassword" name="oldPassword" autocomplete="current-password" required>
                        <button type="button" class="ttk-hien-mk" tabindex="-1" title="Hiện/ẩn"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
                <div class="ttk-o-nhap">
                    <label for="newPassword" data-key="new-pass">Mật khẩu mới</label>
                    <div class="ttk-o-nhap-boc">
                        <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required>
                        <button type="button" class="ttk-hien-mk" tabindex="-1" title="Hiện/ẩn"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
                <div class="ttk-o-nhap">
                    <label for="confirmPassword" data-key="confirm-pass">Xác nhận mật khẩu mới</label>
                    <div class="ttk-o-nhap-boc">
                        <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required>
                        <button type="button" class="ttk-hien-mk" tabindex="-1" title="Hiện/ẩn"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
                <div class="ttk-hop-thoai-nut">
                    <button type="submit" id="btnUpdatePass" class="ttk-nut ttk-nut-chinh"><span data-key="btn-save">Cập nhật</span></button>
                    <button type="button" id="btnHuyDoiMk" class="ttk-nut ttk-nut-vien"><span data-key="btn-cancel">Hủy</span></button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/thong-tin-tai-khoan.js?v=1"></script>
</body>
</html>
