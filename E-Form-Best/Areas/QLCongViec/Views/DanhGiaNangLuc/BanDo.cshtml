@{
    ViewData["Title"] = "Bản đồ năng lực";
    Layout = "~/Areas/QLCongViec/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/thong-ke-danh-gia.css?v=3" />
<link rel="stylesheet" href="~/css/nang-luc-danh-gia.css?v=4" />

<div id="bdnl" class="tkdg">
    <div class="tkdg-header">
        <div>
            <h2 class="tkdg-title">
                <span class="tkdg-title-icon"><i class="fa fa-map-o"></i></span>
                BẢN ĐỒ NĂNG LỰC
            </h2>
            <p class="tkdg-sub">GAP = điểm quản lý chấm − yêu cầu của cấp bậc, chỉ tính năng lực thuộc nhóm công việc. Không cộng vào điểm 100 của phiếu.</p>
        </div>
        <button type="button" class="tkdg-btn-reset" id="bdnlLamMoi"><i class="fa fa-refresh"></i> Làm mới</button>
    </div>

    <div class="tkdg-loi" id="bdnlLoi" hidden><i class="fa fa-exclamation-triangle"></i> <span id="bdnlLoiText"></span></div>

    <div id="bdnlKy" class="ky-dg"></div>

    <div class="tkdg-kpi-strip">
        <button type="button" class="tkdg-kpi" data-loc="" style="--kpi-c:#64748b;"><span class="tkdg-kpi-label"><i class="fa fa-users"></i> Tổng</span><span class="tkdg-kpi-value" id="bdnlTong">0</span></button>
        <button type="button" class="tkdg-kpi" data-loc="Vượt chuẩn" style="--kpi-c:#16a34a;"><span class="tkdg-kpi-label"><i class="fa fa-arrow-up"></i> Vượt chuẩn</span><span class="tkdg-kpi-value" id="bdnlVuot">0</span></button>
        <button type="button" class="tkdg-kpi" data-loc="Đạt chuẩn" style="--kpi-c:#059669;"><span class="tkdg-kpi-label"><i class="fa fa-check-circle"></i> Đạt chuẩn</span><span class="tkdg-kpi-value" id="bdnlDat">0</span></button>
        <button type="button" class="tkdg-kpi" data-loc="Cần cải thiện" style="--kpi-c:#d97706;"><span class="tkdg-kpi-label"><i class="fa fa-wrench"></i> Cần cải thiện</span><span class="tkdg-kpi-value" id="bdnlCai">0</span></button>
        <button type="button" class="tkdg-kpi" data-loc="Chưa đạt" style="--kpi-c:#dc2626;"><span class="tkdg-kpi-label"><i class="fa fa-exclamation-triangle"></i> Chưa đạt</span><span class="tkdg-kpi-value" id="bdnlChua">0</span></button>
        <button type="button" class="tkdg-kpi" data-loc="chua_cham" style="--kpi-c:#94a3b8;"><span class="tkdg-kpi-label"><i class="fa fa-circle-o"></i> Chưa chấm</span><span class="tkdg-kpi-value" id="bdnlChuaCham">0</span></button>
    </div>

    <div class="tkdg-khung">
        <div class="tkdg-khung-tieu-de tkdg-bang-dau">
            <span><i class="fa fa-th"></i> GAP theo nhóm năng lực <span class="tkdg-ghi-chu" id="bdnlMoTaLoc"></span></span>
            <span class="d-flex gap-2 flex-wrap">
                <select id="bdnlNhom" class="tkdg-input" aria-label="Nhóm công việc"><option value="">Mọi nhóm công việc</option></select>
                <input type="search" class="tkdg-input" id="bdnlTim" placeholder="Tìm tên, mã NV..." />
            </span>
        </div>
        <div class="nl-chu-giai">
            <span class="nl-o vuot">≥ 1</span> Vượt chuẩn
            <span class="nl-o dat">0 → 1</span> Đạt chuẩn
            <span class="nl-o cai">-1 → 0</span> Cần cải thiện
            <span class="nl-o chua">&lt; -1</span> Chưa đạt
        </div>
        <div class="tkdg-bang-cuon">
            <table class="tkdg-bang nl-bang">
                <thead>
                    <tr>
                        <th>Mã NV</th>
                        <th>Họ tên</th>
                        <th>Nhóm công việc</th>
                        <th class="so">Cấp bậc</th>
                        <th class="so">Kiến thức</th>
                        <th class="so">Kỹ năng</th>
                        <th class="so">Thái độ</th>
                        <th class="so">Ngoại ngữ</th>
                        <th class="so">GAP chung</th>
                        <th>Xếp loại</th>
                        <th class="so">Đã chấm</th>
                    </tr>
                </thead>
                <tbody id="bdnlBang"></tbody>
            </table>
            <div class="tkdg-bang-trong" id="bdnlTrong" hidden>Không có nhân viên phù hợp</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ky-danh-gia.js?v=1"></script>
    <script src="~/js/ban-do-nang-luc.js?v=1"></script>
}
