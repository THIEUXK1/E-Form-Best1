@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Areas/QLCongViec/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/tong-quan-ca-nhan.css?v=1" />

<div id="tqcn" class="tqcn">
    <header class="tqcn-dau">
        <div class="tqcn-logo">CV</div>
        <div>
            <h1 id="tqcnChao">FORM CÔNG VIỆC</h1>
            <p>Hệ thống giao việc & điều phối nội bộ</p>
        </div>
    </header>

    <div id="tqcnLoi" class="tqcn-loi" role="alert" hidden></div>

    <div class="tqcn-o-so">
        <a class="tqcn-o" href="#tqcnKhungViec"><span>Việc cần làm</span><b id="tqcnSoViec">…</b><small id="tqcnSoViecGhiChu"></small></a>
        <a class="tqcn-o" id="tqcnODiem" href="/QLCongViec/DanhGia/TuDanhGia" hidden><span>Điểm kỳ gần nhất</span><b id="tqcnDiem">—</b><small id="tqcnDiemGhiChu"></small></a>
        <a class="tqcn-o" id="tqcnOGap" href="/QLCongViec/DanhGia/NangLucCuaToi" hidden><span>GAP năng lực</span><b id="tqcnGap">—</b><small id="tqcnGapGhiChu"></small></a>
        <a class="tqcn-o" href="/FormCongViec/DaoTao"><span>Đào tạo sắp tới</span><b id="tqcnSoDaoTao">…</b><small id="tqcnDaoTaoGhiChu"></small></a>
        <a class="tqcn-o" id="tqcnOLoTrinh" href="/QLCongViec/DanhGia/LoTrinhCuaToi" hidden><span>Bậc hiện tại</span><b id="tqcnBac">—</b><small id="tqcnPhuTrach"></small></a>
    </div>

    <div class="tqcn-luoi">
        <section class="tqcn-khung" id="tqcnKhungViec">
            <h2>Việc cần làm</h2>
            <ul class="tqcn-ds" id="tqcnDsViec"><li class="tqcn-trong">Đang tải...</li></ul>
        </section>

        <section class="tqcn-khung" id="tqcnKhungGap" hidden>
            <h2>Năng lực <small id="tqcnGapKy"></small></h2>
            <table class="tqcn-bang"><tbody id="tqcnBangGap"></tbody></table>
            <h3 id="tqcnTieuDeYeu" hidden>Cần cải thiện nhất</h3>
            <ul class="tqcn-yeu" id="tqcnDsYeu"></ul>
        </section>

        <section class="tqcn-khung">
            <h2>Lịch đào tạo của tôi</h2>
            <ul class="tqcn-ds" id="tqcnDsDaoTao"><li class="tqcn-trong">Đang tải...</li></ul>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/tong-quan-ca-nhan.js?v=1"></script>
}
