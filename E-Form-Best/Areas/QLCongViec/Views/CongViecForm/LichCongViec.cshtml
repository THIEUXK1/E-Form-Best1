@{
    ViewData["Title"] = "Lịch Công Việc";
    Layout = "~/Areas/QLCongViec/Views/Shared/_Layout.cshtml";
}

<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css' rel='stylesheet' />
<link rel="stylesheet" href="~/css/lich-cong-viec.css?v=3" />

<div class="lcv-container">
    <div class="lcv-header">
        <h2>
            <i class="fa fa-calendar" style="color: #65a30d;"></i> LỊCH THỰC HIỆN CÔNG VIỆC
        </h2>
        <button type="button" id="btnFullscreenCalendar" class="btn-fullscreen-calendar">
            <i class="fa fa-expand" id="iconFullscreenCalendar"></i> <span id="textFullscreenCalendar">Toàn màn hình</span>
        </button>
    </div>

    <div class="lcv-body">
        <div class="calendar-wrapper" id="calendarWrapper">
            <div class="calendar-toolbar-row">
                <div class="lcv-filters" id="lcvFilters">
                    <button type="button" class="lcv-chip active" data-loc="tatca">
                        Tất cả <span class="lcv-count">0</span>
                    </button>
                    <button type="button" class="lcv-chip" data-loc="quahan">
                        <span class="lcv-dot" style="background:#dc2626"></span> Quá hạn / hôm nay <span class="lcv-count">0</span>
                    </button>
                    <button type="button" class="lcv-chip" data-loc="sapden">
                        <span class="lcv-dot" style="background:#f59e0b"></span> Sắp đến hạn (≤7 ngày) <span class="lcv-count">0</span>
                    </button>
                    <button type="button" class="lcv-chip" data-loc="condu">
                        <span class="lcv-dot" style="background:#0891b2"></span> Còn nhiều thời gian <span class="lcv-count">0</span>
                    </button>
                    <button type="button" class="lcv-chip" data-loc="hoantat">
                        <span class="lcv-dot" style="background:#16a34a"></span> Hoàn tất <span class="lcv-count">0</span>
                    </button>
                    <button type="button" class="lcv-chip" data-loc="khonghan">
                        <span class="lcv-dot" style="background:#8b5cf6"></span> Chưa đặt hạn <span class="lcv-count">0</span>
                    </button>
                    <button type="button" class="lcv-chip" data-loc="huy">
                        <span class="lcv-dot" style="background:#94a3b8"></span> Đã hủy <span class="lcv-count">0</span>
                    </button>
                </div>
            </div>
            <div id='calendar'></div>
        </div>

        <aside class="lcv-panel">
            <h3><i class="fa fa-bell" style="color:#f59e0b"></i> HẠN CHÓT GẦN NHẤT</h3>
            <div class="lcv-panel-sub">Việc chưa hoàn tất, đã quá hạn hoặc đến hạn trong 14 ngày tới</div>
            <div class="lcv-deadline-list" id="lcvDeadlineList">
                <div class="lcv-empty"><i class="fa fa-spinner fa-spin"></i> Đang tải…</div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
    <script src="~/js/lich-cong-viec.js?v=4"></script>
}
