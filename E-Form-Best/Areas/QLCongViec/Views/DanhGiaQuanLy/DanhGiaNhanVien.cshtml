@{
    ViewData["Title"] = "Đánh giá nhân viên";
    Layout = "~/Areas/QLCongViec/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/fixed-page-layout.css" />
<link rel="stylesheet" href="~/css/tu-danh-gia.css?v=7" />

<div id="dgnv" class="tdg fp-page">
    <div class="tdg-head">
        <h1 class="tdg-title"><span class="tdg-title-icon"><i class="fa fa-pencil-square-o"></i></span> Đánh giá nhân viên</h1>
        <p class="tdg-sub">Chấm theo mẫu Performance Evaluation Form 2025, so sánh với bản tự đánh giá</p>
    </div>

    <section class="tdg-card">
        <div class="tdg-chon-nv">
            <label class="tdg-field"><span>Nhân viên</span><select class="form-select" id="dgnvChon"><option value="">— Đang tải danh sách —</option></select></label>
            <a class="btn btn-outline-secondary" href="/QLCongViec/DanhGia/NhanVien"><i class="fa fa-users"></i> Danh sách nhân viên</a>
        </div>
    </section>

    <section class="tdg-card" id="dgnvCho" hidden>
        <h2 class="tdg-card-title">Cần quản lý đánh giá <span class="tdg-badge awaiting_manager" id="dgnvSoCho">0</span></h2>
        <p class="tdg-card-desc">Nhân viên quản lý chưa gửi đánh giá — “Chờ quản lý” (nhân viên đã tự đánh giá) xếp trước. Bấm một dòng để đánh giá.</p>
        <div class="tdg-cho-cuon">
            <table class="tdg-bang tdg-bang-cho">
                <thead><tr><th>Nhân viên</th><th>Phòng ban</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody id="dgnvDsCho"></tbody>
            </table>
        </div>
    </section>

    <div id="dgnvTrangThai" class="tdg-loading" hidden></div>

    <div id="dgnvNoiDung" hidden>
        <div id="dgnvCanhBao" class="tdg-alert tdg-alert-info" hidden><i class="fa fa-info-circle"></i><div id="dgnvCanhBaoChu"></div></div>

        <ol class="tdg-steps" id="dgnvSteps">
            <li data-buoc="1"><span class="tdg-step-dot"><i class="fa fa-user"></i></span><span>Thông tin</span></li>
            <li data-buoc="2"><span class="tdg-step-dot"><i class="fa fa-bar-chart"></i></span><span>Part 1 · Hiệu suất</span></li>
            <li data-buoc="3"><span class="tdg-step-dot"><i class="fa fa-check-square-o"></i></span><span>Part 2 · Năng lực</span></li>
            <li data-buoc="4"><span class="tdg-step-dot"><i class="fa fa-road"></i></span><span>Part 3 · Kế hoạch</span></li>
            <li data-buoc="5"><span class="tdg-step-dot"><i class="fa fa-flag-checkered"></i></span><span>Hoàn thành</span></li>
        </ol>

        <div class="tdg-cuon" data-fp-scroll>
        <section class="tdg-card" data-panel="1">
            <h2 class="tdg-card-title">Thông tin nhân viên</h2>
            <p class="tdg-card-desc">Xem lại thông tin trước khi đánh giá</p>
            <div class="tdg-grid2">
                <label class="tdg-field"><span>Name / Họ và tên</span><input type="text" class="form-control" id="dgnvTen" disabled /></label>
                <label class="tdg-field"><span>Employee ID / Mã nhân viên</span><input type="text" class="form-control" id="dgnvMa" disabled /></label>
                <label class="tdg-field"><span>Position / Chức vụ</span><input type="text" class="form-control" id="dgnvChucVu" disabled /></label>
                <label class="tdg-field"><span>Department / Phòng ban</span><input type="text" class="form-control" id="dgnvPhongBan" disabled /></label>
            </div>
            <div class="tdg-guide" id="dgnvTinhTrangTu"></div>
        </section>

        <section class="tdg-card" data-panel="2" hidden>
            <h2 class="tdg-card-title">Part 1 : Work Performance Measurement (50 Points)</h2>
            <p class="tdg-card-desc">Xem phần nhân viên tự khai, đặt trọng số (tổng 50) và chọn mức đánh giá của quản lý. Điểm = trọng số × mức / 5.</p>
            <div class="tdg-thang">
                <span><b>5</b> = Excellent</span><span><b>4</b> = Good</span><span><b>3</b> = As a standard</span><span><b>2</b> = Poor</span><span><b>1</b> = Very Poor</span>
            </div>
            <div id="dgnvDsKpi"></div>
            <div class="tdg-tong-phan">
                <span>Tổng trọng số: <b id="dgnvTongTrongSo">0</b> / 50</span>
                <span>Điểm Part 1 (quản lý): <b id="dgnvDiemP1">0</b> / 50</span>
            </div>
        </section>

        <section class="tdg-card" data-panel="3" hidden>
            <h2 class="tdg-card-title">Part 2 : Competency Measurement (50 Points)</h2>
            <p class="tdg-card-desc">Chấm từng tiêu chí trong khung điểm tối đa. Nhãn xanh là điểm nhân viên tự chấm. Sửa tiêu chí ở “Hồ sơ & KPI”.</p>
            <div id="dgnvDsTieuChi"></div>
            <div class="tdg-tong-phan"><span>Điểm Part 2 (quản lý): <b id="dgnvDiemP2">0</b> / <span id="dgnvToiDaP2">50</span></span></div>
        </section>

        <section class="tdg-card tdg-p3" data-panel="4" hidden>
            <h2 class="tdg-card-title">Part 3 : Career and Improvement Plan</h2>
            <p class="tdg-card-desc">Nội dung nhân viên tự ghi; quản lý nhận xét ở ô Comment.</p>
            <div class="tdg-grid2">
                <div class="tdg-field"><span>Strength — Điểm mạnh</span><div class="tdg-chi-xem" id="dgnvDiemManh"></div></div>
                <div class="tdg-field"><span>Career path (1 – 3 year) — Lộ trình</span><div class="tdg-chi-xem" id="dgnvLoTrinh"></div></div>
                <div class="tdg-field"><span>Weakness — Điểm cần cải thiện</span><div class="tdg-chi-xem" id="dgnvDiemYeu"></div></div>
                <div class="tdg-field"><span>Development plan (1 year) — Kế hoạch</span><div class="tdg-chi-xem" id="dgnvKeHoach"></div></div>
                <label class="tdg-field tdg-span2"><span>Comment — Nhận xét của quản lý</span><textarea class="form-control" id="dgnvNhanXet" maxlength="8000"></textarea></label>
            </div>
        </section>

        <section class="tdg-card" data-panel="5" hidden>
            <h2 class="tdg-card-title">Summary & hoàn thành</h2>
            <p class="tdg-card-desc">Bấm “Hoàn thành” để gửi đánh giá. Khi nhân viên cũng đã gửi tự đánh giá, phiếu được chốt và nhân viên không sửa được nữa.</p>
            <div id="dgnvDaChot" class="tdg-alert tdg-alert-ok" hidden>
                <i class="fa fa-check-circle"></i>
                <div class="flex-grow-1"><b>Phiếu đã hoàn thành.</b> Cần cho nhân viên sửa lại tự đánh giá thì mở lại phiếu.</div>
                <button type="button" class="btn btn-sm btn-outline-success" id="dgnvMoLai"><i class="fa fa-unlock"></i> Mở lại phiếu</button>
            </div>
            <table class="tdg-bang">
                <thead><tr><th></th><th>Tự đánh giá</th><th>Quản lý (tạm tính)</th></tr></thead>
                <tbody id="dgnvBangSoSanh"></tbody>
            </table>
            <div id="dgnvThieu" class="tdg-alert tdg-alert-warn mt-3" hidden><i class="fa fa-exclamation-triangle"></i><div id="dgnvThieuChu"></div></div>
            <div class="mt-3 d-flex gap-2 flex-wrap">
                <a class="btn btn-sm btn-outline-success" id="dgnvExcel" href="#"><i class="fa fa-file-excel-o"></i> Xuất Excel (mẫu 2025)</a>
            </div>
        </section>
        </div>

        <div class="tdg-nav">
            <button type="button" class="btn btn-outline-secondary" id="dgnvQuayLai"><i class="fa fa-arrow-left"></i> Quay lại</button>
            <span class="tdg-loi" id="dgnvLoi" role="alert"></span>
            <button type="button" class="btn btn-primary tdg-btn-main" id="dgnvTiepTuc">Tiếp tục <i class="fa fa-arrow-right"></i></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/danh-gia-nhan-vien.js?v=5"></script>
    <script src="~/js/fixed-page-layout.js" defer></script>
}
