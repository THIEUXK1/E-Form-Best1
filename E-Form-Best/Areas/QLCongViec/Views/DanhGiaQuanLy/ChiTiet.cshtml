@{
    ViewData["Title"] = "Chi tiết nhân viên";
    Layout = "~/Areas/QLCongViec/Views/Shared/_Layout.cshtml";
    var maNv = ViewBag.MaNv as string ?? "";
}

<link rel="stylesheet" href="~/css/tu-danh-gia.css?v=4" />

<div id="ctnv" class="tdg tdg-rong" data-ma-nv="@maNv">
    <div class="tdg-toolbar">
        <div class="d-flex align-items-center gap-3">
            <a class="btn btn-sm btn-outline-secondary" href="/QLCongViec/DanhGia/NhanVien"><i class="fa fa-arrow-left"></i> Quay lại danh sách</a>
            <h1 class="tdg-title m-0"><i class="fa fa-id-badge"></i> Chi tiết nhân viên</h1>
        </div>
    </div>

    <div id="ctnvTrangThai" class="tdg-loading"><i class="fa fa-spinner fa-spin"></i> Đang tải dữ liệu...</div>

    <div id="ctnvNoiDung" hidden>
        <div id="ctnvThieu" class="tdg-alert tdg-alert-warn" hidden>
            <i class="fa fa-exclamation-triangle"></i>
            <div class="flex-grow-1"><b>Dữ liệu còn thiếu</b><ul id="ctnvDsThieu" class="tdg-ds-thieu"></ul></div>
        </div>

        <div class="tdg-ct-hang">
            <section class="tdg-card tdg-ct-tt">
                <h2 class="tdg-card-title" id="ctnvTen"></h2>
                <p class="tdg-card-desc" id="ctnvMa"></p>
                <div class="tdg-nv-dong"><span>Cấp bậc</span><b id="ctnvCapBac"></b></div>
                <div class="tdg-nv-dong"><span>Nhóm công việc</span><b id="ctnvNhom"></b></div>
                <div class="tdg-nv-dong"><span>Trạng thái</span><span id="ctnvTrangThaiPhieu"></span></div>
                <div class="tdg-nv-dong"><span>GAP</span><span id="ctnvGap"></span></div>
                <div class="tdg-nv-dong"><span>Xếp loại</span><span id="ctnvXepLoai"></span></div>
                <div class="d-flex gap-2 flex-wrap mt-3">
                    <a class="btn btn-sm btn-primary tdg-btn-main" style="min-width:0" id="ctnvDanhGia" href="#"><i class="fa fa-pencil-square-o"></i> Đánh giá</a>
                    <a class="btn btn-sm btn-outline-success" id="ctnvExcel" href="#"><i class="fa fa-file-excel-o"></i> Excel</a>
                </div>
            </section>
            <section class="tdg-card tdg-ct-bieudo">
                <h2 class="tdg-card-title">Đồ thị phân tích năng lực</h2>
                <p class="tdg-card-desc">So sánh điểm yêu cầu, tự đánh giá và quản lý đánh giá theo năng lực</p>
                <div class="tdg-ct-canvas"><canvas id="ctnvRadar"></canvas></div>
            </section>
        </div>

        <div class="tdg-ct-hang tdg-ct-dao">
            <section class="tdg-card tdg-ct-bieudo">
                <h2 class="tdg-card-title">Phân tích KPI</h2>
                <p class="tdg-card-desc">% hoàn thành: tự đánh giá vs quản lý</p>
                <div class="tdg-ct-canvas"><canvas id="ctnvKpiChart"></canvas></div>
            </section>
            <section class="tdg-card tdg-ct-tt">
                <h2 class="tdg-card-title">Tổng hợp</h2>
                <p class="tdg-card-desc">Điểm theo từng phiếu</p>
                <table class="tdg-bang">
                    <thead><tr><th></th><th>Tự ĐG</th><th>Quản lý</th></tr></thead>
                    <tbody id="ctnvTongHop"></tbody>
                </table>
            </section>
        </div>

        <section class="tdg-card">
            <h2 class="tdg-card-title">Chi tiết KPI</h2>
            <p class="tdg-card-desc">Danh sách KPI, trọng số và % đánh giá</p>
            <div class="table-responsive">
                <table class="tdg-bang tdg-bang-kpi">
                    <thead><tr><th>Công việc</th><th>Chỉ số KPI</th><th>Kết quả</th><th>Trọng số</th><th>Tự ĐG (%)</th><th>Quản lý (%)</th><th>Ảnh</th></tr></thead>
                    <tbody id="ctnvBangKpi"></tbody>
                </table>
            </div>
        </section>

        <section class="tdg-card">
            <h2 class="tdg-card-title">Chi tiết tiêu chí</h2>
            <p class="tdg-card-desc">Các nhóm năng lực — so sánh tự đánh giá và quản lý đánh giá</p>
            <div id="ctnvNangLuc"></div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/chi-tiet-nhan-vien-danh-gia.js?v=2"></script>
}
