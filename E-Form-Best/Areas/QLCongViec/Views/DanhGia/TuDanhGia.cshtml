@{
    ViewData["Title"] = "Tự đánh giá";
    Layout = "~/Areas/QLCongViec/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/fixed-page-layout.css" />
<link rel="stylesheet" href="~/css/tu-danh-gia.css?v=7" />
<link rel="stylesheet" href="~/css/nang-luc-danh-gia.css?v=4" />

<div id="tdg" class="tdg fp-page">
    <div class="tdg-head">
        <h1 class="tdg-title"><span class="tdg-title-icon"><i class="fa fa-star-half-o"></i></span> Tự đánh giá hiệu suất</h1>
        <p class="tdg-sub">Performance Evaluation Form — Part 1 Hiệu suất (50đ) · Part 2 Năng lực (50đ) · Part 3 Kế hoạch phát triển</p>
    </div>

    <div id="tdgKy" class="ky-dg"></div>

    <div id="tdgTrangThai" class="tdg-loading"><i class="fa fa-spinner fa-spin"></i> Đang tải dữ liệu đánh giá...</div>

    <div id="tdgNoiDung" hidden>
        <div id="tdgDaKhoa" class="tdg-alert tdg-alert-info" hidden>
            <i class="fa fa-lock"></i>
            <div id="tdgDaKhoaChu">Phiếu đã được quản lý đánh giá xong — chỉ xem, không sửa được nữa.</div>
        </div>

        <ol class="tdg-steps" id="tdgSteps">
            <li data-buoc="1"><span class="tdg-step-dot"><i class="fa fa-id-card-o"></i></span><span>Thông tin</span></li>
            <li data-buoc="2"><span class="tdg-step-dot"><i class="fa fa-bar-chart"></i></span><span>Part 1 · Hiệu suất</span></li>
            <li data-buoc="3"><span class="tdg-step-dot"><i class="fa fa-check-square-o"></i></span><span>Part 2 · Năng lực</span></li>
            <li data-buoc="4"><span class="tdg-step-dot"><i class="fa fa-road"></i></span><span>Part 3 · Kế hoạch</span></li>
            <li data-buoc="5"><span class="tdg-step-dot"><i class="fa fa-flag-checkered"></i></span><span>Hoàn thành</span></li>
        </ol>

        <div class="tdg-cuon" data-fp-scroll>
        <div id="tdgKyXacNhan"></div>
        <section class="tdg-card" data-panel="1">
            <h2 class="tdg-card-title">Thông tin nhân viên</h2>
            <p class="tdg-card-desc">Xác nhận thông tin trước khi đánh giá</p>
            <div class="tdg-grid2">
                <label class="tdg-field"><span>Name / Họ và tên</span><input type="text" class="form-control" id="tdgHoTen" disabled /></label>
                <label class="tdg-field"><span>Employee ID / Mã nhân viên</span><input type="text" class="form-control" id="tdgMaNv" disabled /></label>
                <label class="tdg-field"><span>Position / Chức vụ</span><input type="text" class="form-control" id="tdgChucVu" disabled /></label>
                <label class="tdg-field"><span>Department / Phòng ban</span><input type="text" class="form-control" id="tdgPhongBan" disabled /></label>
            </div>
            <div class="tdg-guide">
                <b>Hướng dẫn đánh giá</b>
                <ul>
                    <li>Part 1: chọn mức 1–5 cho từng nhiệm vụ; điểm = trọng số × mức / 5 (trọng số do quản lý đặt, tổng 50)</li>
                    <li>Part 2: chấm từng tiêu chí năng lực trong khung điểm tối đa, ghi tóm tắt / ví dụ cụ thể</li>
                    <li>Part 3: điểm mạnh, điểm cần cải thiện, lộ trình 1–3 năm và kế hoạch phát triển 1 năm</li>
                    <li>Dữ liệu được lưu mỗi khi bấm “Tiếp tục”; bấm “Hoàn thành” để gửi cho quản lý</li>
                </ul>
            </div>
        </section>

        <section class="tdg-card" data-panel="2" hidden>
            <h2 class="tdg-card-title">Part 1 : Work Performance Measurement (50 Points) — Hiệu suất</h2>
            <p class="tdg-card-desc">Điền chỉ số hiệu suất, kết quả và chọn mức tự đánh giá. Có thể đính kèm minh chứng.</p>
            <div class="tdg-thang">
                <span><b>5</b> = Higher above the standard (Excellent)</span>
                <span><b>4</b> = Above the standard (Good)</span>
                <span><b>3</b> = As a standard / Often present</span>
                <span><b>2</b> = Below the standard (Poor)</span>
                <span><b>1</b> = (Very Poor) Very Low the circumstance</span>
            </div>
            <div id="tdgSoLieu"></div>
            <div id="tdgDsKpi"></div>
            <div class="tdg-tong-phan">
                <span>Tổng trọng số: <b id="tdgTongTrongSo">0</b> / 50</span>
                <span>Điểm Part 1 (tự đánh giá): <b id="tdgDiemP1">0</b> / 50</span>
            </div>
        </section>

        <section class="tdg-card" data-panel="3" hidden>
            <h2 class="tdg-card-title">Part 2 : Competency Measurement (50 Points) — Năng lực</h2>
            <p class="tdg-card-desc">Đánh giá năng lực theo từng tiêu chí, ghi tóm tắt hoặc ví dụ cụ thể.</p>
            <div id="tdgDsTieuChi"></div>
            <div class="tdg-tong-phan"><span>Điểm Part 2 (tự đánh giá): <b id="tdgDiemP2">0</b> / <span id="tdgToiDaP2">50</span></span></div>
        </section>

        <section class="tdg-card tdg-p3" data-panel="4" hidden>
            <h2 class="tdg-card-title">Part 3 : Career and Improvement Plan — Kế hoạch phát triển / Thăng tiến</h2>
            <p class="tdg-card-desc">Không tính điểm; quản lý xem và nhận xét. Việc cụ thể cần theo dõi tiến độ ghi ở <a href="/QLCongViec/DanhGia/KeHoachCuaToi">Kế hoạch của tôi</a>.</p>
            <div class="tdg-grid2">
                <label class="tdg-field"><span>Strength — Điểm mạnh</span><textarea class="form-control" id="tdgDiemManh" maxlength="8000"></textarea></label>
                <label class="tdg-field"><span>Career path and duration (1 – 3 year) — Lộ trình</span><textarea class="form-control" id="tdgLoTrinh" maxlength="8000"></textarea></label>
                <label class="tdg-field"><span>Weakness (Need to improve) — Điểm cần cải thiện</span><textarea class="form-control" id="tdgDiemYeu" maxlength="8000"></textarea></label>
                <label class="tdg-field"><span>Development plan (1 year) — Kế hoạch phát triển</span><textarea class="form-control" id="tdgKeHoach" maxlength="8000"></textarea></label>
            </div>
        </section>

        <section class="tdg-card" data-panel="5" hidden>
            <h2 class="tdg-card-title">Tóm tắt đánh giá</h2>
            <p class="tdg-card-desc">Xem lại trước khi bấm “Hoàn thành” để gửi cho quản lý.</p>
            <div id="tdgDaNop" class="tdg-alert tdg-alert-ok" hidden>
                <i class="fa fa-check-circle"></i><div><b>Đã gửi bản tự đánh giá</b> <span id="tdgNgayNop"></span> — có thể sửa và gửi lại cho tới khi quản lý đánh giá xong.</div>
            </div>
            <div class="tdg-stats">
                <div class="tdg-stat" style="--st-c:#2563eb; --st-bg:#eff6ff"><i class="fa fa-bar-chart"></i><span>Part I</span><b id="tdgTkP1">0</b></div>
                <div class="tdg-stat" style="--st-c:#7c3aed; --st-bg:#f5f3ff"><i class="fa fa-check-square-o"></i><span>Part II</span><b id="tdgTkP2">0</b></div>
                <div class="tdg-stat" style="--st-c:#0891b2; --st-bg:#ecfeff"><i class="fa fa-calculator"></i><span>Tổng / 100</span><b id="tdgTkTong">0</b></div>
                <div class="tdg-stat tdg-span2" style="--st-c:#059669; --st-bg:#ecfdf5"><i class="fa fa-trophy"></i><span>Xếp loại (tạm tính, chuẩn 60)</span><b id="tdgXepLoai">—</b></div>
            </div>
            <div id="tdgThieu" class="tdg-alert tdg-alert-warn mt-3" hidden><i class="fa fa-exclamation-triangle"></i><div id="tdgThieuChu"></div></div>
        </section>
        </div>

        <div class="tdg-nav">
            <button type="button" class="btn btn-outline-secondary" id="tdgQuayLai"><i class="fa fa-arrow-left"></i> Quay lại</button>
            <span class="tdg-loi" id="tdgLoi" role="alert"></span>
            <button type="button" class="btn btn-primary tdg-btn-main" id="tdgTiepTuc">Tiếp tục <i class="fa fa-arrow-right"></i></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ky-danh-gia.js?v=1"></script>
    <script src="~/js/so-lieu-kpi.js?v=1"></script>
    <script src="~/js/ky-xac-nhan.js?v=1"></script>
    <script src="~/js/tu-danh-gia.js?v=7"></script>
    <script src="~/js/fixed-page-layout.js" defer></script>
}
