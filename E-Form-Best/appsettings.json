  // Kiểm kê - dòng "Tài sản khác" (trang /QLKiemKe/ViewCheckMayHienTai) nhận diện trùng theo từng loại thiết bị.
  // Giá trị: "Serial" (trùng Serial + Loại), "Ip" (trùng IP + Loại), "KhongKiem" (luôn thêm dòng mới).
  // Trùng thì hỏi người nhập rồi mới ghi đè; thiết bị đang đứng tên đúng người đó (kiểm kê lại) thì ghi đè luôn.
  // Loại không khai ở TheoLoai dùng MacDinh. Tên loại khớp đúng KK_LoaiThietBi.ten_loai (không phân biệt hoa thường).
  "KiemKe": {
    "TrungTaiSanKhac": {
      "MacDinh": "Serial",
      "TheoLoai": {
        "Máy in": "Ip",       // serial máy in hay bị điền nhầm tên model (TTP-244 PRO...) → gộp mất máy
        "PDA": "KhongKiem"    // chốt 25/09/2026: 18 PDA cùng model từng bị gộp thành 1 dòng
      }
    }
  },
